            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": {
              "readOnlyHint": false
            }
          }
        }
      }
    },
    "/webhooks/docusign": {
      "post": {
        "operationId": "webhook_docusign",
        "summary": "DocuSign Connect webhook",
        "description": "Receives envelope-completed events from DocuSign Connect. Verifies the HMAC signature and materializes a Consent record from the envelope's prefill metadata. Not exposed to MCP.",
        "requestBody": {
