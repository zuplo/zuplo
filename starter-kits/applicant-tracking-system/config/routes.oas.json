{
  "openapi": "3.1.0",
  "info": {
    "title": "Applicant Tracking System (ATS) API",
    "version": "1.0.0",
    "description": "Open-source ATS API + MCP server. Replaces Greenhouse, Lever, Ashby. Manages jobs, candidates, applications, interviews, and scorecards, with orchestrator MCP tools for candidate summary, side-by-side comparison, and per-job pipeline health."
  },
  "paths": {
    "/jobs": {
      "get": {
        "operationId": "list_jobs",
        "summary": "List jobs in the current tenant",
        "description": "Returns a paginated list of open requisitions. Supports filtering by status (open/closed) and department.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of jobs to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor.",
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by job status.",
            "schema": { "type": "string", "enum": ["open", "closed"] }
          },
          {
            "name": "department",
            "in": "query",
            "description": "Filter to a single department.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of jobs.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JobPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-jobs)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      },
      "post": {
        "operationId": "create_job",
        "summary": "Create a job requisition",
        "description": "Open a new job requisition. Defaults to status=open.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/JobCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created job.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Job" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/create-job)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false }
          }
        }
      }
    },
    "/jobs/{id}": {
      "get": {
        "operationId": "get_job",
        "summary": "Get a job by id",
        "description": "Fetch a single job requisition.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Job id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The job.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Job" }
              }
            }
          },
          "404": { "description": "Job not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/get-job)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      }
    },
    "/candidates": {
      "get": {
        "operationId": "list_candidates",
        "summary": "List candidates in the current tenant",
        "description": "Returns a paginated list of candidates. Supports email-based lookup.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of candidates to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor.",
            "schema": { "type": "string" }
          },
          {
            "name": "email",
            "in": "query",
            "description": "Look up by exact email match.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of candidates.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CandidatePage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-candidates)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      },
      "post": {
        "operationId": "create_candidate",
        "summary": "Create a candidate",
        "description": "Add a new candidate to the tenant. Candidates can be associated with multiple applications across jobs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CandidateCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created candidate.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Candidate" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/create-candidate)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false }
          }
        }
      }
    },
    "/applications": {
      "get": {
        "operationId": "list_applications",
        "summary": "List applications in the current tenant",
        "description": "Returns a paginated list of applications. Filter by candidateId, jobId, or stage.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of applications to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor.",
            "schema": { "type": "string" }
          },
          {
            "name": "candidateId",
            "in": "query",
            "description": "Filter to applications for a single candidate.",
            "schema": { "type": "string" }
          },
          {
            "name": "jobId",
            "in": "query",
            "description": "Filter to applications for a single job.",
            "schema": { "type": "string" }
          },
          {
            "name": "stage",
            "in": "query",
            "description": "Filter by current pipeline stage.",
            "schema": {
              "type": "string",
              "enum": ["applied", "phone_screen", "onsite", "offer", "hired", "rejected"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of applications.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApplicationPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-applications)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      },
      "post": {
        "operationId": "create_application",
        "summary": "Create an application",
        "description": "Associate an existing candidate with a job. The application starts in stage=applied.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ApplicationCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created application.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Application" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/create-application)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false }
          }
        }
      }
    },
    "/applications/{id}": {
      "get": {
        "operationId": "get_application",
        "summary": "Get an application by id",
        "description": "Fetch a single application.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Application id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The application.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Application" }
              }
            }
          },
          "404": { "description": "Application not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/get-application)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      },
      "patch": {
        "operationId": "move_application_stage",
        "summary": "Advance an application to a new pipeline stage",
        "description": "Move an application to a new stage. Updates stageEnteredAt to the current time so pipeline-health analytics stay accurate.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Application id.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["stage"],
                "properties": {
                  "stage": {
                    "type": "string",
                    "enum": ["applied", "phone_screen", "onsite", "offer", "hired", "rejected"],
                    "description": "Stage to move the application into."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated application.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Application" }
              }
            }
          },
          "404": { "description": "Application not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/move-application-stage)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false, "idempotentHint": true }
          }
        }
      }
    },
    "/interviews": {
      "get": {
        "operationId": "list_interviews",
        "summary": "List interviews in the current tenant",
        "description": "Returns scheduled interviews. Filter by applicationId.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of interviews to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor.",
            "schema": { "type": "string" }
          },
          {
            "name": "applicationId",
            "in": "query",
            "description": "Filter to interviews for a single application.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of interviews.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InterviewPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-interviews)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      },
      "post": {
        "operationId": "schedule_interview",
        "summary": "Schedule an interview",
        "description": "Schedule a new interview for an application. The kind indicates the interview format.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InterviewCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The scheduled interview.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Interview" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/schedule-interview)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false }
          }
        }
      }
    },
    "/scorecards": {
      "post": {
        "operationId": "submit_scorecard",
        "summary": "Submit a scorecard for an interview",
        "description": "Record an interviewer's structured feedback after an interview. Ratings is a competency->score map (1-5 scale recommended). Recommendation summarises the overall vote.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ScorecardCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The submitted scorecard.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Scorecard" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/submit-scorecard)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false }
          }
        }
      }
    },
    "/summarize-candidate": {
      "post": {
        "operationId": "summarize_candidate",
        "summary": "Summarise a candidate's history (orchestrator)",
        "description": "Pulls a candidate plus every application they have plus every scorecard across those applications, returning a chronological timeline. Ideal for prepping interviewers or drafting hiring decisions.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["candidateId"],
                "properties": {
                  "candidateId": { "type": "string", "description": "Candidate id to summarise." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Candidate summary.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "candidate": {
                      "anyOf": [
                        { "$ref": "#/components/schemas/Candidate" },
                        { "type": "null" }
                      ],
                      "description": "Candidate record. Null if not found."
                    },
                    "applicationCount": { "type": "integer", "description": "Total applications for this candidate." },
                    "scorecardCount": { "type": "integer", "description": "Total scorecards across all their applications." },
                    "timeline": {
                      "type": "array",
                      "description": "Per-application history, ordered by createdAt ascending.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "applicationId": { "type": "string", "description": "Application id." },
                          "jobId": { "type": "string", "description": "Job they applied to." },
                          "stage": { "type": "string", "description": "Current pipeline stage." },
                          "stageEnteredAt": { "type": "string", "description": "When they entered the current stage." },
                          "createdAt": { "type": "string", "description": "When they applied." },
                          "source": { "type": "string", "description": "Sourcing channel." },
                          "score": { "type": ["number", "null"], "description": "Overall score, if any." },
                          "scorecards": {
                            "type": "array",
                            "description": "Scorecards on this application.",
                            "items": {
                              "type": "object",
                              "properties": {
                                "interviewerEmail": { "type": "string", "description": "Interviewer." },
                                "recommendation": { "type": "string", "description": "Their vote." },
                                "ratings": { "type": "object", "description": "Per-competency ratings.", "additionalProperties": { "type": "number" } },
                                "notes": { "type": "string", "description": "Free-text notes." }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/summarize-candidate)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      }
    },
    "/compare-candidates": {
      "post": {
        "operationId": "compare_candidates",
        "summary": "Compare candidates side-by-side (orchestrator)",
        "description": "Given a list of application ids, aggregates each application's scorecards and returns side-by-side averages, recommendation distributions, and current stage. Ideal for debriefs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["applicationIds"],
                "properties": {
                  "applicationIds": {
                    "type": "array",
                    "description": "Application ids to compare.",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Side-by-side comparison.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "comparisons": {
                      "type": "array",
                      "description": "One row per application.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "applicationId": { "type": "string", "description": "Application id." },
                          "candidateId": { "type": "string", "description": "Candidate id." },
                          "jobId": { "type": "string", "description": "Job id." },
                          "stage": { "type": "string", "description": "Current stage." },
                          "score": { "type": ["number", "null"], "description": "Overall score, if any." },
                          "scorecardCount": { "type": "integer", "description": "Number of scorecards collected." },
                          "recommendationCounts": {
                            "type": "object",
                            "description": "Count of each recommendation value.",
                            "additionalProperties": { "type": "integer" }
                          },
                          "avgRatingsByCompetency": {
                            "type": "object",
                            "description": "Average rating per competency across all scorecards.",
                            "additionalProperties": { "type": "number" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/compare-candidates)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      }
    },
    "/pipeline-health-for-job": {
      "post": {
        "operationId": "pipeline_health_for_job",
        "summary": "Pipeline health for a single job (orchestrator)",
        "description": "Counts applications per stage and computes the average days-in-stage for that job. Surfaces stalled pipelines (e.g. 5 candidates stuck in phone_screen for 14+ days).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["jobId"],
                "properties": {
                  "jobId": { "type": "string", "description": "Job id to analyse." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Per-stage counts and timing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jobId": { "type": "string", "description": "Job id analysed." },
                    "totalApplications": { "type": "integer", "description": "Total applications for this job." },
                    "stages": {
                      "type": "array",
                      "description": "One entry per pipeline stage.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "stage": { "type": "string", "description": "Stage name." },
                          "count": { "type": "integer", "description": "Applications currently in this stage." },
                          "avgDaysInStage": { "type": "number", "description": "Average days since entering this stage." }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/pipeline-health-for-job)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp_handler",
        "summary": "MCP server endpoint",
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "applicant-tracking-system",
              "version": "1.0.0",
              "operations": [
                { "file": "./config/routes.oas.json", "id": "list_jobs" },
                { "file": "./config/routes.oas.json", "id": "get_job" },
                { "file": "./config/routes.oas.json", "id": "create_job" },
                { "file": "./config/routes.oas.json", "id": "list_candidates" },
                { "file": "./config/routes.oas.json", "id": "create_candidate" },
                { "file": "./config/routes.oas.json", "id": "list_applications" },
                { "file": "./config/routes.oas.json", "id": "get_application" },
                { "file": "./config/routes.oas.json", "id": "create_application" },
                { "file": "./config/routes.oas.json", "id": "move_application_stage" },
                { "file": "./config/routes.oas.json", "id": "list_interviews" },
                { "file": "./config/routes.oas.json", "id": "schedule_interview" },
                { "file": "./config/routes.oas.json", "id": "submit_scorecard" },
                { "file": "./config/routes.oas.json", "id": "summarize_candidate" },
                { "file": "./config/routes.oas.json", "id": "compare_candidates" },
                { "file": "./config/routes.oas.json", "id": "pipeline_health_for_job" }
              ]
            }
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"],
            "outbound": ["prompt-injection-outbound", "secret-masking-outbound"]
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Job": {
        "type": "object",
        "description": "An open requisition candidates can apply to.",
        "required": ["id", "tenantId", "title", "department", "location", "requisitionId", "status", "description", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the job belongs to." },
          "title": { "type": "string", "description": "Job title (e.g. 'Senior Backend Engineer')." },
          "department": { "type": "string", "description": "Owning department or team." },
          "location": { "type": "string", "description": "Location or 'Remote'." },
          "requisitionId": { "type": "string", "description": "External requisition id (HRIS/financial system)." },
          "status": { "type": "string", "enum": ["open", "closed"], "description": "Whether the job is accepting applications." },
          "description": { "type": "string", "description": "Job description (markdown allowed)." },
          "createdAt": { "type": "string", "format": "date-time", "description": "ISO-8601 creation timestamp." }
        }
      },
      "JobCreate": {
        "type": "object",
        "description": "Payload to create a new job.",
        "required": ["title", "department", "location", "requisitionId", "description"],
        "properties": {
          "title": { "type": "string", "description": "Job title." },
          "department": { "type": "string", "description": "Department." },
          "location": { "type": "string", "description": "Location or Remote." },
          "requisitionId": { "type": "string", "description": "External requisition id." },
          "description": { "type": "string", "description": "Job description." },
          "status": { "type": "string", "enum": ["open", "closed"], "description": "Defaults to open." }
        }
      },
      "JobPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Page of jobs.", "items": { "$ref": "#/components/schemas/Job" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor." }
        }
      },
      "Candidate": {
        "type": "object",
        "description": "A person applying to one or more jobs.",
        "required": ["id", "tenantId", "firstName", "lastName", "email", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the candidate belongs to." },
          "firstName": { "type": "string", "description": "First name." },
          "lastName": { "type": "string", "description": "Last name." },
          "email": { "type": "string", "description": "Primary email." },
          "phone": { "type": ["string", "null"], "description": "Phone number." },
          "linkedinUrl": { "type": ["string", "null"], "description": "LinkedIn profile URL." },
          "currentTitle": { "type": ["string", "null"], "description": "Current job title." },
          "createdAt": { "type": "string", "format": "date-time", "description": "ISO-8601 creation timestamp." }
        }
      },
      "CandidateCreate": {
        "type": "object",
        "description": "Payload to create a candidate.",
        "required": ["firstName", "lastName", "email"],
        "properties": {
          "firstName": { "type": "string", "description": "First name." },
          "lastName": { "type": "string", "description": "Last name." },
          "email": { "type": "string", "description": "Primary email." },
          "phone": { "type": "string", "description": "Phone number." },
          "linkedinUrl": { "type": "string", "description": "LinkedIn profile URL." },
          "currentTitle": { "type": "string", "description": "Current job title." }
        }
      },
      "CandidatePage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Page of candidates.", "items": { "$ref": "#/components/schemas/Candidate" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor." }
        }
      },
      "Application": {
        "type": "object",
        "description": "A specific candidate applying to a specific job.",
        "required": ["id", "tenantId", "candidateId", "jobId", "stage", "stageEnteredAt", "source", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the application belongs to." },
          "candidateId": { "type": "string", "description": "Candidate applying." },
          "jobId": { "type": "string", "description": "Job they're applying to." },
          "stage": { "type": "string", "enum": ["applied", "phone_screen", "onsite", "offer", "hired", "rejected"], "description": "Pipeline stage." },
          "stageEnteredAt": { "type": "string", "format": "date-time", "description": "When they entered the current stage." },
          "source": { "type": "string", "description": "Sourcing channel (e.g. 'LinkedIn', 'Referral', 'Careers Page')." },
          "resumeUrl": { "type": ["string", "null"], "description": "Pointer to the resume (e.g. S3 URL)." },
          "score": { "type": ["number", "null"], "description": "Overall score 1-5, if used." },
          "createdAt": { "type": "string", "format": "date-time", "description": "ISO-8601 creation timestamp." }
        }
      },
      "ApplicationCreate": {
        "type": "object",
        "description": "Payload to create an application.",
        "required": ["candidateId", "jobId", "source"],
        "properties": {
          "candidateId": { "type": "string", "description": "Candidate applying." },
          "jobId": { "type": "string", "description": "Job applied to." },
          "source": { "type": "string", "description": "Sourcing channel." },
          "resumeUrl": { "type": "string", "description": "Pointer to the resume." },
          "score": { "type": "number", "description": "Initial overall score." }
        }
      },
      "ApplicationPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Page of applications.", "items": { "$ref": "#/components/schemas/Application" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor." }
        }
      },
      "Interview": {
        "type": "object",
        "description": "A scheduled interview tied to an application.",
        "required": ["id", "tenantId", "applicationId", "scheduledAt", "kind", "interviewerEmail", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the interview belongs to." },
          "applicationId": { "type": "string", "description": "Application this interview is for." },
          "scheduledAt": { "type": "string", "format": "date-time", "description": "When the interview is scheduled." },
          "kind": { "type": "string", "enum": ["phone", "onsite", "technical"], "description": "Interview format." },
          "interviewerEmail": { "type": "string", "description": "Interviewer email." },
          "createdAt": { "type": "string", "format": "date-time", "description": "ISO-8601 creation timestamp." }
        }
      },
      "InterviewCreate": {
        "type": "object",
        "description": "Payload to schedule an interview.",
        "required": ["applicationId", "scheduledAt", "kind", "interviewerEmail"],
        "properties": {
          "applicationId": { "type": "string", "description": "Application this interview is for." },
          "scheduledAt": { "type": "string", "format": "date-time", "description": "When the interview is scheduled." },
          "kind": { "type": "string", "enum": ["phone", "onsite", "technical"], "description": "Interview format." },
          "interviewerEmail": { "type": "string", "description": "Interviewer email." }
        }
      },
      "InterviewPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Page of interviews.", "items": { "$ref": "#/components/schemas/Interview" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor." }
        }
      },
      "Scorecard": {
        "type": "object",
        "description": "Structured interviewer feedback for a single interview.",
        "required": ["id", "tenantId", "interviewId", "applicationId", "interviewerEmail", "ratings", "recommendation", "notes", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the scorecard belongs to." },
          "interviewId": { "type": "string", "description": "Interview this scorecard is for." },
          "applicationId": { "type": "string", "description": "Application the interview was for." },
          "interviewerEmail": { "type": "string", "description": "Interviewer providing the feedback." },
          "ratings": { "type": "object", "description": "Map of competencyId -> score (1-5).", "additionalProperties": { "type": "number" } },
          "recommendation": { "type": "string", "enum": ["yes", "strong_yes", "no", "strong_no"], "description": "Overall vote." },
          "notes": { "type": "string", "description": "Free-text qualitative notes." },
          "createdAt": { "type": "string", "format": "date-time", "description": "ISO-8601 creation timestamp." }
        }
      },
      "ScorecardCreate": {
        "type": "object",
        "description": "Payload to submit a scorecard.",
        "required": ["interviewId", "applicationId", "interviewerEmail", "ratings", "recommendation", "notes"],
        "properties": {
          "interviewId": { "type": "string", "description": "Interview this scorecard is for." },
          "applicationId": { "type": "string", "description": "Application id." },
          "interviewerEmail": { "type": "string", "description": "Interviewer email." },
          "ratings": { "type": "object", "description": "Map of competencyId -> score (1-5).", "additionalProperties": { "type": "number" } },
          "recommendation": { "type": "string", "enum": ["yes", "strong_yes", "no", "strong_no"], "description": "Overall vote." },
          "notes": { "type": "string", "description": "Free-text qualitative notes." }
        }
      }
    }
  }
}
