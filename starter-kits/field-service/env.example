# Pick a database provider. The kit boots with `in-memory` if unset.
# Options: in-memory | supabase | firestore | clickhouse | upstash-redis | neon
DB_PROVIDER=in-memory

# === Supabase (PostgREST) ===
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJh...
# SUPABASE_TABLE=items

# === Firestore (REST) ===
# FIREBASE_PROJECT=your-gcp-project-id
# FIRESTORE_COLLECTION=items
# FIREBASE_ACCESS_TOKEN=ya29....   # OAuth2 access token; refresh upstream

# === ClickHouse (HTTP) ===
# CLICKHOUSE_URL=https://xxxxx.clickhouse.cloud
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=...
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_TABLE=items

# === Upstash Redis (REST) ===
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# UPSTASH_KEY_PREFIX=items

# === Neon (HTTP serverless) ===
# NEON_HTTP_URL=https://xxxx.neon.tech/sql
# NEON_CONNECTION_STRING=postgresql://...
# NEON_TABLE=items

# === Mapbox (route optimization) ===
# Used by `optimize_route_for_day` to geocode addresses + fetch a
# drive-time matrix. Without this, the orchestrator falls back to
# ordering by scheduled time.
# MAPBOX_ACCESS_TOKEN=pk.xxx

# === Cloudflare R2 (inspection photo storage) ===
# Used by `presign_photo_upload` to mint S3-v4 signed PUT URLs the
# tech's mobile app uploads bytes directly to.
# R2_ACCOUNT_ID=11111111111111111111111111111111
# R2_ACCESS_KEY_ID=xxxx
# R2_SECRET_ACCESS_KEY=xxxx
# R2_BUCKET=field-service-photos
# Override the public hostname when fronting R2 with a Cloudflare Worker
# or custom domain. Defaults to https://<accountid>.r2.cloudflarestorage.com/<bucket>.
# R2_PUBLIC_BASE_URL=https://photos.example.com

# === Twilio (technician + customer SMS) ===
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+15555550100
