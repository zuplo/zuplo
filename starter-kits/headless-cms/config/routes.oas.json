{
  "openapi": "3.1.0",
  "info": {
    "title": "Headless CMS API",
    "version": "1.0.0",
    "description": "API + MCP server for a headless content-management system. Replaces Contentful, Sanity, and headless WordPress. Models content types, entries, revisions, assets, and authors, and exposes orchestrator MCP tools for content-ops automations."
  },
  "paths": {
    "/content-types": {
      "get": {
        "operationId": "list_content_types",
        "summary": "List content types",
        "description": "Returns the catalog of content-type schemas defined for the current tenant.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of content types to return. Defaults to 50.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor from a previous response.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of content types.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ContentTypePage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-content-types)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "create_content_type",
        "summary": "Create a content type",
        "description": "Define a new content-type schema. The fields array describes which named fields entries of this type may store.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ContentTypeCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created content type.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ContentType" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/create-content-type)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/content-types/{id}": {
      "get": {
        "operationId": "get_content_type",
        "summary": "Get a content type by id",
        "description": "Fetch a single content-type definition by id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Content type id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The content type.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ContentType" }
              }
            }
          },
          "404": { "description": "Content type not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/get-content-type)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/entries": {
      "get": {
        "operationId": "list_entries",
        "summary": "List entries",
        "description": "Returns a paginated list of entries. Supports filtering by contentTypeSlug, status, and locale.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of entries to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor.",
            "schema": { "type": "string" }
          },
          {
            "name": "contentTypeSlug",
            "in": "query",
            "description": "Filter to a single content type.",
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter to a single status.",
            "schema": { "type": "string", "enum": ["draft", "published", "scheduled", "archived"] }
          },
          {
            "name": "locale",
            "in": "query",
            "description": "Filter to a single locale.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of entries.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EntryPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-entries)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "create_entry",
        "summary": "Create an entry",
        "description": "Create a new entry in the given content type. Defaults status to 'draft' and locale to 'en'.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EntryCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created entry.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Entry" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/create-entry)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/entries/{id}": {
      "get": {
        "operationId": "get_entry",
        "summary": "Get an entry by id",
        "description": "Fetch a single entry by id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Entry id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The entry.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Entry" }
              }
            }
          },
          "404": { "description": "Entry not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/get-entry)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "patch": {
        "operationId": "update_entry",
        "summary": "Update an entry",
        "description": "Partially update an entry. Any field omitted from the body is left unchanged.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Entry id.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EntryUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated entry.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Entry" }
              }
            }
          },
          "404": { "description": "Entry not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/update-entry)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/entries/{id}/publish": {
      "patch": {
        "operationId": "publish_entry",
        "summary": "Publish an entry",
        "description": "Mark an entry as published. Sets status to 'published' and stamps `publishedAt`. Idempotent.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Entry id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Published entry.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Entry" }
              }
            }
          },
          "404": { "description": "Entry not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/publish-entry)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/entries/{id}/unpublish": {
      "patch": {
        "operationId": "unpublish_entry",
        "summary": "Unpublish an entry",
        "description": "Move an entry back to draft. Clears `publishedAt`. Idempotent.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Entry id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Unpublished entry.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Entry" }
              }
            }
          },
          "404": { "description": "Entry not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/unpublish-entry)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/entries/{id}/archive": {
      "patch": {
        "operationId": "archive_entry",
        "summary": "Archive an entry",
        "description": "Soft-destroy an entry by setting status to 'archived'. Hidden from default lists but retained for audit.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Entry id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Archived entry.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Entry" }
              }
            }
          },
          "404": { "description": "Entry not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/archive-entry)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "destructiveHint": true } }
        }
      }
    },
    "/revisions": {
      "get": {
        "operationId": "list_revisions",
        "summary": "List revisions",
        "description": "Returns saved revision snapshots, optionally filtered to a single entry id.",
        "parameters": [
          {
            "name": "entryId",
            "in": "query",
            "description": "Restrict to revisions of a single entry.",
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of revisions to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of revisions.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RevisionPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-revisions)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/assets": {
      "get": {
        "operationId": "list_assets",
        "summary": "List uploaded assets",
        "description": "Returns the media library — assets uploaded for use inside entries.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of assets to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of assets.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AssetPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-assets)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "upload_asset",
        "summary": "Upload an asset",
        "description": "Register an asset in the media library. The bytes themselves are expected to live in object storage; this endpoint stores the metadata + URL.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AssetCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created asset.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Asset" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/upload-asset)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/find-stale-content": {
      "post": {
        "operationId": "find_stale_content",
        "summary": "Find stale published content (orchestrator)",
        "description": "Returns published entries that have not been updated in N days. Useful for content audits — feed the result list to an editor or AI to refresh.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "olderThanDays": {
                    "type": "integer",
                    "description": "Threshold in days. Defaults to 90.",
                    "minimum": 1,
                    "maximum": 3650
                  },
                  "contentTypeSlug": {
                    "type": "string",
                    "description": "Restrict the audit to a single content type."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stale content list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "olderThanDays": { "type": "integer", "description": "Echo of the threshold used." },
                    "contentTypeSlug": { "type": ["string", "null"], "description": "Echo of the content-type filter." },
                    "cutoff": { "type": "string", "format": "date-time", "description": "ISO timestamp boundary." },
                    "count": { "type": "integer", "description": "Total stale entries found." },
                    "entries": {
                      "type": "array",
                      "description": "Stale entries.",
                      "items": { "$ref": "#/components/schemas/Entry" }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/find-stale-content)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/localize-entry": {
      "post": {
        "operationId": "localize_entry",
        "summary": "Create a draft localised copy of an entry (orchestrator)",
        "description": "Reads a source entry and creates a new draft entry in the target locale, copying title, body, and field values verbatim. Translators then edit the resulting draft.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["entryId", "targetLocale"],
                "properties": {
                  "entryId": { "type": "string", "description": "Source entry to clone." },
                  "targetLocale": { "type": "string", "description": "Locale of the new draft (e.g. 'fr', 'es', 'de')." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Localisation result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sourceEntryId": { "type": "string", "description": "Id of the cloned source entry." },
                    "sourceLocale": { "type": "string", "description": "Locale of the source entry." },
                    "targetLocale": { "type": "string", "description": "Locale of the new draft." },
                    "newEntryId": { "type": "string", "description": "Id of the new draft entry." },
                    "newEntry": { "$ref": "#/components/schemas/Entry" }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/localize-entry)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/suggest-internal-links": {
      "post": {
        "operationId": "suggest_internal_links",
        "summary": "Suggest related entries to link to (orchestrator)",
        "description": "Given a source entry, scans other published entries in the same content type and returns the top candidates that share keywords. Cheap heuristic — production forks should swap the keyword overlap for a vector store.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["entryId"],
                "properties": {
                  "entryId": { "type": "string", "description": "Source entry to find related links for." },
                  "maxResults": { "type": "integer", "description": "Cap on the number of candidates returned. Defaults to 10.", "minimum": 1, "maximum": 50 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Related-entry candidates.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sourceEntryId": { "type": "string", "description": "Id of the source entry." },
                    "sourceTitle": { "type": "string", "description": "Title of the source entry." },
                    "candidateCount": { "type": "integer", "description": "Number of suggestions." },
                    "candidates": {
                      "type": "array",
                      "description": "Top related entries by keyword overlap.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "entryId": { "type": "string", "description": "Candidate entry id." },
                          "title": { "type": "string", "description": "Candidate title." },
                          "slug": { "type": "string", "description": "Candidate slug." },
                          "sharedKeywords": { "type": "array", "description": "Keywords matched.", "items": { "type": "string" } },
                          "score": { "type": "integer", "description": "Number of shared keywords." }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/suggest-internal-links)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp_handler",
        "summary": "MCP server endpoint",
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "headless-cms",
              "version": "1.0.0",
              "operations": [
                { "file": "./config/routes.oas.json", "id": "list_content_types" },
                { "file": "./config/routes.oas.json", "id": "get_content_type" },
                { "file": "./config/routes.oas.json", "id": "create_content_type" },
                { "file": "./config/routes.oas.json", "id": "list_entries" },
                { "file": "./config/routes.oas.json", "id": "get_entry" },
                { "file": "./config/routes.oas.json", "id": "create_entry" },
                { "file": "./config/routes.oas.json", "id": "update_entry" },
                { "file": "./config/routes.oas.json", "id": "publish_entry" },
                { "file": "./config/routes.oas.json", "id": "unpublish_entry" },
                { "file": "./config/routes.oas.json", "id": "archive_entry" },
                { "file": "./config/routes.oas.json", "id": "list_revisions" },
                { "file": "./config/routes.oas.json", "id": "list_assets" },
                { "file": "./config/routes.oas.json", "id": "upload_asset" },
                { "file": "./config/routes.oas.json", "id": "find_stale_content" },
                { "file": "./config/routes.oas.json", "id": "localize_entry" },
                { "file": "./config/routes.oas.json", "id": "suggest_internal_links" }
              ]
            }
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"],
            "outbound": ["prompt-injection-outbound", "secret-masking-outbound"]
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ContentType": {
        "type": "object",
        "description": "A content-type schema definition for the tenant.",
        "required": ["id", "tenantId", "slug", "name", "fields", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Owning tenant. Set automatically from the API key." },
          "slug": { "type": "string", "description": "URL-safe identifier for the content type." },
          "name": { "type": "string", "description": "Human-readable name." },
          "fields": {
            "type": "array",
            "description": "Schema fields for entries of this type.",
            "items": {
              "type": "object",
              "required": ["name", "type", "required"],
              "properties": {
                "name": { "type": "string", "description": "Field name." },
                "type": { "type": "string", "description": "Field type (e.g. 'text', 'rich_text', 'number', 'reference', 'asset', 'boolean')." },
                "required": { "type": "boolean", "description": "Whether the field is required on entries." }
              }
            }
          },
          "createdAt": { "type": "string", "format": "date-time", "description": "ISO-8601 creation timestamp." }
        }
      },
      "ContentTypeCreate": {
        "type": "object",
        "description": "Payload to create a content type.",
        "required": ["slug", "name", "fields"],
        "properties": {
          "slug": { "type": "string", "description": "URL-safe identifier." },
          "name": { "type": "string", "description": "Human-readable name." },
          "fields": {
            "type": "array",
            "description": "Schema fields.",
            "items": {
              "type": "object",
              "required": ["name", "type", "required"],
              "properties": {
                "name": { "type": "string", "description": "Field name." },
                "type": { "type": "string", "description": "Field type." },
                "required": { "type": "boolean", "description": "Whether required." }
              }
            }
          }
        }
      },
      "ContentTypePage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Page of content types.", "items": { "$ref": "#/components/schemas/ContentType" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor or null." }
        }
      },
      "Entry": {
        "type": "object",
        "description": "A single localised content entry.",
        "required": [
          "id", "tenantId", "contentTypeSlug", "slug", "locale", "status",
          "title", "body", "excerpt", "authorEmail", "fields", "createdAt", "updatedAt"
        ],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Owning tenant." },
          "contentTypeSlug": { "type": "string", "description": "Slug of the content type this entry conforms to." },
          "slug": { "type": "string", "description": "URL slug for the entry." },
          "locale": { "type": "string", "description": "BCP-47 locale code (e.g. 'en', 'fr-CA')." },
          "status": {
            "type": "string",
            "enum": ["draft", "published", "scheduled", "archived"],
            "description": "Publication state."
          },
          "title": { "type": "string", "description": "Headline title." },
          "body": { "type": "string", "description": "Main body content. Markdown or HTML at the kit's discretion." },
          "excerpt": { "type": "string", "description": "Short summary for previews." },
          "authorEmail": { "type": "string", "description": "Email of the author who owns the entry." },
          "publishedAt": { "type": ["string", "null"], "format": "date-time", "description": "When the entry went live, or null." },
          "scheduledFor": { "type": ["string", "null"], "format": "date-time", "description": "Scheduled publish time, or null." },
          "fields": { "type": "object", "description": "Custom field values defined by the content type.", "additionalProperties": true },
          "createdAt": { "type": "string", "format": "date-time", "description": "ISO-8601 creation timestamp." },
          "updatedAt": { "type": "string", "format": "date-time", "description": "ISO-8601 last-update timestamp." }
        }
      },
      "EntryCreate": {
        "type": "object",
        "description": "Payload to create an entry.",
        "required": ["contentTypeSlug", "slug", "title", "body", "authorEmail"],
        "properties": {
          "contentTypeSlug": { "type": "string", "description": "Slug of the content type." },
          "slug": { "type": "string", "description": "URL slug." },
          "locale": { "type": "string", "description": "BCP-47 locale. Defaults to 'en'." },
          "status": {
            "type": "string",
            "enum": ["draft", "published", "scheduled", "archived"],
            "description": "Initial status. Defaults to 'draft'."
          },
          "title": { "type": "string", "description": "Headline." },
          "body": { "type": "string", "description": "Main body content." },
          "excerpt": { "type": "string", "description": "Short summary." },
          "authorEmail": { "type": "string", "description": "Author email." },
          "publishedAt": { "type": ["string", "null"], "format": "date-time", "description": "Publish time, optional." },
          "scheduledFor": { "type": ["string", "null"], "format": "date-time", "description": "Scheduled publish time, optional." },
          "fields": { "type": "object", "description": "Custom field values.", "additionalProperties": true }
        }
      },
      "EntryUpdate": {
        "type": "object",
        "description": "Partial update for an entry. Any field may be omitted.",
        "properties": {
          "title": { "type": "string", "description": "New title." },
          "body": { "type": "string", "description": "New body." },
          "excerpt": { "type": "string", "description": "New excerpt." },
          "slug": { "type": "string", "description": "New slug." },
          "locale": { "type": "string", "description": "New locale." },
          "status": {
            "type": "string",
            "enum": ["draft", "published", "scheduled", "archived"],
            "description": "New status. Prefer the dedicated publish/unpublish/archive routes for state transitions."
          },
          "authorEmail": { "type": "string", "description": "New owner email." },
          "scheduledFor": { "type": ["string", "null"], "format": "date-time", "description": "New scheduled time." },
          "fields": { "type": "object", "description": "New custom field values.", "additionalProperties": true }
        }
      },
      "EntryPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Page of entries.", "items": { "$ref": "#/components/schemas/Entry" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor or null." }
        }
      },
      "Asset": {
        "type": "object",
        "description": "A media asset registered in the library.",
        "required": ["id", "tenantId", "filename", "mimeType", "sizeBytes", "url", "uploadedBy", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Owning tenant." },
          "filename": { "type": "string", "description": "Original filename." },
          "mimeType": { "type": "string", "description": "MIME type." },
          "sizeBytes": { "type": "integer", "description": "File size in bytes." },
          "url": { "type": "string", "description": "Object-storage URL." },
          "altText": { "type": "string", "description": "Accessibility alt text." },
          "uploadedBy": { "type": "string", "description": "Uploader's email." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." }
        }
      },
      "AssetCreate": {
        "type": "object",
        "description": "Payload to register an asset.",
        "required": ["filename", "mimeType", "sizeBytes", "url", "uploadedBy"],
        "properties": {
          "filename": { "type": "string", "description": "Original filename." },
          "mimeType": { "type": "string", "description": "MIME type." },
          "sizeBytes": { "type": "integer", "description": "Size in bytes." },
          "url": { "type": "string", "description": "Object-storage URL." },
          "altText": { "type": "string", "description": "Optional alt text." },
          "uploadedBy": { "type": "string", "description": "Uploader email." }
        }
      },
      "AssetPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Page of assets.", "items": { "$ref": "#/components/schemas/Asset" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor or null." }
        }
      },
      "Revision": {
        "type": "object",
        "description": "A historical snapshot of an entry's body and fields.",
        "required": ["id", "tenantId", "entryId", "body", "fields", "savedAt", "savedBy"],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Owning tenant." },
          "entryId": { "type": "string", "description": "Entry the revision belongs to." },
          "body": { "type": "string", "description": "Body content snapshot." },
          "fields": { "type": "object", "description": "Custom field values snapshot.", "additionalProperties": true },
          "savedAt": { "type": "string", "format": "date-time", "description": "When the snapshot was saved." },
          "savedBy": { "type": "string", "description": "Email of the user who saved." }
        }
      },
      "RevisionPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Page of revisions.", "items": { "$ref": "#/components/schemas/Revision" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor or null." }
        }
      }
    }
  }
}
