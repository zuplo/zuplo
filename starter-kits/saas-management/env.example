# Pick a database provider. The kit boots with `in-memory` if unset.
# Options: in-memory | supabase | firestore | clickhouse | upstash-redis | neon
DB_PROVIDER=in-memory

# === Supabase (PostgREST) ===
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJh...
# SUPABASE_TABLE=items

# === Firestore (REST) ===
# FIREBASE_PROJECT=your-gcp-project-id
# FIRESTORE_COLLECTION=items
# FIREBASE_ACCESS_TOKEN=ya29....   # OAuth2 access token; refresh upstream

# === ClickHouse (HTTP) ===
# CLICKHOUSE_URL=https://xxxxx.clickhouse.cloud
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=...
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_TABLE=items

# === Upstash Redis (REST) ===
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# UPSTASH_KEY_PREFIX=items

# === Neon (HTTP serverless) ===
# NEON_HTTP_URL=https://xxxx.neon.tech/sql
# NEON_CONNECTION_STRING=postgresql://...
# NEON_TABLE=items

# === Google Workspace (Admin SDK + Reports API) ===
# Create an OAuth client in GCP, scope to admin.directory.user.readonly +
# admin.reports.audit.readonly, and complete the consent flow at
# /oauth/google/callback to obtain a refresh token.
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# GOOGLE_REFRESH_TOKEN=1//0...   # save this from the OAuth callback
# GOOGLE_REDIRECT_URI=https://your-zuplo-host/oauth/google/callback

# === Microsoft 365 / Entra ID (Microsoft Graph) ===
# Register an app in Entra, grant Directory.Read.All + Application.Read.All
# (application permissions, admin consent), then use client-credentials.
# MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
# MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MICROSOFT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MICROSOFT_REDIRECT_URI=https://your-zuplo-host/oauth/microsoft/callback

# === Okta ===
# Create an API token in the Okta admin console (Read-Only Admin role).
# OKTA_ORG_URL=https://example.okta.com
# OKTA_API_TOKEN=00xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
