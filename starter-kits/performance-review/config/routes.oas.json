        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "performance-review-server",
              "version": "1.0.0",
              "operations": [
                {
                  "file": "./config/routes.oas.json",
                  "id": "create_cycle"
                },
                {
                  "file": "./config/routes.oas.json",
                  "id": "create_goal"
                },
                {
                  "file": "./config/routes.oas.json",
                  "id": "create_review"
                },
                {
                  "file": "./config/routes.oas.json",
                  "id": "get_review"
                },
