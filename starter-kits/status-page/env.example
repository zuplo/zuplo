# Pick a database provider. The kit boots with `in-memory` if unset.
# Options: in-memory | supabase | firestore | clickhouse | upstash-redis | neon
DB_PROVIDER=in-memory

# === Supabase (PostgREST) ===
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJh...
# SUPABASE_TABLE=items

# === Firestore (REST) ===
# FIREBASE_PROJECT=your-gcp-project-id
# FIRESTORE_COLLECTION=items
# FIREBASE_ACCESS_TOKEN=ya29....   # OAuth2 access token; refresh upstream

# === ClickHouse (HTTP) ===
# CLICKHOUSE_URL=https://xxxxx.clickhouse.cloud
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=...
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_TABLE=items

# === Upstash Redis (REST) ===
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# UPSTASH_KEY_PREFIX=items

# === Neon (HTTP serverless) ===
# NEON_HTTP_URL=https://xxxx.neon.tech/sql
# NEON_CONNECTION_STRING=postgresql://...
# NEON_TABLE=items

# === Datadog (inbound monitor webhook) ===
# Configure a Webhooks integration in Datadog pointing at /webhooks/datadog
# and set a custom header `x-datadog-signature: <hmac sha256 of body>` using
# this secret.
# DATADOG_WEBHOOK_SECRET=replace-with-strong-secret

# === Twilio (SMS fanout) ===
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+15551234567

# === Resend (email fanout) ===
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=status@example.com

# === Slack (optional global default channel) ===
# Per-subscriber Slack delivery uses the webhookUrl on the Subscriber row;
# these env vars are only used when no per-subscriber URL is set.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_DEFAULT_CHANNEL=#status
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
