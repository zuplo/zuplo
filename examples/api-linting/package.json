{
  "name": "api-linting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "zuplo dev",
    "test": "zuplo test",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "docs": "zuplo docs",
    "lint": "vacuum lint -f ./lint-functions -r config/api-ruleset.yaml -s -d config/routes.oas.json"
  },
  "dependencies": {
    "zuplo": "^7"
  },
  "devDependencies": {
    "@quobix/vacuum": "^0.5.9",
    "@types/node": "^24",
    "typescript": "^5"
  },
  "workspaces": ["docs"]
}
