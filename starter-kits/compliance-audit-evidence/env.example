# Pick a database provider. The kit boots with `in-memory` if unset.
# Options: in-memory | supabase | firestore | clickhouse | upstash-redis | neon
DB_PROVIDER=in-memory

# === Supabase (PostgREST) ===
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJh...
# SUPABASE_TABLE=items

# === Firestore (REST) ===
# FIREBASE_PROJECT=your-gcp-project-id
# FIRESTORE_COLLECTION=items
# FIREBASE_ACCESS_TOKEN=ya29....   # OAuth2 access token; refresh upstream

# === ClickHouse (HTTP) ===
# CLICKHOUSE_URL=https://xxxxx.clickhouse.cloud
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=...
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_TABLE=items

# === Upstash Redis (REST) ===
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# UPSTASH_KEY_PREFIX=items

# === Neon (HTTP serverless) ===
# NEON_HTTP_URL=https://xxxx.neon.tech/sql
# NEON_CONNECTION_STRING=postgresql://...
# NEON_TABLE=items

# === Cloudflare R2 (evidence file storage, S3-compatible) ===
# Create an R2 bucket + API token with Object Read+Write.
# R2_ACCOUNT_ID=00000000000000000000000000000000
# R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxx
# R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_BUCKET=evidence
# Optional: public-read base URL for the bucket (e.g. https://pub-xxx.r2.dev).
# When unset, putEvidence() returns the signed S3 endpoint URL.
# R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxx.r2.dev

# === Datadog (inbound monitor webhooks + outbound events) ===
# Configure a Webhooks integration on the Datadog side to POST here.
# Set the same value as a custom header `x-datadog-signature` (HMAC SHA256
# of the body using DATADOG_WEBHOOK_SECRET).
# DATADOG_WEBHOOK_SECRET=replace-with-strong-secret
# Outbound: API + APP key for posting events (Evidence collected → DD event).
# DATADOG_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DATADOG_APP_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Datadog site (datadoghq.eu, us3.datadoghq.com, etc.).
# DATADOG_SITE=datadoghq.com
