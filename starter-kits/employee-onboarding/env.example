# Pick a database provider. The kit boots with `in-memory` if unset.
# Options: in-memory | supabase | firestore | clickhouse | upstash-redis | neon
DB_PROVIDER=in-memory

# === Supabase (PostgREST) ===
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJh...
# SUPABASE_TABLE=items

# === Firestore (REST) ===
# FIREBASE_PROJECT=your-gcp-project-id
# FIRESTORE_COLLECTION=items
# FIREBASE_ACCESS_TOKEN=ya29....   # OAuth2 access token; refresh upstream

# === ClickHouse (HTTP) ===
# CLICKHOUSE_URL=https://xxxxx.clickhouse.cloud
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=...
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_TABLE=items

# === Upstash Redis (REST) ===
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# UPSTASH_KEY_PREFIX=items

# === Neon (HTTP serverless) ===
# NEON_HTTP_URL=https://xxxx.neon.tech/sql
# NEON_CONNECTION_STRING=postgresql://...
# NEON_TABLE=items

# === Slack (buddy DMs + welcome messages) ===
# Bot token required for DMs (webhooks can't DM individual users).
# Required scopes: chat:write, im:write, users:read.email.
# SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx
# SLACK_DEFAULT_CHANNEL=#welcome                    # optional, used by general broadcasts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxxxxxx   # webhook fallback (no DM support)

# === Resend (welcome / paperwork emails) ===
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=people-ops@example.com

# === Anthropic Claude (30/60/90 plan generation) ===
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-7-20251022        # optional; defaults to this
# AI_GATEWAY_URL=https://your-gateway.zuplo.app     # optional; route through Zuplo AI Gateway for caching + budgets
