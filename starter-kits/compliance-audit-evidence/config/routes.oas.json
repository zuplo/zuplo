{
  "openapi": "3.1.0",
  "info": {
    "title": "Compliance & Audit Evidence API",
    "version": "1.0.0",
    "description": "Headless compliance & audit evidence API — register controls, collect evidence, run audit cycles, and track findings to closure. Replaces Vanta, Drata, Secureframe. Ships with orchestrator MCP tools that flag stale evidence, map evidence to controls, and draft audit responses."
  },
  "paths": {
    "/controls": {
      "get": {
        "operationId": "list_controls",
        "summary": "List compliance controls",
        "description": "Returns a paginated list of controls (e.g. SOC 2 CC6.1, ISO 27001 A.5.1) ordered by slug.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Max controls to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of controls.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ControlPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-controls)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "create_control",
        "summary": "Create a compliance control",
        "description": "Register a new control in the catalog. Set `evidenceFrequencyDays` to define how often supporting evidence must be refreshed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ControlCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created control.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Control" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/create-control)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/controls/{id}": {
      "get": {
        "operationId": "get_control",
        "summary": "Get a control by id",
        "description": "Fetch a single control from the current tenant by id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Control id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The control.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Control" }
              }
            }
          },
          "404": { "description": "Control not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/get-control)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/evidence": {
      "get": {
        "operationId": "list_evidence",
        "summary": "List evidence",
        "description": "Returns a paginated list of evidence rows ordered most recent first.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Max rows to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of evidence.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EvidencePage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-evidence)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "submit_evidence",
        "summary": "Submit a piece of evidence",
        "description": "Attach a piece of evidence (screenshot, config dump, log, policy doc, attestation) to a control. Stamped `current` until it goes stale.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EvidenceCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The submitted evidence.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Evidence" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/submit-evidence)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/evidence/{id}/stale": {
      "patch": {
        "operationId": "mark_evidence_stale",
        "summary": "Mark evidence as stale",
        "description": "Flip an evidence row's status to `stale` (e.g. when a periodicity check decides the artifact is past its expected refresh date).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Evidence id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The updated evidence row.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Evidence" }
              }
            }
          },
          "404": { "description": "Evidence not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/mark-evidence-stale)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/audit-cycles": {
      "get": {
        "operationId": "list_audit_cycles",
        "summary": "List audit cycles",
        "description": "Returns a paginated list of audit cycles ordered by start date, most recent first.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Max cycles to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of audit cycles.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuditCyclePage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-audit-cycles)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "create_audit_cycle",
        "summary": "Create an audit cycle",
        "description": "Open a new audit cycle (engagement) for a framework. Defaults `status` to `planning`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuditCycleCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created audit cycle.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuditCycle" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/create-audit-cycle)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/findings": {
      "get": {
        "operationId": "list_findings",
        "summary": "List findings",
        "description": "Returns a paginated list of findings raised across audit cycles.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Max findings to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of findings.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FindingPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-findings)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "file_finding",
        "summary": "File a new finding",
        "description": "Raise a new finding against a control inside an audit cycle. Defaults `status` to `open`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FindingCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The filed finding.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Finding" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/file-finding)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/findings/{id}/resolve": {
      "patch": {
        "operationId": "resolve_finding",
        "summary": "Resolve a finding",
        "description": "Move a finding to `resolved`, `accepted_risk`, or back to `remediating`/`open`. Stamps `closedAt` when terminal.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Finding id.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FindingResolve" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated finding.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Finding" }
              }
            }
          },
          "404": { "description": "Finding not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/resolve-finding)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/policies": {
      "get": {
        "operationId": "list_policies",
        "summary": "List policy documents",
        "description": "Returns a paginated list of policy documents tracked by the program.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Max policies to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of policies.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PolicyPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-policies)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "create_policy",
        "summary": "Create a policy document",
        "description": "Register a new policy document (acceptable use, access control, etc.).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PolicyCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created policy.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Policy" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/create-policy)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/flag-stale-evidence": {
      "post": {
        "operationId": "flag_stale_evidence",
        "summary": "Flag stale evidence (orchestrator)",
        "description": "Orchestrator MCP tool. Walks every evidence row, joins it to its control, and flips `current` evidence to `stale` if it is past `evidenceFrequencyDays` since `collectedAt`. Returns the flagged set.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "framework": { "type": "string", "enum": ["soc2", "iso27001", "hipaa", "gdpr"], "description": "Restrict to one framework. Optional." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Flagged evidence list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "framework": { "type": ["string", "null"], "description": "Framework filter (echoed back)." },
                    "count": { "type": "integer", "description": "Number of evidence rows flagged stale on this run." },
                    "flagged": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "evidence": { "$ref": "#/components/schemas/Evidence" },
                          "control": { "$ref": "#/components/schemas/Control" },
                          "daysOverdue": { "type": "integer", "description": "Days past the expected refresh date." }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/flag-stale-evidence)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/map-evidence-to-control": {
      "post": {
        "operationId": "map_evidence_to_control",
        "summary": "Map evidence to a control with currentness flag (orchestrator)",
        "description": "Orchestrator MCP tool. Lists every Evidence row tied to a control with a `currentness` flag (current/stale) computed from the control's `evidenceFrequencyDays`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["controlId"],
                "properties": {
                  "controlId": { "type": "string", "description": "Control id to map." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evidence mapping with currentness flags.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "control": { "$ref": "#/components/schemas/Control" },
                    "count": { "type": "integer", "description": "Total evidence rows tied to the control." },
                    "currentCount": { "type": "integer", "description": "Number currently fresh." },
                    "staleCount": { "type": "integer", "description": "Number past their refresh date." },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "evidence": { "$ref": "#/components/schemas/Evidence" },
                          "currentness": { "type": "string", "enum": ["current", "stale"], "description": "Computed freshness." },
                          "daysUntilExpiry": { "type": "integer", "description": "Days until refresh required (negative if overdue)." }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/map-evidence-to-control)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/draft-audit-response": {
      "post": {
        "operationId": "draft_audit_response",
        "summary": "Draft a response to an audit finding (orchestrator)",
        "description": "Orchestrator MCP tool. Reads the finding, hydrates the linked control + evidence, and returns a structured draft response the LLM can rewrite for tone.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["findingId"],
                "properties": {
                  "findingId": { "type": "string", "description": "Finding id to respond to." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft response payload.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "finding": { "$ref": "#/components/schemas/Finding" },
                    "control": { "$ref": "#/components/schemas/Control" },
                    "linkedEvidence": {
                      "type": "array",
                      "description": "All evidence currently linked to the finding's control.",
                      "items": { "$ref": "#/components/schemas/Evidence" }
                    },
                    "draftResponse": { "type": "string", "description": "Plain-text draft response the LLM can rewrite." }
                  }
                }
              }
            }
          },
          "404": { "description": "Finding not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/draft-audit-response)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp_handler",
        "summary": "MCP server endpoint",
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "compliance-audit-evidence-server",
              "version": "1.0.0",
              "operations": [
                { "file": "./config/routes.oas.json", "id": "list_controls" },
                { "file": "./config/routes.oas.json", "id": "get_control" },
                { "file": "./config/routes.oas.json", "id": "create_control" },
                { "file": "./config/routes.oas.json", "id": "list_evidence" },
                { "file": "./config/routes.oas.json", "id": "submit_evidence" },
                { "file": "./config/routes.oas.json", "id": "mark_evidence_stale" },
                { "file": "./config/routes.oas.json", "id": "list_audit_cycles" },
                { "file": "./config/routes.oas.json", "id": "create_audit_cycle" },
                { "file": "./config/routes.oas.json", "id": "list_findings" },
                { "file": "./config/routes.oas.json", "id": "file_finding" },
                { "file": "./config/routes.oas.json", "id": "resolve_finding" },
                { "file": "./config/routes.oas.json", "id": "list_policies" },
                { "file": "./config/routes.oas.json", "id": "create_policy" },
                { "file": "./config/routes.oas.json", "id": "flag_stale_evidence" },
                { "file": "./config/routes.oas.json", "id": "map_evidence_to_control" },
                { "file": "./config/routes.oas.json", "id": "draft_audit_response" }
              ]
            }
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"],
            "outbound": ["prompt-injection-outbound", "secret-masking-outbound"]
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Control": {
        "type": "object",
        "description": "A control — a requirement from a compliance framework.",
        "required": ["id", "tenantId", "slug", "framework", "domain", "title", "description", "evidenceFrequencyDays", "owner", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique control id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the control belongs to." },
          "slug": { "type": "string", "description": "Stable human-readable slug (e.g. cc6-1)." },
          "framework": { "type": "string", "enum": ["soc2", "iso27001", "hipaa", "gdpr"], "description": "Framework the control belongs to." },
          "domain": { "type": "string", "enum": ["access", "change", "ops", "data"], "description": "Control domain." },
          "title": { "type": "string", "description": "Short title." },
          "description": { "type": "string", "description": "Full description / control narrative." },
          "evidenceFrequencyDays": { "type": "integer", "description": "How often supporting evidence must be refreshed." },
          "owner": { "type": "string", "description": "Email of the owner accountable for the control." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Record creation time." }
        }
      },
      "ControlCreate": {
        "type": "object",
        "description": "Payload to register a control.",
        "required": ["slug", "framework", "domain", "title", "description", "evidenceFrequencyDays", "owner"],
        "properties": {
          "slug": { "type": "string", "description": "Stable slug for the control." },
          "framework": { "type": "string", "enum": ["soc2", "iso27001", "hipaa", "gdpr"], "description": "Framework slug." },
          "domain": { "type": "string", "enum": ["access", "change", "ops", "data"], "description": "Control domain." },
          "title": { "type": "string", "description": "Short title." },
          "description": { "type": "string", "description": "Full description." },
          "evidenceFrequencyDays": { "type": "integer", "description": "Refresh frequency in days." },
