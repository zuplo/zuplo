          "submittedAt": { "type": ["string", "null"], "format": "date-time", "description": "When the timesheet was submitted." },
          "approvedAt": { "type": ["string", "null"], "format": "date-time", "description": "When the timesheet was approved." },
          "createdAt": { "type": "string", "format": "date-time", "description": "ISO-8601 creation timestamp." }
        }
      },
      "TimesheetPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "description": "Page of timesheets.",
