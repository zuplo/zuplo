{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zuplo Starter Kits Index",
  "description": "Catalog of forkable Zuplo starter kits. Used by the docs gallery and search/SEO surfaces.",
  "type": "object",
  "required": [
    "domains",
    "starterKits"
  ],
  "properties": {
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "title"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "starterKits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StarterKit"
      }
    }
  },
  "$defs": {
    "StarterKit": {
      "type": "object",
      "required": [
        "title",
        "slug",
        "description",
        "domain",
        "tier",
        "replaces",
        "seoQuery",
        "adapters",
        "mcpTools",
        "integrations"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "Display title, e.g. 'Invoicing API'."
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Directory name under starter-kits/. Also used in URLs."
        },
        "description": {
          "type": "string",
          "description": "One-sentence description."
        },
        "domain": {
          "type": "string",
          "enum": [
            "hr",
            "finance",
            "sales",
            "customer-success",
            "marketing",
            "operations",
            "productivity",
            "vertical"
          ]
        },
        "tier": {
          "type": "string",
          "enum": [
            "S",
            "M",
            "L"
          ],
          "description": "S = single-resource CRUD; M = multi-entity workflow; L = complex domain."
        },
        "replaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "SaaS products this kit can replace, e.g. ['QuickBooks', 'FreshBooks']."
        },
        "seoQuery": {
          "type": "string",
          "description": "Primary SEO target, e.g. 'api for invoicing'."
        },
        "adapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "in-memory",
              "supabase",
              "firestore",
              "clickhouse",
              "upstash-redis",
              "neon"
            ]
          },
          "description": "Database adapters the kit supports."
        },
        "mcpTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names of MCP tools (operationIds) the kit registers in /mcp."
        },
        "mcpPrompts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names of MCP prompts the kit ships, if any."
        },
        "mcpResources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names of MCP resources the kit ships, if any."
        },
        "iconUrl": {
          "type": "string",
          "format": "uri"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "Date the kit was added (YYYY-MM-DD)."
        },
        "integrations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "External services this kit integrates with (e.g. ['stripe', 'resend', 'claude']). Display-name + logo come from the gallery's integration registry."
        }
      }
    }
  }
}
