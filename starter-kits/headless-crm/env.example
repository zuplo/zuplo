# Pick a database provider. The kit boots with `in-memory` if unset.
# Options: in-memory | supabase | firestore | clickhouse | upstash-redis | neon
DB_PROVIDER=in-memory

# === Supabase (PostgREST) ===
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJh...
# SUPABASE_TABLE=items

# === Firestore (REST) ===
# FIREBASE_PROJECT=your-gcp-project-id
# FIRESTORE_COLLECTION=items
# FIREBASE_ACCESS_TOKEN=ya29....   # OAuth2 access token; refresh upstream

# === ClickHouse (HTTP) ===
# CLICKHOUSE_URL=https://xxxxx.clickhouse.cloud
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=...
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_TABLE=items

# === Upstash Redis (REST) ===
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# UPSTASH_KEY_PREFIX=items

# === Neon (HTTP serverless) ===
# NEON_HTTP_URL=https://xxxx.neon.tech/sql
# NEON_CONNECTION_STRING=postgresql://...
# NEON_TABLE=items

# === Resend (transactional email) ===
# Used by log_activity (when sendEmail: true) and any orchestrator that
# fires off a follow-up email.
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=crm@yourdomain.com

# === Google Calendar ===
# Used by account_timeline to fold real meetings into the activity stream.
# GOOGLE_CALENDAR_ACCESS_TOKEN is an OAuth2 access token with the
# https://www.googleapis.com/auth/calendar.readonly scope. Refresh upstream.
# GOOGLE_CALENDAR_ACCESS_TOKEN=ya29....
# GOOGLE_CALENDAR_ID=primary

# === Claude (Anthropic) ===
# Powers the account_timeline summary — pre-call briefs in plain English.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-7-20251022
# Optional: route through Zuplo's AI Gateway instead of api.anthropic.com.
# AI_GATEWAY_URL=https://your-gateway.zuplo.app
