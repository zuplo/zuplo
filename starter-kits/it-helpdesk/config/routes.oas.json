          "category": {
            "type": "string",
            "enum": ["hardware", "software", "access", "network", "other"],
            "description": "Optional category. Defaults to 'other'."
          }
        }
      },
      "KBArticlePage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/KBArticle" } },
          "nextCursor": { "type": "string", "nullable": true, "description": "Pagination cursor." }
        }
      }
    }
  }
