{
  "openapi": "3.1.0",
  "info": {
    "title": "Customer Support Ticketing API",
    "version": "1.0.0",
    "description": "Headless customer support ticketing API. Replaces Zendesk, Intercom, Freshdesk. Models tickets, conversations, macros, SLAs, and customers, with orchestrator MCP tools that triage incoming tickets, prepare escalation summaries, and surface recurring issues."
  },
  "paths": {
    "/tickets": {
      "get": {
        "operationId": "list_tickets",
        "summary": "List tickets in the current tenant",
        "description": "Returns a paginated list of tickets ordered by `openedAt` descending. Use `cursor` to fetch subsequent pages.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of tickets to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor from a previous response.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of tickets.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TicketPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-tickets)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "create_ticket",
        "summary": "Create a ticket",
        "description": "Open a new ticket. Defaults: status=`new`, priority=`normal`, channel=`api`. Use `triage_incoming_ticket` afterward to suggest priority, tags, and assignee.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TicketCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created ticket.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Ticket" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/create-ticket)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/tickets/{id}": {
      "get": {
        "operationId": "get_ticket",
        "summary": "Get a ticket by id",
        "description": "Fetch a single ticket from the current tenant.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Ticket id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The ticket.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Ticket" }
              }
            }
          },
          "404": { "description": "Ticket not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/get-ticket)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "patch": {
        "operationId": "update_ticket",
        "summary": "Update a ticket",
        "description": "Patch any subset of writable ticket fields. Useful after triage when you want to apply a recommended priority or tag set without changing assignment or status.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Ticket id.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TicketUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated ticket.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Ticket" }
              }
            }
          },
          "404": { "description": "Ticket not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/update-ticket)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/tickets/{id}/assign": {
      "patch": {
        "operationId": "assign_ticket",
        "summary": "Assign an agent to a ticket",
        "description": "Set `assigneeEmail` and move the ticket to `open`. Idempotent — calling twice with the same email is a no-op.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Ticket id.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["assigneeEmail"],
                "properties": {
                  "assigneeEmail": { "type": "string", "format": "email", "description": "Email of the agent to assign." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated ticket.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Ticket" }
              }
            }
          },
          "404": { "description": "Ticket not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/assign-ticket)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/tickets/{id}/reply": {
      "post": {
        "operationId": "reply_to_ticket",
        "summary": "Reply to a ticket",
        "description": "Append a public or internal conversation entry on a ticket. Public replies move the ticket to `pending` (waiting on the customer). Internal replies leave status alone.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Ticket id.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ConversationCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created conversation entry.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Conversation" }
              }
            }
          },
          "404": { "description": "Ticket not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/reply-to-ticket)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/tickets/{id}/close": {
      "patch": {
        "operationId": "close_ticket",
        "summary": "Close a ticket",
        "description": "Mark the ticket `closed` and stamp `resolvedAt`. Closed tickets do not appear in active queues but remain queryable.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Ticket id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The closed ticket.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Ticket" }
              }
            }
          },
          "404": { "description": "Ticket not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/close-ticket)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "destructiveHint": true } }
        }
      }
    },
    "/tickets/{id}/reopen": {
      "patch": {
        "operationId": "reopen_ticket",
        "summary": "Reopen a closed ticket",
        "description": "Move the ticket back to `open` and clear `resolvedAt`. Use when a customer replies after closure.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Ticket id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The reopened ticket.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Ticket" }
              }
            }
          },
          "404": { "description": "Ticket not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/reopen-ticket)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/macros": {
      "get": {
        "operationId": "list_macros",
        "summary": "List macros",
        "description": "Returns a paginated list of canned replies (macros) you can apply to tickets via `apply_macro`.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Max macros to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of macros.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MacroPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-macros)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "create_macro",
        "summary": "Create a macro",
        "description": "Create a reusable canned reply. Tag macros for easier discovery via `list_macros` filtering.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MacroCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created macro.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Macro" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/create-macro)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/apply-macro": {
      "post": {
        "operationId": "apply_macro",
        "summary": "Apply a macro to a ticket",
        "description": "Looks up a macro and creates a public conversation entry on the target ticket using the macro body. Useful for boilerplate replies.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ticketId", "macroId"],
                "properties": {
                  "ticketId": { "type": "string", "description": "Id of the ticket to reply on." },
                  "macroId": { "type": "string", "description": "Id of the macro to apply." },
                  "authorEmail": { "type": "string", "format": "email", "description": "Email to record as the conversation author. Defaults to the ticket's assignee, then to support@example.com." }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The applied macro and the created conversation.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "macro": { "$ref": "#/components/schemas/Macro" },
                    "conversation": { "$ref": "#/components/schemas/Conversation" }
                  }
                }
              }
            }
          },
          "404": { "description": "Macro or ticket not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/apply-macro)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/triage-incoming-ticket": {
      "post": {
        "operationId": "triage_incoming_ticket",
        "summary": "Triage an incoming ticket (orchestrator)",
        "description": "Reads a ticket, scores its subject + body against keyword dictionaries, and returns a recommended priority, tag set, and likely assignee based on who has handled similar tagged tickets recently.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ticketId"],
                "properties": {
                  "ticketId": { "type": "string", "description": "Id of the ticket to triage." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Triage recommendations.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ticketId": { "type": "string", "description": "The ticket that was triaged." },
                    "suggestedPriority": { "type": "string", "description": "Recommended priority." },
                    "suggestedTags": { "type": "array", "items": { "type": "string" }, "description": "Recommended tag set." },
                    "suggestedAssignee": { "type": ["string", "null"], "description": "Email of the agent most often handling tickets with these tags. Null when no signal." },
                    "similarTickets": { "type": "array", "items": { "$ref": "#/components/schemas/Ticket" }, "description": "Up to five recent tickets sharing any suggested tag." }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/triage-incoming-ticket)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/escalate-with-summary": {
      "post": {
        "operationId": "escalate_with_summary",
        "summary": "Build an escalation summary (orchestrator)",
        "description": "Pulls the ticket, every conversation on it, and the matching customer record (by email), and returns a single chronological summary string suitable for handoff. The agent decides what to do with the summary.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ticketId"],
                "properties": {
                  "ticketId": { "type": "string", "description": "Id of the ticket to summarise." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Escalation summary payload.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ticketId": { "type": "string", "description": "The ticket that was summarised." },
                    "ticket": { "$ref": "#/components/schemas/Ticket" },
                    "customer": {
                      "oneOf": [
                        { "$ref": "#/components/schemas/Customer" },
                        { "type": "null" }
                      ],
                      "description": "Matching customer record by email, or null when none."
                    },
                    "conversationCount": { "type": "integer", "description": "Number of conversation entries included." },
                    "summaryText": { "type": "string", "description": "A markdown-ish summary the agent can paste into chat or hand off." }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/escalate-with-summary)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/summarize-recurring-issues": {
      "post": {
        "operationId": "summarize_recurring_issues",
        "summary": "Summarise recurring issues by tag (orchestrator)",
        "description": "Lists tickets opened within `daysBack` days, clusters them by tag, and returns the most common tags with sample subject lines. Useful as a weekly product feedback loop.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "daysBack": { "type": "integer", "description": "Window of recent tickets to consider, in days. Defaults to 30.", "minimum": 1, "maximum": 365 },
                  "topN": { "type": "integer", "description": "Return only the top N tags. Defaults to 5.", "minimum": 1, "maximum": 20 },
                  "samplePerTag": { "type": "integer", "description": "How many sample tickets to include per tag. Defaults to 3.", "minimum": 1, "maximum": 10 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Top recurring issues.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "daysBack": { "type": "integer", "description": "Window of tickets considered, in days." },
                    "windowStart": { "type": "string", "format": "date-time", "description": "ISO timestamp at the start of the window." },
                    "ticketsConsidered": { "type": "integer", "description": "Number of tickets in the window." },
                    "topIssues": {
                      "type": "array",
                      "description": "Top recurring tag groups ordered by count desc.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "tag": { "type": "string", "description": "Tag (or 'untagged')." },
                          "count": { "type": "integer", "description": "How many tickets carry this tag." },
                          "samples": {
                            "type": "array",
                            "description": "Sample tickets carrying this tag.",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": { "type": "string", "description": "Ticket id." },
                                "subject": { "type": "string", "description": "Ticket subject." }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/summarize-recurring-issues)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp_handler",
        "summary": "MCP server endpoint",
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "support-ticketing-server",
              "version": "1.0.0",
              "operations": [
                { "file": "./config/routes.oas.json", "id": "list_tickets" },
                { "file": "./config/routes.oas.json", "id": "get_ticket" },
                { "file": "./config/routes.oas.json", "id": "create_ticket" },
                { "file": "./config/routes.oas.json", "id": "update_ticket" },
                { "file": "./config/routes.oas.json", "id": "assign_ticket" },
                { "file": "./config/routes.oas.json", "id": "reply_to_ticket" },
                { "file": "./config/routes.oas.json", "id": "close_ticket" },
                { "file": "./config/routes.oas.json", "id": "reopen_ticket" },
                { "file": "./config/routes.oas.json", "id": "list_macros" },
                { "file": "./config/routes.oas.json", "id": "create_macro" },
                { "file": "./config/routes.oas.json", "id": "apply_macro" },
                { "file": "./config/routes.oas.json", "id": "triage_incoming_ticket" },
                { "file": "./config/routes.oas.json", "id": "escalate_with_summary" },
                { "file": "./config/routes.oas.json", "id": "summarize_recurring_issues" }
              ]
            }
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"],
            "outbound": ["prompt-injection-outbound", "secret-masking-outbound"]
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Ticket": {
        "type": "object",
        "description": "A customer support ticket.",
        "required": ["id", "tenantId", "customerEmail", "subject", "body", "status", "priority", "channel", "assigneeEmail", "tags", "slaBreachAt", "openedAt", "resolvedAt", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique ticket id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the ticket belongs to. Set automatically from the API key." },
          "customerEmail": { "type": "string", "format": "email", "description": "Email of the customer who opened the ticket." },
          "subject": { "type": "string", "description": "Short, human-readable subject line." },
          "body": { "type": "string", "description": "The full inquiry body the customer sent." },
          "status": { "type": "string", "enum": ["new", "open", "pending", "resolved", "closed"], "description": "Lifecycle state. `new` until first triaged, `open` once assigned, `pending` after a public reply, `resolved` when the agent resolves, `closed` once acknowledged." },
          "priority": { "type": "string", "enum": ["low", "normal", "high", "urgent"], "description": "Urgency assigned by triage." },
          "channel": { "type": "string", "enum": ["email", "chat", "web", "api"], "description": "Channel the ticket arrived through." },
          "assigneeEmail": { "type": ["string", "null"], "format": "email", "description": "Email of the agent owning the ticket. Null when unassigned." },
          "tags": { "type": "array", "items": { "type": "string" }, "description": "Free-form tags. Used by `summarize_recurring_issues`." },
          "slaBreachAt": { "type": ["string", "null"], "format": "date-time", "description": "When the ticket will breach SLA. Null when no SLA configured." },
          "openedAt": { "type": "string", "format": "date-time", "description": "When the ticket was opened." },
          "resolvedAt": { "type": ["string", "null"], "format": "date-time", "description": "When the ticket was resolved or closed. Null otherwise." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Record creation time." }
        }
      },
      "TicketCreate": {
        "type": "object",
        "description": "Payload to open a new ticket.",
        "required": ["customerEmail", "subject", "body"],
        "properties": {
          "customerEmail": { "type": "string", "format": "email", "description": "Email of the customer." },
          "subject": { "type": "string", "description": "Subject line." },
          "body": { "type": "string", "description": "Body of the inquiry." },
          "priority": { "type": "string", "enum": ["low", "normal", "high", "urgent"], "description": "Initial priority. Defaults to `normal`." },
          "channel": { "type": "string", "enum": ["email", "chat", "web", "api"], "description": "Channel of arrival. Defaults to `api`." },
          "assigneeEmail": { "type": ["string", "null"], "format": "email", "description": "Optional initial assignee." },
          "tags": { "type": "array", "items": { "type": "string" }, "description": "Optional initial tags." },
          "slaBreachAt": { "type": ["string", "null"], "format": "date-time", "description": "Optional SLA breach timestamp." }
        }
      },
      "TicketUpdate": {
        "type": "object",
        "description": "Patch of writable ticket fields.",
        "properties": {
          "subject": { "type": "string", "description": "New subject." },
          "body": { "type": "string", "description": "New body." },
          "status": { "type": "string", "enum": ["new", "open", "pending", "resolved", "closed"], "description": "New status." },
          "priority": { "type": "string", "enum": ["low", "normal", "high", "urgent"], "description": "New priority." },
          "channel": { "type": "string", "enum": ["email", "chat", "web", "api"], "description": "New channel." },
          "assigneeEmail": { "type": ["string", "null"], "format": "email", "description": "New assignee, or null to unassign." },
          "tags": { "type": "array", "items": { "type": "string" }, "description": "Replacement tag list." },
          "slaBreachAt": { "type": ["string", "null"], "format": "date-time", "description": "New SLA breach timestamp." }
        }
      },
      "TicketPage": {
        "type": "object",
        "description": "A page of tickets.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Tickets on this page.", "items": { "$ref": "#/components/schemas/Ticket" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor. Null when no more results." }
        }
      },
      "Conversation": {
        "type": "object",
        "description": "A conversation entry on a ticket.",
        "required": ["id", "tenantId", "ticketId", "kind", "authorEmail", "body", "sentAt", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique conversation id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the conversation belongs to." },
          "ticketId": { "type": "string", "description": "Id of the ticket this entry belongs to." },
          "kind": { "type": "string", "enum": ["public", "internal"], "description": "Public entries are visible to the customer; internal are agent-only." },
          "authorEmail": { "type": "string", "format": "email", "description": "Email of the author (agent or customer)." },
          "body": { "type": "string", "description": "Message body." },
          "sentAt": { "type": "string", "format": "date-time", "description": "When the entry was sent." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Record creation time." }
        }
      },
      "ConversationCreate": {
        "type": "object",
        "description": "Payload to add a conversation entry to a ticket.",
        "required": ["authorEmail", "body"],
        "properties": {
          "authorEmail": { "type": "string", "format": "email", "description": "Email of the author." },
          "body": { "type": "string", "description": "Message body." },
          "kind": { "type": "string", "enum": ["public", "internal"], "description": "Visibility. Defaults to `public`." }
        }
      },
      "Macro": {
        "type": "object",
        "description": "A reusable canned reply.",
        "required": ["id", "tenantId", "name", "body", "tags", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique macro id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the macro belongs to." },
          "name": { "type": "string", "description": "Internal label for the macro." },
          "body": { "type": "string", "description": "Body the macro will paste into a ticket reply." },
          "tags": { "type": "array", "items": { "type": "string" }, "description": "Tags used to look up the macro." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Record creation time." }
        }
      },
      "MacroCreate": {
        "type": "object",
        "description": "Payload to create a macro.",
        "required": ["name", "body"],
        "properties": {
          "name": { "type": "string", "description": "Internal label." },
          "body": { "type": "string", "description": "Reply body." },
          "tags": { "type": "array", "items": { "type": "string" }, "description": "Optional tags." }
        }
      },
      "MacroPage": {
        "type": "object",
        "description": "A page of macros.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Macros on this page.", "items": { "$ref": "#/components/schemas/Macro" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor." }
        }
      },
      "Customer": {
        "type": "object",
        "description": "A customer that can open tickets.",
        "required": ["id", "tenantId", "email", "name", "plan", "accountId", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique customer id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the customer belongs to." },
          "email": { "type": "string", "format": "email", "description": "Customer email; lookup key from tickets." },
          "name": { "type": "string", "description": "Human-readable customer name." },
          "plan": { "type": "string", "description": "Subscription plan or tier (e.g. `free`, `pro`, `enterprise`)." },
          "accountId": { "type": "string", "description": "External account id, e.g. from your billing system." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Record creation time." }
        }
      }
    }
  }
}
