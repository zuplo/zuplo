# Pick a database provider. The kit boots with `in-memory` if unset.
# Options: in-memory | supabase | firestore | clickhouse | upstash-redis | neon
DB_PROVIDER=in-memory

# === Supabase (PostgREST) ===
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJh...
# SUPABASE_TABLE=items

# === Firestore (REST) ===
# FIREBASE_PROJECT=your-gcp-project-id
# FIRESTORE_COLLECTION=items
# FIREBASE_ACCESS_TOKEN=ya29....   # OAuth2 access token; refresh upstream

# === ClickHouse (HTTP) ===
# CLICKHOUSE_URL=https://xxxxx.clickhouse.cloud
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=...
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_TABLE=items

# === Upstash Redis (REST) ===
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# UPSTASH_KEY_PREFIX=items

# === Neon (HTTP serverless) ===
# NEON_HTTP_URL=https://xxxx.neon.tech/sql
# NEON_CONNECTION_STRING=postgresql://...
# NEON_TABLE=items

# === Slack (lead notifications) ===
# Set EITHER an incoming webhook URL (preferred for one-channel sends) OR
# a bot token + channel id for chat.postMessage.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T0000/B0000/xxx
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL=C0123456789

# === Resend (confirmation email + bounce webhook) ===
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=Zuplo <hello@zuplo.com>
# RESEND_REPLY_TO=sales@example.com
# RESEND_WEBHOOK_SECRET=whsec_xxx          # for /webhooks/resend signature verification

# === Claude (Anthropic — lead grading + spam detection) ===
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest  # default
# AI_GATEWAY_URL=https://gw.zuplo.com/v1/proxy/anthropic   # optional Zuplo AI Gateway base
