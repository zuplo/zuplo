{
  "openapi": "3.1.0",
  "info": {
    "title": "IT Asset Tracking API",
    "version": "1.0.0",
    "description": "Headless IT asset tracking API — track laptops, monitors, phones, and other hardware; assign to employees; log maintenance and licenses. Replaces Snipe-IT, Asset Panda, Lansweeper. Ships with orchestrator MCP tools for hire onboarding, offboard recovery, and refresh cycles."
  },
  "paths": {
    "/assets": {
      "get": {
        "operationId": "list_assets",
        "summary": "List assets in the current tenant",
        "description": "Returns a paginated list of tracked hardware assets. Use `cursor` to fetch subsequent pages.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Max assets to return (1-200).",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor from a previous response.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of assets.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AssetPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-assets)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "create_asset",
        "summary": "Create a new asset record",
        "description": "Add a piece of hardware to the inventory. Default `status` is `in_stock`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AssetCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created asset.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Asset" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/create-asset)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/assets/{id}": {
      "get": {
        "operationId": "get_asset",
        "summary": "Get an asset by id",
        "description": "Fetch a single asset from the current tenant by id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Asset id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The asset.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Asset" }
              }
            }
          },
          "404": { "description": "Asset not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/get-asset)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "patch": {
        "operationId": "update_asset",
        "summary": "Update an asset",
        "description": "Partial update of an asset. Use to change `status`, `location`, warranty, or descriptive fields. To retire, prefer `retire_asset`.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Asset id.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AssetUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated asset.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Asset" }
              }
            }
          },
          "404": { "description": "Asset not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/update-asset)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/assets/{id}/retire": {
      "patch": {
        "operationId": "retire_asset",
        "summary": "Retire an asset",
        "description": "Mark an asset as `retired`. Retiring is destructive — the asset is removed from active inventory and cannot be assigned.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Asset id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The retired asset.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Asset" }
              }
            }
          },
          "404": { "description": "Asset not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/retire-asset)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "destructiveHint": true } }
        }
      }
    },
    "/assignments": {
      "get": {
        "operationId": "list_assignments",
        "summary": "List asset assignments",
        "description": "Returns a paginated list of asset-to-employee assignments. Open assignments have `returnedAt = null`.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Max assignments to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of assignments.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AssignmentPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-assignments)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "assign_asset",
        "summary": "Assign an asset to an employee",
        "description": "Open an Assignment row for an asset and an employee. Best-effort flips the asset's status to `assigned`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AssignmentCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created assignment.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Assignment" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/assign-asset)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/assignments/return": {
      "post": {
        "operationId": "return_asset",
        "summary": "Mark an assignment returned",
        "description": "Close an open assignment by stamping `returnedAt` and `returnCondition`. Best-effort flips the asset back to `in_stock`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AssignmentReturn" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The closed assignment.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Assignment" }
              }
            }
          },
          "404": { "description": "Assignment not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/return-asset)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/maintenance": {
      "get": {
        "operationId": "list_maintenance",
        "summary": "List maintenance records",
        "description": "Returns a paginated list of maintenance records (repairs, upgrades, audits) ordered most recent first.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Max records to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of maintenance records.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MaintenancePage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-maintenance)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "log_maintenance",
        "summary": "Log a maintenance event",
        "description": "Record a repair, upgrade, or audit performed on an asset.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MaintenanceCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The logged maintenance record.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MaintenanceRecord" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/log-maintenance)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/licenses": {
      "get": {
        "operationId": "list_licenses",
        "summary": "List software licenses",
        "description": "Returns a paginated list of software licenses tied to assets.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Max licenses to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of licenses.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LicensePage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-licenses)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "add_license",
        "summary": "Add a license to an asset",
        "description": "Attach a software license (key + expiry) to an asset.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LicenseCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created license.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/License" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/add-license)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/assign-laptop-to-hire": {
      "post": {
        "operationId": "assign_laptop_to_hire",
        "summary": "Assign a laptop (or other kind) to a new hire (orchestrator)",
        "description": "Orchestrator MCP tool. Picks the first in_stock asset of the requested kind, creates an Assignment for the new hire, and flips the asset to assigned. Returns 409 if no inventory matches.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["employeeEmail"],
                "properties": {
                  "employeeEmail": { "type": "string", "format": "email", "description": "Email address of the new hire." },
                  "kind": {
                    "type": "string",
                    "enum": ["laptop", "monitor", "phone", "peripheral", "server", "other"],
                    "description": "Kind of asset to assign. Defaults to 'laptop'."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The picked asset and the new assignment.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "asset": { "$ref": "#/components/schemas/Asset" },
                    "assignment": { "$ref": "#/components/schemas/Assignment" },
                    "message": { "type": "string", "description": "Human-readable summary." }
                  }
                }
              }
            }
          },
          "409": { "description": "No in_stock asset matched the requested kind." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/assign-laptop-to-hire)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/find-unrecovered-offboards": {
      "post": {
        "operationId": "find_unrecovered_offboards",
        "summary": "Find unrecovered offboard equipment (orchestrator)",
        "description": "Orchestrator MCP tool. Lists Assignments where `returnedAt` is null and `assignedAt` is older than `daysBack` days — i.e. equipment that hasn't come back. Hydrates the asset on each row.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "daysBack": { "type": "integer", "description": "Threshold in days. Defaults to 30.", "minimum": 0, "maximum": 3650 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stale assignments with hydrated asset info.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": { "type": "integer", "description": "Number of stale open assignments." },
                    "daysBack": { "type": "integer", "description": "Threshold used (echoed back)." },
                    "assignments": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "assignment": { "$ref": "#/components/schemas/Assignment" },
                          "asset": { "$ref": "#/components/schemas/Asset" },
                          "daysOpen": { "type": "integer", "description": "Days since assignedAt." }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/find-unrecovered-offboards)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/schedule-refresh-cycle": {
      "post": {
        "operationId": "schedule_refresh_cycle",
        "summary": "Find assets due for refresh (orchestrator)",
        "description": "Orchestrator MCP tool. Lists assets older than `ageYears` (by purchaseDate) that need refreshing. Each entry includes the open assignment so an agent knows the current holder.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ageYears"],
                "properties": {
                  "ageYears": { "type": "number", "description": "Age threshold in years (e.g. 3).", "minimum": 0, "maximum": 20 },
                  "kind": {
                    "type": "string",
                    "enum": ["laptop", "monitor", "phone", "peripheral", "server", "other"],
                    "description": "Restrict to one kind. Optional."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Assets due for refresh.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": { "type": "integer", "description": "Number of assets due." },
                    "ageYears": { "type": "number", "description": "Threshold used (echoed back)." },
                    "kind": { "type": ["string", "null"], "description": "Kind filter (echoed back)." },
                    "assets": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "asset": { "$ref": "#/components/schemas/Asset" },
                          "ageYears": { "type": "number", "description": "Computed age in years." },
                          "currentAssignment": { "$ref": "#/components/schemas/Assignment" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/schedule-refresh-cycle)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp_handler",
        "summary": "MCP server endpoint",
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "it-asset-tracking-server",
              "version": "1.0.0",
              "operations": [
                { "file": "./config/routes.oas.json", "id": "list_assets" },
                { "file": "./config/routes.oas.json", "id": "get_asset" },
                { "file": "./config/routes.oas.json", "id": "create_asset" },
                { "file": "./config/routes.oas.json", "id": "update_asset" },
                { "file": "./config/routes.oas.json", "id": "retire_asset" },
                { "file": "./config/routes.oas.json", "id": "list_assignments" },
                { "file": "./config/routes.oas.json", "id": "assign_asset" },
                { "file": "./config/routes.oas.json", "id": "return_asset" },
                { "file": "./config/routes.oas.json", "id": "list_maintenance" },
                { "file": "./config/routes.oas.json", "id": "log_maintenance" },
                { "file": "./config/routes.oas.json", "id": "list_licenses" },
                { "file": "./config/routes.oas.json", "id": "add_license" },
                { "file": "./config/routes.oas.json", "id": "assign_laptop_to_hire" },
                { "file": "./config/routes.oas.json", "id": "find_unrecovered_offboards" },
                { "file": "./config/routes.oas.json", "id": "schedule_refresh_cycle" }
              ]
            }
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"],
            "outbound": ["prompt-injection-outbound", "secret-masking-outbound"]
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Asset": {
        "type": "object",
        "description": "A tracked piece of company hardware (laptop, monitor, phone, etc.).",
        "required": ["id", "tenantId", "assetTag", "kind", "make", "model", "serialNumber", "status", "purchaseDate", "purchaseCostCents", "warrantyEndDate", "location", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique asset id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the asset belongs to. Set automatically from the API key." },
          "assetTag": { "type": "string", "description": "Human-friendly tag printed on the device (e.g. ACME-LT-014)." },
          "kind": { "type": "string", "enum": ["laptop", "monitor", "phone", "peripheral", "server", "other"], "description": "Hardware kind." },
          "make": { "type": "string", "description": "Manufacturer (Apple, Dell, etc.)." },
          "model": { "type": "string", "description": "Model name (MacBook Pro 14, etc.)." },
          "serialNumber": { "type": "string", "description": "Vendor serial number." },
          "status": { "type": "string", "enum": ["in_stock", "assigned", "in_repair", "retired", "lost"], "description": "Lifecycle state." },
          "purchaseDate": { "type": "string", "format": "date", "description": "Date the asset was purchased." },
          "purchaseCostCents": { "type": "integer", "description": "Purchase price in cents." },
          "warrantyEndDate": { "type": ["string", "null"], "format": "date", "description": "Warranty expiry date. Null if unknown." },
          "location": { "type": "string", "description": "Free-form location (HQ-1F, remote-employeeEmail, warehouse-A, etc.)." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Record creation time." }
        }
      },
      "AssetCreate": {
        "type": "object",
        "description": "Payload to create an asset record.",
        "required": ["assetTag", "kind", "make", "model", "serialNumber", "purchaseDate", "purchaseCostCents", "location"],
        "properties": {
          "assetTag": { "type": "string", "description": "Human-friendly asset tag." },
          "kind": { "type": "string", "enum": ["laptop", "monitor", "phone", "peripheral", "server", "other"], "description": "Hardware kind." },
          "make": { "type": "string", "description": "Manufacturer." },
          "model": { "type": "string", "description": "Model name." },
          "serialNumber": { "type": "string", "description": "Vendor serial number." },
          "status": { "type": "string", "enum": ["in_stock", "assigned", "in_repair", "retired", "lost"], "description": "Initial status. Defaults to 'in_stock'." },
          "purchaseDate": { "type": "string", "format": "date", "description": "Purchase date." },
          "purchaseCostCents": { "type": "integer", "description": "Purchase price in cents." },
          "warrantyEndDate": { "type": ["string", "null"], "format": "date", "description": "Warranty expiry date." },
          "location": { "type": "string", "description": "Location code or free-form location." }
        }
      },
      "AssetUpdate": {
        "type": "object",
        "description": "Partial update payload for an asset.",
        "properties": {
          "status": { "type": "string", "enum": ["in_stock", "assigned", "in_repair", "retired", "lost"], "description": "New status." },
          "location": { "type": "string", "description": "New location." },
          "warrantyEndDate": { "type": ["string", "null"], "format": "date", "description": "Updated warranty expiry." },
          "make": { "type": "string", "description": "Corrected manufacturer." },
          "model": { "type": "string", "description": "Corrected model." },
          "serialNumber": { "type": "string", "description": "Corrected serial number." }
        }
      },
      "AssetPage": {
        "type": "object",
        "description": "A page of assets.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Assets on this page.", "items": { "$ref": "#/components/schemas/Asset" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor. Null when no more results." }
        }
      },
      "Assignment": {
        "type": "object",
        "description": "An assignment of an asset to an employee.",
        "required": ["id", "tenantId", "assetId", "employeeEmail", "assignedAt", "returnedAt", "returnCondition", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique assignment id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the assignment belongs to." },
          "assetId": { "type": "string", "description": "Id of the assigned asset." },
          "employeeEmail": { "type": "string", "format": "email", "description": "Email of the employee currently holding the asset." },
          "assignedAt": { "type": "string", "format": "date-time", "description": "When the asset was assigned." },
          "returnedAt": { "type": ["string", "null"], "format": "date-time", "description": "When the asset was returned. Null while open." },
          "returnCondition": { "type": ["string", "null"], "description": "Condition reported on return (good, scratched, screen-broken, lost, etc.). Null while open." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Record creation time." }
        }
      },
      "AssignmentCreate": {
        "type": "object",
        "description": "Payload to open an assignment.",
        "required": ["assetId", "employeeEmail"],
        "properties": {
          "assetId": { "type": "string", "description": "Id of the asset being assigned." },
          "employeeEmail": { "type": "string", "format": "email", "description": "Email of the employee receiving it." },
          "assignedAt": { "type": "string", "format": "date-time", "description": "Override the assignment timestamp. Defaults to now." }
        }
      },
      "AssignmentReturn": {
        "type": "object",
        "description": "Payload to close an assignment.",
        "required": ["assignmentId", "returnCondition"],
        "properties": {
          "assignmentId": { "type": "string", "description": "Id of the open assignment." },
          "returnedAt": { "type": "string", "format": "date-time", "description": "When the asset was returned. Defaults to now." },
          "returnCondition": { "type": "string", "description": "Free-form condition (good, scratched, screen-broken, etc.)." }
        }
      },
      "AssignmentPage": {
        "type": "object",
        "description": "A page of assignments.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Assignments on this page.", "items": { "$ref": "#/components/schemas/Assignment" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor." }
        }
      },
      "MaintenanceRecord": {
        "type": "object",
        "description": "A maintenance event recorded against an asset.",
        "required": ["id", "tenantId", "assetId", "kind", "description", "technicianEmail", "costCents", "performedAt", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique maintenance id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the record belongs to." },
          "assetId": { "type": "string", "description": "Id of the asset that received maintenance." },
          "kind": { "type": "string", "enum": ["repair", "upgrade", "audit"], "description": "Kind of maintenance." },
          "description": { "type": "string", "description": "What was done." },
          "technicianEmail": { "type": "string", "format": "email", "description": "Email of the technician who did the work." },
          "costCents": { "type": "integer", "description": "Cost in cents (zero if internal)." },
          "performedAt": { "type": "string", "format": "date-time", "description": "When the work was performed." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Record creation time." }
        }
      },
      "MaintenanceCreate": {
        "type": "object",
        "description": "Payload to log a maintenance event.",
        "required": ["assetId", "kind", "description", "technicianEmail", "costCents"],
        "properties": {
          "assetId": { "type": "string", "description": "Asset that received maintenance." },
          "kind": { "type": "string", "enum": ["repair", "upgrade", "audit"], "description": "Kind of maintenance." },
          "description": { "type": "string", "description": "What was done." },
          "technicianEmail": { "type": "string", "format": "email", "description": "Technician email." },
          "costCents": { "type": "integer", "description": "Cost in cents." },
          "performedAt": { "type": "string", "format": "date-time", "description": "When the work was performed. Defaults to now." }
        }
      },
      "MaintenancePage": {
        "type": "object",
        "description": "A page of maintenance records.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Maintenance records on this page.", "items": { "$ref": "#/components/schemas/MaintenanceRecord" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor." }
        }
      },
      "License": {
        "type": "object",
        "description": "A software license attached to an asset.",
        "required": ["id", "tenantId", "assetId", "softwareName", "licenseKey", "expiresAt", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique license id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the license belongs to." },
          "assetId": { "type": "string", "description": "Asset the license is installed on." },
          "softwareName": { "type": "string", "description": "Software product name (e.g. Adobe Creative Cloud)." },
          "licenseKey": { "type": "string", "description": "License key. Treat as a secret — secret-masking-outbound will redact it on MCP responses." },
          "expiresAt": { "type": ["string", "null"], "format": "date-time", "description": "License expiry. Null for perpetual licenses." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Record creation time." }
        }
      },
      "LicenseCreate": {
        "type": "object",
        "description": "Payload to attach a license to an asset.",
        "required": ["assetId", "softwareName", "licenseKey"],
        "properties": {
          "assetId": { "type": "string", "description": "Asset the license is installed on." },
          "softwareName": { "type": "string", "description": "Software product name." },
          "licenseKey": { "type": "string", "description": "License key." },
          "expiresAt": { "type": ["string", "null"], "format": "date-time", "description": "Expiry. Null for perpetual." }
        }
      },
      "LicensePage": {
        "type": "object",
        "description": "A page of licenses.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Licenses on this page.", "items": { "$ref": "#/components/schemas/License" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor." }
        }
      }
    }
  }
