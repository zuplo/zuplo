{
  "openapi": "3.1.0",
  "info": {
    "title": "Corporate Card / Spend Controls API",
    "version": "1.0.0",
    "description": "Headless spend-management API for corporate cards. Replaces Ramp/Brex/Airbase. Exposes card issuance state, transaction coding, spend limits, and orchestrators that an LLM agent can call to nudge employees and right-size limits."
  },
  "paths": {
    "/transactions": {
      "get": {
        "operationId": "list_transactions",
        "summary": "List card transactions",
        "description": "Returns a paginated list of card transactions in the current tenant, newest first.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of transactions to return. Defaults to 50.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor from a previous response.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of transactions.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TransactionPage" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-transactions)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/transactions/{id}": {
      "get": {
        "operationId": "get_transaction",
        "summary": "Get a transaction by id",
        "description": "Fetch a single card transaction by id from the current tenant.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Transaction id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The transaction.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Transaction" } } } },
          "404": { "description": "Transaction not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/get-transaction)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/transactions/{id}/code": {
      "patch": {
        "operationId": "code_transaction",
        "summary": "Code a transaction with category and GL code",
        "description": "Assign an expense category and optional GL code to a transaction. Marks the transaction as coded for downstream accounting export.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Transaction id.", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CodeTransactionRequest" } } }
        },
        "responses": {
          "200": { "description": "Updated transaction.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Transaction" } } } },
          "404": { "description": "Transaction not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/code-transaction)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/transactions/{id}/memo": {
      "patch": {
        "operationId": "add_memo",
        "summary": "Add or update memo on a transaction",
        "description": "Attach a free-text memo to a transaction explaining the business purpose. Replaces any existing memo.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Transaction id.", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddMemoRequest" } } }
        },
        "responses": {
          "200": { "description": "Updated transaction.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Transaction" } } } },
          "404": { "description": "Transaction not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/add-memo)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/cards": {
      "get": {
        "operationId": "list_cards",
        "summary": "List corporate cards",
        "description": "Returns a paginated list of corporate cards issued in the current tenant.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Maximum number of cards to return.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Opaque pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Page of cards.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CardPage" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-cards)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/cards/{id}/freeze": {
      "post": {
        "operationId": "freeze_card",
        "summary": "Freeze a corporate card",
        "description": "Immediately blocks new transactions on the card. Existing pending authorizations may still post. Use during suspected fraud or employee offboarding.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Card id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Updated card.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Card" } } } },
          "404": { "description": "Card not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/freeze-card)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "destructiveHint": true } }
        }
      }
    },
    "/cards/{id}/unfreeze": {
      "post": {
        "operationId": "unfreeze_card",
        "summary": "Unfreeze a corporate card",
        "description": "Re-enables transactions on a previously frozen card.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Card id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Updated card.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Card" } } } },
          "404": { "description": "Card not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/unfreeze-card)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/cards/{id}/spend-limit": {
      "put": {
        "operationId": "set_spend_limit",
        "summary": "Set the spend limit on a card",
        "description": "Update the recurring spend limit and optional interval (in days) for a card. Resets internal counters at the next interval boundary.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Card id.", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SetSpendLimitRequest" } } }
        },
        "responses": {
          "200": { "description": "Updated card.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Card" } } } },
          "404": { "description": "Card not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/set-spend-limit)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/find-uncoded-transactions": {
      "post": {
        "operationId": "find_uncoded_transactions",
        "summary": "Find uncoded transactions (orchestrator)",
        "description": "Returns posted transactions that have not yet been GL-coded. Optionally filtered by employee email and time window. Useful for nudging employees before month-end close.",
        "requestBody": {
          "required": false,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FindUncodedRequest" } } }
        },
        "responses": {
          "200": {
            "description": "List of uncoded transactions.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FindUncodedResponse" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/find-uncoded-transactions)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/recommend-limit-change": {
      "post": {
        "operationId": "recommend_limit_change",
        "summary": "Recommend a spend limit change (orchestrator)",
        "description": "Looks at the last 90 days of posted spend on a card vs. its current limit and recommends keeping, raising, or lowering the limit.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecommendLimitRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Recommendation.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecommendLimitResponse" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/recommend-limit-change)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp_handler",
        "summary": "MCP server endpoint",
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "corporate-card-spend",
              "version": "1.0.0",
              "operations": [
                { "file": "./config/routes.oas.json", "id": "list_transactions" },
                { "file": "./config/routes.oas.json", "id": "get_transaction" },
                { "file": "./config/routes.oas.json", "id": "code_transaction" },
                { "file": "./config/routes.oas.json", "id": "add_memo" },
                { "file": "./config/routes.oas.json", "id": "list_cards" },
                { "file": "./config/routes.oas.json", "id": "freeze_card" },
                { "file": "./config/routes.oas.json", "id": "unfreeze_card" },
                { "file": "./config/routes.oas.json", "id": "set_spend_limit" },
                { "file": "./config/routes.oas.json", "id": "find_uncoded_transactions" },
                { "file": "./config/routes.oas.json", "id": "recommend_limit_change" }
              ]
            }
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"],
            "outbound": ["prompt-injection-outbound", "secret-masking-outbound"]
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Transaction": {
        "type": "object",
        "description": "A card transaction posted by the issuer network.",
        "required": ["id", "tenantId", "cardId", "amountCents", "currency", "merchantName", "mcc", "postedAt", "status", "coded"],
        "properties": {
          "id": { "type": "string", "description": "Unique transaction id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the transaction belongs to. Set automatically from the API key." },
          "cardId": { "type": "string", "description": "Id of the card this transaction was charged to." },
          "amountCents": { "type": "integer", "description": "Amount in the smallest currency unit (cents)." },
          "currency": { "type": "string", "description": "ISO 4217 currency code (e.g. USD, EUR)." },
          "merchantName": { "type": "string", "description": "Name of the merchant as reported by the network." },
          "mcc": { "type": "string", "description": "Merchant category code (4-digit ISO 18245)." },
          "postedAt": { "type": "string", "format": "date-time", "description": "ISO-8601 timestamp the transaction posted." },
          "category": { "type": ["string", "null"], "description": "Expense category assigned during coding (e.g. travel, software). Null until coded." },
          "glCode": { "type": ["string", "null"], "description": "General-ledger account code assigned during coding." },
          "memo": { "type": ["string", "null"], "description": "Free-text memo explaining the business purpose. Null if none." },
          "status": {
            "type": "string",
            "enum": ["pending", "posted", "declined", "disputed"],
            "description": "Transaction lifecycle state."
          },
          "coded": { "type": "boolean", "description": "True once category + glCode have been assigned." }
        }
      },
      "TransactionPage": {
        "type": "object",
        "description": "A page of transactions.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Transactions in this page.", "items": { "$ref": "#/components/schemas/Transaction" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pass back as `cursor` for the next page. Null when no more results." }
        }
      },
      "Card": {
        "type": "object",
        "description": "A corporate card issued to an employee.",
        "required": ["id", "tenantId", "employeeEmail", "last4", "status", "spendLimitCents", "intervalDays", "currentSpendCents", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique card id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the card belongs to." },
          "employeeEmail": { "type": "string", "format": "email", "description": "Email of the employee the card is issued to." },
          "last4": { "type": "string", "description": "Last four digits of the card PAN." },
          "status": {
            "type": "string",
            "enum": ["active", "frozen", "canceled"],
            "description": "Card lifecycle state."
          },
          "spendLimitCents": { "type": "integer", "description": "Recurring spend limit in cents." },
          "intervalDays": { "type": "integer", "description": "Length of the spend interval in days (e.g. 30 for monthly)." },
          "currentSpendCents": { "type": "integer", "description": "Spend used so far in the current interval, in cents." },
          "createdAt": { "type": "string", "format": "date-time", "description": "ISO-8601 timestamp the card was issued." }
        }
      },
      "CardPage": {
        "type": "object",
        "description": "A page of cards.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Cards in this page.", "items": { "$ref": "#/components/schemas/Card" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor." }
        }
      },
      "CodeTransactionRequest": {
        "type": "object",
        "description": "Payload to assign a category and optional GL code to a transaction.",
        "required": ["category"],
        "properties": {
          "category": { "type": "string", "description": "Expense category (e.g. travel, software, meals)." },
          "glCode": { "type": "string", "description": "General-ledger account code." }
        }
      },
      "AddMemoRequest": {
        "type": "object",
        "description": "Payload to attach a memo explaining the business purpose of a transaction.",
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "description": "Free-text memo content." }
        }
      },
      "SetSpendLimitRequest": {
        "type": "object",
        "description": "Payload to update the recurring spend limit on a card.",
        "required": ["limitCents"],
        "properties": {
          "limitCents": { "type": "integer", "minimum": 0, "description": "New recurring spend limit in cents." },
          "intervalDays": { "type": "integer", "minimum": 1, "description": "Length of the spend interval in days. Optional — keeps existing if omitted." }
        }
      },
      "FindUncodedRequest": {
        "type": "object",
        "description": "Filter for find_uncoded_transactions.",
        "properties": {
          "employeeEmail": { "type": "string", "format": "email", "description": "Restrict to transactions on cards issued to this employee." },
          "daysBack": { "type": "integer", "minimum": 1, "maximum": 365, "description": "Look back this many days. Defaults to 30." }
        }
      },
      "FindUncodedResponse": {
        "type": "object",
        "description": "Result of find_uncoded_transactions.",
        "required": ["count", "transactions"],
        "properties": {
          "count": { "type": "integer", "description": "Number of uncoded transactions returned." },
          "transactions": { "type": "array", "description": "The uncoded transactions.", "items": { "$ref": "#/components/schemas/Transaction" } }
        }
      },
      "RecommendLimitRequest": {
        "type": "object",
        "description": "Input for recommend_limit_change.",
        "required": ["cardId"],
        "properties": {
          "cardId": { "type": "string", "description": "Card to evaluate." }
        }
      },
      "RecommendLimitResponse": {
        "type": "object",
        "description": "Recommendation from recommend_limit_change.",
        "required": ["cardId", "currentLimitCents", "ninetyDaySpendCents", "transactionCount", "utilizationRatio", "recommendation", "recommendedLimitCents"],
        "properties": {
          "cardId": { "type": "string", "description": "Card id evaluated." },
          "currentLimitCents": { "type": "integer", "description": "Current spend limit in cents." },
          "ninetyDaySpendCents": { "type": "integer", "description": "Total posted spend over the last 90 days in cents." },
          "transactionCount": { "type": "integer", "description": "How many posted transactions the recommendation considered." },
          "utilizationRatio": { "type": "number", "description": "ninetyDaySpendCents / currentLimitCents (when limit > 0)." },
          "recommendation": { "type": "string", "enum": ["increase", "decrease", "keep"], "description": "Suggested action." },
          "recommendedLimitCents": { "type": "integer", "description": "Suggested new limit in cents." }
        }
      }
    }
  }
}
