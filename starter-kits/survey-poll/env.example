# Pick a database provider. The kit boots with `in-memory` if unset.
# Options: in-memory | supabase | firestore | clickhouse | upstash-redis | neon
DB_PROVIDER=in-memory

# === Supabase (PostgREST) ===
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJh...
# SUPABASE_TABLE=items

# === Firestore (REST) ===
# FIREBASE_PROJECT=your-gcp-project-id
# FIRESTORE_COLLECTION=items
# FIREBASE_ACCESS_TOKEN=ya29....   # OAuth2 access token; refresh upstream

# === ClickHouse (HTTP) ===
# CLICKHOUSE_URL=https://xxxxx.clickhouse.cloud
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=...
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_TABLE=items

# === Upstash Redis (REST) ===
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# UPSTASH_KEY_PREFIX=items

# === Neon (HTTP serverless) ===
# NEON_HTTP_URL=https://xxxx.neon.tech/sql
# NEON_CONNECTION_STRING=postgresql://...
# NEON_TABLE=items

# === Resend (transactional email) ===
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=hello@yourdomain.com
# Webhook secret from Resend dashboard (used by /webhooks/resend)
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx

# === Twilio (SMS distribution) ===
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM_NUMBER=+15551234567
# Optional: use a Messaging Service SID instead of a single from-number
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx

# === Slack (detractor alerts) ===
# Use either an incoming webhook URL OR a bot token + channel.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxx
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_DEFAULT_CHANNEL=#nps-detractors

# === Anthropic Claude (open-text clustering) ===
# ANTHROPIC_API_KEY=sk-ant-...
# Optional — route through Zuplo's AI Gateway. If unset, calls go straight
# to api.anthropic.com.
# AI_GATEWAY_URL=https://gateway.zuplo.com/anthropic
# CLAUDE_MODEL=claude-sonnet-4-5
