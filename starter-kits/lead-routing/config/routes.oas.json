{
  "openapi": "3.1.0",
  "info": {
    "title": "Lead Routing / SDR API",
    "version": "1.0.0",
    "description": "Headless lead-routing API for SDR teams. Replaces Chili Piper, LeanData, and Salesforce Flow routing. Leads are routed via priority-ordered RoutingRules; orchestrator MCP tools assign leads, match accounts, and surface stale pipeline."
  },
  "paths": {
    "/leads": {
      "get": {
        "operationId": "list_leads",
        "summary": "List leads in the current tenant",
        "description": "Returns a paginated list of leads belonging to the authenticated API key's tenant, newest first.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Maximum number of leads to return.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Opaque pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Page of leads.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LeadPage" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-leads)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "create_lead",
        "summary": "Create a lead",
        "description": "Create a new lead in the current tenant. Status defaults to 'new'; route_lead_intelligently can be called immediately after to assign.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LeadCreate" } } }
        },
        "responses": {
          "201": {
            "description": "The created lead.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Lead" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/create-lead)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/leads/{id}": {
      "get": {
        "operationId": "get_lead",
        "summary": "Get a lead by id",
        "description": "Fetch a single lead from the current tenant by its id.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Lead id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The lead.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Lead" } } }
          },
          "404": { "description": "Lead not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/get-lead)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/leads/{id}/assign": {
      "patch": {
        "operationId": "assign_lead",
        "summary": "Assign a lead to a rep",
        "description": "Update the lead's `assignedTo` field and stamp `assignedAt`. Used directly by ops or indirectly by the route_lead_intelligently orchestrator.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Lead id.", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["assignTo"],
                "properties": {
                  "assignTo": { "type": "string", "description": "Rep email to assign the lead to." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated lead.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Lead" } } }
          },
          "404": { "description": "Lead not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/assign-lead)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/leads/{id}/qualify": {
      "patch": {
        "operationId": "qualify_lead",
        "summary": "Mark a lead as qualified",
        "description": "Transition the lead's status to 'qualified'. The next step is typically book_meeting.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Lead id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The updated lead.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Lead" } } }
          },
          "404": { "description": "Lead not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/qualify-lead)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/leads/{id}/disqualify": {
      "patch": {
        "operationId": "disqualify_lead",
        "summary": "Mark a lead as unqualified",
        "description": "Transition the lead's status to 'unqualified'. Final state for leads that don't fit the ICP.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Lead id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The updated lead.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Lead" } } }
          },
          "404": { "description": "Lead not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/disqualify-lead)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/routing-rules": {
      "get": {
        "operationId": "list_routing_rules",
        "summary": "List routing rules",
        "description": "Returns the tenant's routing rules ordered by priority ascending. Lower priority numbers are evaluated first.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Maximum number of rules.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Opaque pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Page of routing rules.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoutingRulePage" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-routing-rules)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "create_routing_rule",
        "summary": "Create a routing rule",
        "description": "Create a routing rule with priority, conditions, and target rep. Lower priority is evaluated first.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoutingRuleCreate" } } }
        },
        "responses": {
          "201": {
            "description": "The created routing rule.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoutingRule" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/create-routing-rule)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/territories": {
      "get": {
        "operationId": "list_territories",
        "summary": "List territories",
        "description": "Returns the tenant's territories — the rep pools used to scope routing decisions.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Maximum number of territories.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Opaque pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Page of territories.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TerritoryPage" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-territories)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/meeting-bookings": {
      "post": {
        "operationId": "book_meeting",
        "summary": "Book a meeting with a lead",
        "description": "Create a discovery or demo meeting booking with a rep for a qualified lead.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MeetingBookingCreate" } } }
        },
        "responses": {
          "201": {
            "description": "The created booking.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MeetingBooking" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/book-meeting)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/route-lead-intelligently": {
      "post": {
        "operationId": "route_lead_intelligently",
        "summary": "Assign a lead by evaluating routing rules (orchestrator)",
        "description": "Loads the lead, walks active routing rules in priority order, picks the first whose conditions match, and assigns the lead. Optionally pings the assigned rep over Slack and/or Resend. Returns the chosen rule, the per-rule trace, and the notification status.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["leadId"],
                "properties": {
                  "leadId": { "type": "string", "description": "Lead id to route." },
                  "notifySlack": { "type": "boolean", "description": "When true (default), posts to Slack if SLACK_BOT_TOKEN or SLACK_WEBHOOK_URL is set." },
                  "notifyEmail": { "type": "boolean", "description": "When true, emails the assigned rep via Resend." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Routing result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "leadId": { "type": "string", "description": "Lead id." },
                    "assigned": { "type": "boolean", "description": "Whether a rep was assigned." },
                    "assignedTo": { "type": "string", "description": "Rep email if assigned." },
                    "ruleId": { "type": "string", "description": "Matching rule id." },
                    "ruleName": { "type": "string", "description": "Matching rule name." },
                    "reason": { "type": "string", "description": "Human reason if no rule matched." },
                    "trace": {
                      "type": "array",
                      "description": "Per-rule decision trace.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ruleId": { "type": "string", "description": "Rule id." },
                          "ruleName": { "type": "string", "description": "Rule name." },
                          "matched": { "type": "boolean", "description": "Whether the rule matched." },
                          "reason": { "type": "string", "description": "Per-condition match log." }
                        }
                      }
                    },
                    "notifications": {
                      "type": "object",
                      "description": "Status of side-effect notifications.",
                      "properties": {
                        "slack": {
                          "type": "object",
                          "properties": {
                            "ok": { "type": "boolean", "description": "Whether Slack accepted the message." },
                            "ts": { "type": "string", "description": "Slack message timestamp (bot-token mode)." },
                            "error": { "type": "string", "description": "Slack error if !ok." }
                          }
                        },
                        "email": {
                          "type": "object",
                          "properties": {
                            "id": { "type": "string", "description": "Resend message id on success." },
                            "error": { "type": "string", "description": "Resend error message on failure." }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/route-lead-intelligently)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/match-lead-to-account": {
      "post": {
        "operationId": "match_lead_to_account",
        "summary": "Find existing leads sharing the same email domain (orchestrator)",
        "description": "Returns leads with the same email domain as the input lead — a cheap proxy for 'same account'. Filters out free-mail domains.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["leadId"],
                "properties": {
                  "leadId": { "type": "string", "description": "Lead id whose domain to match against." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Matching candidates.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "leadId": { "type": "string", "description": "Input lead id." },
                    "domain": { "type": "string", "description": "Email domain matched." },
                    "candidateCount": { "type": "integer", "description": "Total candidates found." },
                    "candidates": {
                      "type": "array",
                      "description": "Matching leads.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string", "description": "Lead id." },
                          "firstName": { "type": "string", "description": "First name." },
                          "lastName": { "type": "string", "description": "Last name." },
                          "company": { "type": "string", "description": "Company." },
                          "title": { "type": "string", "description": "Title." },
                          "assignedTo": { "type": "string", "nullable": true, "description": "Rep email." },
                          "status": { "type": "string", "description": "Lead status." }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/match-lead-to-account)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/summarize-unworked-leads": {
      "post": {
        "operationId": "summarize_unworked_leads",
        "summary": "Find stale assigned leads (orchestrator)",
        "description": "Lists leads in 'new' or 'contacted' status that were assigned more than `daysSince` days ago and never moved forward. Useful for SDR managers running weekly hygiene.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ownerEmail": { "type": "string", "description": "Filter by rep email. Omit for org-wide view." },
                  "daysSince": { "type": "integer", "minimum": 1, "maximum": 365, "description": "Minimum age in days. Defaults to 7." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stale leads grouped by owner.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "thresholdDays": { "type": "integer", "description": "Days threshold used." },
                    "ownerFilter": { "type": "string", "nullable": true, "description": "Owner filter applied." },
                    "total": { "type": "integer", "description": "Total stale leads." },
                    "byOwner": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "count": { "type": "integer", "description": "Stale leads owned by this rep." },
                          "leads": { "type": "array", "items": { "$ref": "#/components/schemas/Lead" }, "description": "Up to 25 sample leads." }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/summarize-unworked-leads)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp_handler",
        "summary": "MCP server endpoint",
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "lead-routing-server",
              "version": "1.0.0",
              "operations": [
                { "file": "./config/routes.oas.json", "id": "list_leads" },
                { "file": "./config/routes.oas.json", "id": "get_lead" },
                { "file": "./config/routes.oas.json", "id": "create_lead" },
                { "file": "./config/routes.oas.json", "id": "assign_lead" },
                { "file": "./config/routes.oas.json", "id": "qualify_lead" },
                { "file": "./config/routes.oas.json", "id": "disqualify_lead" },
                { "file": "./config/routes.oas.json", "id": "list_routing_rules" },
                { "file": "./config/routes.oas.json", "id": "create_routing_rule" },
                { "file": "./config/routes.oas.json", "id": "list_territories" },
                { "file": "./config/routes.oas.json", "id": "book_meeting" },
                { "file": "./config/routes.oas.json", "id": "route_lead_intelligently" },
                { "file": "./config/routes.oas.json", "id": "match_lead_to_account" },
                { "file": "./config/routes.oas.json", "id": "summarize_unworked_leads" }
              ]
            }
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"],
            "outbound": ["prompt-injection-outbound", "secret-masking-outbound"]
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Lead": {
        "type": "object",
        "description": "A sales lead — the parent entity in lead-routing.",
        "required": ["id", "tenantId", "firstName", "lastName", "email", "company", "status", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant id; set automatically from the API key." },
          "firstName": { "type": "string", "description": "Lead's first name." },
          "lastName": { "type": "string", "description": "Lead's last name." },
          "email": { "type": "string", "description": "Lead's email." },
          "company": { "type": "string", "description": "Lead's company." },
          "title": { "type": "string", "description": "Lead's job title." },
          "phone": { "type": "string", "description": "Phone number." },
          "source": { "type": "string", "description": "How the lead was acquired (web, ads, event, etc.)." },
          "status": {
            "type": "string",
            "enum": ["new", "contacted", "qualified", "unqualified", "converted"],
            "description": "Funnel stage of the lead."
          },
          "assignedTo": { "type": "string", "nullable": true, "description": "Email of the assigned rep." },
          "assignedAt": { "type": "string", "format": "date-time", "nullable": true, "description": "When the lead was assigned." },
          "score": { "type": "integer", "description": "Lead score (0-100)." },
          "createdAt": { "type": "string", "format": "date-time", "description": "ISO-8601 creation timestamp." }
        }
      },
      "LeadCreate": {
        "type": "object",
        "description": "Payload to create a new lead.",
        "required": ["firstName", "lastName", "email", "company"],
        "properties": {
          "firstName": { "type": "string", "description": "First name." },
          "lastName": { "type": "string", "description": "Last name." },
          "email": { "type": "string", "description": "Email." },
          "company": { "type": "string", "description": "Company." },
          "title": { "type": "string", "description": "Title." },
          "phone": { "type": "string", "description": "Phone." },
          "source": { "type": "string", "description": "Source." },
          "score": { "type": "integer", "description": "Initial lead score." }
        }
      },
      "LeadPage": {
        "type": "object",
        "description": "A page of leads.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Lead" }, "description": "Leads on this page." },
          "nextCursor": { "type": "string", "nullable": true, "description": "Pagination cursor or null." }
        }
      },
      "RoutingRule": {
        "type": "object",
        "description": "A routing rule. Evaluated in priority order to assign a lead.",
        "required": ["id", "tenantId", "name", "priority", "assignTo", "active"],
        "properties": {
          "id": { "type": "string", "description": "Rule id." },
          "tenantId": { "type": "string", "description": "Tenant id; set from the API key." },
          "name": { "type": "string", "description": "Human-readable rule name." },
          "priority": { "type": "integer", "description": "Priority — lower runs first." },
          "conditions": { "type": "object", "additionalProperties": true, "description": "Field-equality match map (e.g. country=US, source=web)." },
          "assignTo": { "type": "string", "description": "Rep email to assign matching leads to." },
          "active": { "type": "boolean", "description": "Whether the rule is currently active." }
        }
      },
      "RoutingRuleCreate": {
        "type": "object",
        "description": "Payload to create a routing rule.",
        "required": ["name", "priority", "conditions", "assignTo"],
        "properties": {
          "name": { "type": "string", "description": "Rule name." },
          "priority": { "type": "integer", "description": "Priority — lower runs first." },
          "conditions": { "type": "object", "additionalProperties": true, "description": "Field-equality conditions." },
          "assignTo": { "type": "string", "description": "Rep email." },
          "active": { "type": "boolean", "description": "Whether the rule is active. Defaults to true." }
        }
      },
      "RoutingRulePage": {
        "type": "object",
        "description": "A page of routing rules.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/RoutingRule" }, "description": "Routing rules on this page." },
          "nextCursor": { "type": "string", "nullable": true, "description": "Pagination cursor or null." }
        }
      },
      "Territory": {
        "type": "object",
        "description": "A geographic / segment territory — a candidate pool of reps.",
        "required": ["id", "tenantId", "name", "repEmails"],
        "properties": {
          "id": { "type": "string", "description": "Territory id." },
          "tenantId": { "type": "string", "description": "Tenant id; set from the API key." },
          "name": { "type": "string", "description": "Territory name." },
          "criteria": { "type": "object", "additionalProperties": true, "description": "Free-form criteria (country, industry, etc.)." },
          "repEmails": { "type": "array", "items": { "type": "string" }, "description": "Reps in this territory." }
        }
      },
      "TerritoryPage": {
        "type": "object",
        "description": "A page of territories.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Territory" }, "description": "Territories on this page." },
          "nextCursor": { "type": "string", "nullable": true, "description": "Pagination cursor or null." }
        }
      },
      "MeetingBooking": {
        "type": "object",
        "description": "A scheduled meeting between a lead and a rep.",
