{
  "openapi": "3.1.0",
  "info": {
    "title": "Time Tracking & Timesheet API",
    "version": "1.0.0",
    "description": "API + MCP server for tracking time, projects, and timesheets. Replaces Harvest, Toggl, and Clockify. Includes orchestrator MCP tools for weekly timesheet submission and unbilled-hour discovery."
  },
  "paths": {
    "/time-entries": {
      "get": {
        "operationId": "list_time_entries",
        "summary": "List time entries in the current tenant",
        "description": "Returns a paginated list of time entries. Supports filtering by employeeId, projectId, status, billable flag, and a startTime window.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of entries to return. Defaults to 50.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor.",
            "schema": { "type": "string" }
          },
          {
            "name": "employeeId",
            "in": "query",
            "description": "Filter to entries for a single employee.",
            "schema": { "type": "string" }
          },
          {
            "name": "projectId",
            "in": "query",
            "description": "Filter to entries for a single project.",
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by entry status.",
            "schema": { "type": "string", "enum": ["draft", "submitted", "approved", "rejected"] }
          },
          {
            "name": "billable",
            "in": "query",
            "description": "Filter to billable (true) or non-billable (false) entries.",
            "schema": { "type": "string", "enum": ["true", "false"] }
          },
          {
            "name": "startTimeFrom",
            "in": "query",
            "description": "Inclusive lower bound on startTime (ISO-8601).",
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "startTimeTo",
            "in": "query",
            "description": "Exclusive upper bound on startTime (ISO-8601).",
            "schema": { "type": "string", "format": "date-time" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of time entries.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TimeEntryPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-time-entries)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      },
      "post": {
        "operationId": "create_time_entry",
        "summary": "Create a time entry",
        "description": "Log a new time entry for an employee. Status defaults to 'draft'. If durationMinutes is omitted it is computed from startTime/endTime.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TimeEntryCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created time entry.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TimeEntry" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/create-time-entry)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false }
          }
        }
      }
    },
    "/time-entries/{id}": {
      "get": {
        "operationId": "get_time_entry",
        "summary": "Get a time entry by id",
        "description": "Fetch a single time entry from the current tenant.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Time entry id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The time entry.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TimeEntry" }
              }
            }
          },
          "404": { "description": "Time entry not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/get-time-entry)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      },
      "patch": {
        "operationId": "update_time_entry",
        "summary": "Update a time entry",
        "description": "Update fields on an existing time entry. Any subset of fields may be provided.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Time entry id.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TimeEntryUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated time entry.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TimeEntry" }
              }
            }
          },
          "404": { "description": "Time entry not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/update-time-entry)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false, "idempotentHint": true }
          }
        }
      },
      "delete": {
        "operationId": "delete_time_entry",
        "summary": "Delete a time entry",
        "description": "Permanently delete a draft time entry. Submitted/approved entries should be edited rather than deleted.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Time entry id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Deleted." },
          "404": { "description": "Time entry not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/delete-time-entry)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "destructiveHint": true }
          }
        }
      }
    },
    "/projects": {
      "get": {
        "operationId": "list_projects",
        "summary": "List projects in the current tenant",
        "description": "List the projects time can be tracked against. Optional `active` filter narrows to active or archived projects.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of projects to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor.",
            "schema": { "type": "string" }
          },
          {
            "name": "active",
            "in": "query",
            "description": "Narrow to active (true) or archived (false) projects.",
            "schema": { "type": "string", "enum": ["true", "false"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of projects.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProjectPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-projects)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      },
      "post": {
        "operationId": "create_project",
        "summary": "Create a project",
        "description": "Create a new project. Defaults to active=true.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProjectCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created project.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Project" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/create-project)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false }
          }
        }
      }
    },
    "/timesheets": {
      "get": {
        "operationId": "list_timesheets",
        "summary": "List timesheets in the current tenant",
        "description": "List weekly timesheet records. Filter by employeeId or status.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of timesheets to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor.",
            "schema": { "type": "string" }
          },
          {
            "name": "employeeId",
            "in": "query",
            "description": "Filter to timesheets for a single employee.",
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by timesheet status.",
            "schema": { "type": "string", "enum": ["draft", "submitted", "approved", "rejected"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of timesheets.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TimesheetPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-timesheets)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      }
    },
    "/submit-weekly-timesheet": {
      "post": {
        "operationId": "submit_weekly_timesheet",
        "summary": "Submit a weekly timesheet for an employee (orchestrator)",
        "description": "Lists all of an employee's time entries for the given week, sums the total minutes, and creates a Timesheet row in 'submitted' status. Returns the new Timesheet plus a summary of the entries that contributed to it.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["employeeId", "weekStartDate"],
                "properties": {
                  "employeeId": {
                    "type": "string",
                    "description": "Employee whose timesheet to submit."
                  },
                  "weekStartDate": {
                    "type": "string",
                    "format": "date",
                    "description": "Monday of the week (YYYY-MM-DD)."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The submitted timesheet plus aggregate.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "timesheet": { "$ref": "#/components/schemas/Timesheet" },
                    "entryCount": { "type": "integer", "description": "Number of time entries in the week." },
                    "totalMinutes": { "type": "integer", "description": "Sum of durationMinutes across the week's entries." },
                    "totalHours": { "type": "number", "description": "totalMinutes / 60, rounded to two decimals." }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/submit-weekly-timesheet)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false }
          }
        }
      }
    },
    "/find-unbilled-hours": {
      "post": {
        "operationId": "find_unbilled_hours",
        "summary": "Find billable hours not yet on a timesheet (orchestrator)",
        "description": "Returns all draft, billable time entries — i.e. tracked work that hasn't been submitted on a timesheet yet — grouped by project. Optional projectId narrows the scan.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "projectId": {
                    "type": "string",
                    "description": "Optional: limit the scan to a single project."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Unbilled hours grouped by project.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "filter": {
                      "type": "object",
                      "description": "Echo of the filter applied.",
                      "properties": {
                        "projectId": { "type": ["string", "null"], "description": "Project filter, if any." }
                      }
                    },
                    "totalEntries": { "type": "integer", "description": "Number of unbilled entries found." },
                    "totalMinutes": { "type": "integer", "description": "Sum of durationMinutes across all unbilled entries." },
                    "totalHours": { "type": "number", "description": "Total hours, rounded to two decimals." },
                    "byProject": {
                      "type": "array",
                      "description": "Per-project rollup of unbilled entries.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "projectId": { "type": "string", "description": "Project id." },
                          "entryCount": { "type": "integer", "description": "Entries in this project." },
                          "totalMinutes": { "type": "integer", "description": "Minutes for this project." },
                          "totalHours": { "type": "number", "description": "Hours for this project." }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/find-unbilled-hours)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      }
    },
    "/chase-unbilled-hours": {
      "post": {
        "operationId": "chase_unbilled_hours",
        "summary": "Draft (and optionally send) nudge emails for employees with unbilled time (orchestrator)",
        "description": "For every employee with > minHours of draft, billable time entries, asks Claude to draft a friendly reminder email and (when sendEmails is true and an email is supplied) sends it via Resend. Returns the drafts and send results so an agent can audit the run.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "minHours": {
                    "type": "number",
                    "description": "Skip employees with fewer than this many unbilled hours. Defaults to 1.",
                    "minimum": 0
                  },
                  "projectId": {
                    "type": "string",
                    "description": "Optional: limit the scan to a single project."
                  },
                  "employeeEmails": {
                    "type": "object",
                    "description": "Map of employeeId -> email address. Required when sendEmails=true.",
                    "additionalProperties": { "type": "string", "format": "email" }
                  },
                  "employeeNames": {
                    "type": "object",
                    "description": "Optional map of employeeId -> first name for the email greeting.",
                    "additionalProperties": { "type": "string" }
                  },
                  "sendEmails": {
                    "type": "boolean",
                    "description": "When true, sends the drafted email via Resend. When false, returns drafts only (default)."
                  },
                  "fromName": {
                    "type": "string",
                    "description": "Display name used in the email sign-off (e.g. 'Operations'). Defaults to 'Operations'."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Drafted nudges and send results, one per employee over the threshold.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "filter": {
                      "type": "object",
                      "description": "Echo of the filter applied.",
                      "properties": {
                        "projectId": { "type": ["string", "null"], "description": "Project filter, if any." },
                        "minHours": { "type": "number", "description": "Effective minHours threshold." }
                      }
                    },
                    "employeeCount": { "type": "integer", "description": "Employees over the threshold." },
                    "sendsAttempted": { "type": "boolean", "description": "True when sendEmails was true." },
                    "drafts": {
                      "type": "array",
                      "description": "Per-employee draft + send result, sorted by unbilled hours (desc).",
                      "items": {
                        "type": "object",
                        "properties": {
                          "employeeId": { "type": "string", "description": "Employee id." },
                          "email": { "type": ["string", "null"], "description": "Resolved email address (from employeeEmails)." },
                          "unbilledHours": { "type": "number", "description": "Total unbilled hours for this employee." },
                          "unbilledEntries": { "type": "integer", "description": "Number of draft entries." },
                          "byProject": {
                            "type": "array",
                            "description": "Per-project breakdown of unbilled hours.",
                            "items": {
                              "type": "object",
                              "properties": {
                                "projectId": { "type": "string" },
                                "hours": { "type": "number" }
                              }
                            }
                          },
                          "draft": {
                            "type": ["object", "null"],
                            "description": "The Claude-drafted nudge.",
                            "properties": {
                              "subject": { "type": "string", "description": "Email subject line." },
                              "text": { "type": "string", "description": "Plain-text body." },
                              "model": { "type": "string", "description": "Claude model used (or 'fallback')." }
                            }
                          },
                          "send": {
                            "type": ["object", "null"],
                            "description": "Send result (null when sendEmails was false).",
                            "properties": {
                              "sent": { "type": "boolean", "description": "Whether Resend accepted the email." },
                              "id": { "type": "string", "description": "Resend message id." },
                              "error": { "type": "string", "description": "Failure reason." }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/chase-unbilled-hours)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false }
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp_handler",
        "summary": "MCP server endpoint",
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "time-tracking",
              "version": "1.0.0",
              "operations": [
                { "file": "./config/routes.oas.json", "id": "list_time_entries" },
                { "file": "./config/routes.oas.json", "id": "get_time_entry" },
                { "file": "./config/routes.oas.json", "id": "create_time_entry" },
                { "file": "./config/routes.oas.json", "id": "update_time_entry" },
                { "file": "./config/routes.oas.json", "id": "delete_time_entry" },
                { "file": "./config/routes.oas.json", "id": "list_projects" },
                { "file": "./config/routes.oas.json", "id": "create_project" },
                { "file": "./config/routes.oas.json", "id": "list_timesheets" },
                { "file": "./config/routes.oas.json", "id": "submit_weekly_timesheet" },
                { "file": "./config/routes.oas.json", "id": "find_unbilled_hours" },
                { "file": "./config/routes.oas.json", "id": "chase_unbilled_hours" }
              ]
            }
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"],
            "outbound": ["prompt-injection-outbound", "secret-masking-outbound"]
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TimeEntry": {
        "type": "object",
        "description": "A single span of tracked work for an employee against a project.",
        "required": [
          "id",
          "tenantId",
          "employeeId",
          "projectId",
          "startTime",
          "endTime",
          "durationMinutes",
          "billable",
          "description",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant this entry belongs to. Set automatically from the API key." },
          "employeeId": { "type": "string", "description": "Employee who logged the time." },
          "projectId": { "type": "string", "description": "Project the time rolls up into." },
          "taskId": { "type": ["string", "null"], "description": "Optional sub-task within the project." },
          "startTime": { "type": "string", "format": "date-time", "description": "ISO-8601 start of the tracked span." },
          "endTime": { "type": "string", "format": "date-time", "description": "ISO-8601 end of the tracked span." },
          "durationMinutes": { "type": "integer", "description": "Duration in minutes. Computed if not supplied." },
          "billable": { "type": "boolean", "description": "Whether this time will be billed to the client." },
          "description": { "type": "string", "description": "Free-text description of the work." },
          "status": {
            "type": "string",
            "enum": ["draft", "submitted", "approved", "rejected"],
            "description": "Lifecycle state."
          },
          "timesheetId": { "type": ["string", "null"], "description": "Timesheet this entry has been rolled into, if any." },
          "createdAt": { "type": "string", "format": "date-time", "description": "ISO-8601 creation timestamp." }
        }
      },
      "TimeEntryCreate": {
        "type": "object",
        "description": "Payload to create a new time entry.",
        "required": ["employeeId", "projectId", "startTime", "endTime", "billable", "description"],
        "properties": {
          "employeeId": { "type": "string", "description": "Employee who logged the time." },
          "projectId": { "type": "string", "description": "Project the time rolls up into." },
          "taskId": { "type": "string", "description": "Optional sub-task." },
          "startTime": { "type": "string", "format": "date-time", "description": "ISO-8601 start of the span." },
          "endTime": { "type": "string", "format": "date-time", "description": "ISO-8601 end of the span." },
          "durationMinutes": { "type": "integer", "description": "Optional override; computed from startTime/endTime if omitted." },
          "billable": { "type": "boolean", "description": "Whether this time is billable to the client." },
          "description": { "type": "string", "description": "Free-text description of the work." }
        }
      },
      "TimeEntryUpdate": {
