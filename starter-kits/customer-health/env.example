# Pick a database provider. The kit boots with `in-memory` if unset.
# Options: in-memory | supabase | firestore | clickhouse | upstash-redis | neon
DB_PROVIDER=in-memory

# === Supabase (PostgREST) ===
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJh...
# SUPABASE_TABLE=items

# === Firestore (REST) ===
# FIREBASE_PROJECT=your-gcp-project-id
# FIRESTORE_COLLECTION=items
# FIREBASE_ACCESS_TOKEN=ya29....   # OAuth2 access token; refresh upstream

# === ClickHouse (HTTP) ===
# CLICKHOUSE_URL=https://xxxxx.clickhouse.cloud
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=...
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_TABLE=items

# === Upstash Redis (REST) ===
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# UPSTASH_KEY_PREFIX=items

# === Neon (HTTP serverless) ===
# NEON_HTTP_URL=https://xxxx.neon.tech/sql
# NEON_CONNECTION_STRING=postgresql://...
# NEON_TABLE=items

# === PostHog (usage signals + outbound capture) ===
# Used by predict_churn_risk to read a HogQL usage rollup, and by
# record_signal to mirror health events into PostHog.
# POSTHOG_HOST=https://us.i.posthog.com   # or https://eu.i.posthog.com
# POSTHOG_PROJECT_API_KEY=phc_xxx          # public project key — for /capture
# POSTHOG_PERSONAL_API_KEY=phx_xxx         # personal API key — for /query
# POSTHOG_PROJECT_ID=12345                 # numeric project id — for /query

# === Stripe (read-only revenue health) ===
# Used by predict_churn_risk when includeRevenueHealth=true. Use a
# RESTRICTED key with read-only scope on invoices + subscriptions.
# This kit never *writes* to Stripe.
# STRIPE_SECRET_KEY=rk_test_xxx

# === Claude (Anthropic) ===
# Powers the per-account churn classification + reasoning.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-7-20251022
# Optional: route through Zuplo's AI Gateway instead of api.anthropic.com.
# AI_GATEWAY_URL=https://your-gateway.zuplo.app
