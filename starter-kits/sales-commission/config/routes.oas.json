    "/explain-commission-amount": {
      "post": {
        "operationId": "explain_commission_amount",
        "summary": "Walk a payout's math and (optionally) generate a plain-English explanation",
        "description": "Returns the structured math behind a payout (per-credit breakdown, base sum, attainment, accelerator tier, recomputed commission) plus — unless generateExplanation=false — a Claude-generated paragraph explaining the number to the rep. The kit's 'AI angle': turns spaghetti comp plans into honest answers.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["payoutId"],
                "properties": {
                  "payoutId": { "type": "string", "description": "Payout id to explain." },
                  "generateExplanation": { "type": "boolean", "description": "Default true. Set to false to skip the Claude call and only return the structured math." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payout, plan, math breakdown, and optional explanation.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "payout": { "type": "object", "description": "The payout record." },
                    "plan": { "type": "object", "description": "The matching comp plan, or null if none found.", "nullable": true },
                    "math": {
                      "type": "object",
                      "description": "Structured breakdown: credits, base sum, attainment, accelerator tier, effective rate, and recomputed commission.",
                      "additionalProperties": true
                    },
                    "explanation": { "type": "string", "description": "Plain-English explanation generated by Claude. Omitted if generateExplanation=false or Claude is not configured." }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/explain-commission-amount)"
          },
          "policies": {
