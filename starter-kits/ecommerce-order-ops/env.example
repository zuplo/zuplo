# Pick a database provider. The kit boots with `in-memory` if unset.
# Options: in-memory | supabase | firestore | clickhouse | upstash-redis | neon
DB_PROVIDER=in-memory

# === Supabase (PostgREST) ===
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJh...
# SUPABASE_TABLE=items

# === Firestore (REST) ===
# FIREBASE_PROJECT=your-gcp-project-id
# FIRESTORE_COLLECTION=items
# FIREBASE_ACCESS_TOKEN=ya29....   # OAuth2 access token; refresh upstream

# === ClickHouse (HTTP) ===
# CLICKHOUSE_URL=https://xxxxx.clickhouse.cloud
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=...
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_TABLE=items

# === Upstash Redis (REST) ===
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# UPSTASH_KEY_PREFIX=items

# === Neon (HTTP serverless) ===
# NEON_HTTP_URL=https://xxxx.neon.tech/sql
# NEON_CONNECTION_STRING=postgresql://...
# NEON_TABLE=items

# === Stripe (payments webhook) ===
# Receive payment_intent.succeeded / charge.refunded events to flip
# orders to paid / returned. The storefront mints PaymentIntents with
# `metadata[order_id]` and `metadata[tenant_id]` for routing.
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# === ShipEngine (carrier rate shop + label purchase) ===
# Required for live rate shopping in `pick_carrier_for_destination`
# and for label purchase via `create_shipment` with a rateId.
# SHIPENGINE_API_KEY=TEST_xxxx
# SHIPENGINE_WEBHOOK_SECRET=long-random-string
# SHIPENGINE_CARRIER_IDS=se-1234,se-5678   # comma-separated carrier ids
# Origin warehouse used as ship_from when rate shopping.
# SHIPENGINE_FROM_NAME=Warehouse 1
# SHIPENGINE_FROM_ADDRESS1=1 Distribution Way
# SHIPENGINE_FROM_CITY=Reno
# SHIPENGINE_FROM_STATE=NV
# SHIPENGINE_FROM_POSTAL=89501
# SHIPENGINE_FROM_COUNTRY=US

# === Twilio (tracking SMS) ===
# Sends tracking links + delivery confirmations to buyers.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+15555550100

# Tenant id used by inbound webhooks (Stripe / ShipEngine don't carry an API key).
# DEFAULT_TENANT_ID=default
