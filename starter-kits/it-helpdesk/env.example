# Pick a database provider. The kit boots with `in-memory` if unset.
# Options: in-memory | supabase | firestore | clickhouse | upstash-redis | neon
DB_PROVIDER=in-memory

# === Supabase (PostgREST) ===
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJh...
# SUPABASE_TABLE=items

# === Firestore (REST) ===
# FIREBASE_PROJECT=your-gcp-project-id
# FIRESTORE_COLLECTION=items
# FIREBASE_ACCESS_TOKEN=ya29....   # OAuth2 access token; refresh upstream

# === ClickHouse (HTTP) ===
# CLICKHOUSE_URL=https://xxxxx.clickhouse.cloud
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=...
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_TABLE=items

# === Upstash Redis (REST) ===
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# UPSTASH_KEY_PREFIX=items

# === Neon (HTTP serverless) ===
# NEON_HTTP_URL=https://xxxx.neon.tech/sql
# NEON_CONNECTION_STRING=postgresql://...
# NEON_TABLE=items

# === Slack (assignment notifications) ===
# Bot token preferred — supports DMs by email lookup.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_DEFAULT_CHANNEL=#it-helpdesk
# Or: incoming webhook (channel-only fallback)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# === Anthropic (Claude — triage + KB ranking + draft answer) ===
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional: route through your AI gateway for spend tracking.
# AI_GATEWAY_URL=https://gateway.example.com/anthropic

# === Resend (requester updates: assignment + resolution) ===
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=helpdesk@example.com
