{
  "openapi": "3.1.0",
  "info": {
    "title": "Survey & Poll API",
    "version": "1.0.0",
    "description": "Headless survey, poll, and quiz API. Replaces SurveyMonkey, Polly, Slido. Surveys hold questions, responses hold answers, and orchestrator MCP tools cluster open-ended responses, compare cohorts, and propose follow-up questions."
  },
  "paths": {
    "/surveys": {
      "get": {
        "operationId": "list_surveys",
        "summary": "List surveys",
        "description": "Returns a paginated list of surveys/polls/quizzes in the current tenant ordered by createdAt descending.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Max surveys to return.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Page of surveys.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SurveyPage" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-surveys)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "create_survey",
        "summary": "Create a survey",
        "description": "Create a survey, poll, or quiz in `draft` status. Use `open_survey` to start collecting responses.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SurveyCreate" } } }
        },
        "responses": {
          "201": { "description": "The created survey.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Survey" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/create-survey)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/surveys/{id}": {
      "get": {
        "operationId": "get_survey",
        "summary": "Get a survey by id",
        "description": "Fetch a single survey from the current tenant.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Survey id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The survey.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Survey" } } } },
          "404": { "description": "Survey not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/get-survey)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/surveys/{id}/questions": {
      "get": {
        "operationId": "list_questions",
        "summary": "List questions on a survey",
        "description": "Returns questions for the given survey, ordered by displayOrder ascending.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Survey id.", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "description": "Max questions to return.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Page of questions.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QuestionPage" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-questions)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "add_question",
        "summary": "Add a question to a survey",
        "description": "Append a question to the given survey. The question kind controls the expected answer shape.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Survey id.", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QuestionCreate" } } }
        },
        "responses": {
          "201": { "description": "The created question.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Question" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/add-question)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/surveys/{id}/open": {
      "patch": {
        "operationId": "open_survey",
        "summary": "Open a survey for responses",
        "description": "Transition the survey from `draft` to `open` and stamp `openedAt`.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Survey id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The opened survey.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Survey" } } } },
          "404": { "description": "Survey not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/open-survey)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/surveys/{id}/close": {
      "patch": {
        "operationId": "close_survey",
        "summary": "Close a survey",
        "description": "Transition the survey to `closed`. New responses will be rejected by clients but historical data remains.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Survey id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The closed survey.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Survey" } } } },
          "404": { "description": "Survey not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/close-survey)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/surveys/{id}/responses": {
      "get": {
        "operationId": "list_responses",
        "summary": "List responses on a survey",
        "description": "Returns responses for the given survey ordered by submittedAt descending.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Survey id.", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "description": "Max responses to return.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Page of responses.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResponsePage" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-responses)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/responses": {
      "post": {
        "operationId": "submit_response",
        "summary": "Submit a response",
        "description": "Submit a response with answers. Anonymous responses do not store the email. Validate `surveyId` is `open` upstream — this kit does not enforce it.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResponseCreate" } } }
        },
        "responses": {
          "201": { "description": "The created response and its answers.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResponseWithAnswers" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/submit-response)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/responses/{id}": {
      "get": {
        "operationId": "get_response",
        "summary": "Get a response by id",
        "description": "Returns a response and its answers.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Response id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The response with answers.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResponseWithAnswers" } } } },
          "404": { "description": "Response not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/get-response)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/surveys/{id}/results": {
      "post": {
        "operationId": "summarize_results",
        "summary": "Summarize survey results",
        "description": "Returns response counts per question and answer-value distributions. For text questions, returns just the response count.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Survey id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Per-question summary.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Per-question breakdown.",
                  "properties": {
                    "surveyId": { "type": "string", "description": "Echo of the survey id." },
                    "responseTotal": { "type": "integer", "description": "Total response count." },
                    "questions": {
                      "type": "array",
                      "description": "Per-question results.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "questionId": { "type": "string", "description": "Question id." },
                          "prompt": { "type": "string", "description": "Question prompt." },
                          "kind": { "type": "string", "description": "Question kind." },
                          "responseCount": { "type": "integer", "description": "Number of responses to this question." },
                          "distribution": { "type": "object", "description": "Map of answer value to count.", "additionalProperties": { "type": "integer" } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/summarize-results)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/cluster-open-responses": {
      "post": {
        "operationId": "cluster_open_responses",
        "summary": "Cluster open-ended responses (orchestrator)",
        "description": "Orchestrator MCP tool. Pulls every text answer to one question, tokenizes (lowercased, stop-words removed), and returns the top theme keywords with sample comments. The LLM caller can rename or merge themes.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClusterQuery" } } }
        },
        "responses": {
          "200": {
            "description": "Theme summary.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Cluster result.",
                  "properties": {
                    "surveyId": { "type": "string", "description": "Echo of the survey id." },
                    "questionId": { "type": "string", "description": "Echo of the question id." },
                    "responseCount": { "type": "integer", "description": "Number of text answers analyzed." },
                    "themes": {
                      "type": "array",
                      "description": "Top theme keywords with sample comments.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "keyword": { "type": "string", "description": "Theme keyword." },
                          "count": { "type": "integer", "description": "How many responses included it." },
                          "samples": { "type": "array", "description": "Sample raw responses.", "items": { "type": "string" } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/cluster-open-responses)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/compare-cohorts": {
      "post": {
        "operationId": "compare_cohorts",
        "summary": "Compare answer distributions across two cohorts (orchestrator)",
        "description": "Orchestrator MCP tool. Returns answer distributions for two cohorts on the same question. Cohort membership is read from `Cohort.criteria.emails[]`.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CompareCohortsQuery" } } }
        },
        "responses": {
          "200": {
            "description": "Per-cohort distributions.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Compare-cohorts result.",
                  "properties": {
                    "surveyId": { "type": "string", "description": "Echo of the survey id." },
                    "questionId": { "type": "string", "description": "Echo of the question id." },
                    "cohortA": { "$ref": "#/components/schemas/CohortSlice" },
                    "cohortB": { "$ref": "#/components/schemas/CohortSlice" }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/compare-cohorts)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/propose-followup-question": {
      "post": {
        "operationId": "propose_followup_question",
        "summary": "Propose a follow-up question (orchestrator)",
        "description": "Orchestrator MCP tool. Given theme keywords, suggests a prompt for a follow-up question on the same survey. The LLM caller is expected to rewrite for tone.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FollowupQuery" } } }
        },
        "responses": {
          "200": {
            "description": "Suggested follow-up question.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Suggestion.",
                  "properties": {
                    "surveyId": { "type": "string", "description": "Echo of the survey id." },
                    "surveyTitle": { "type": "string", "description": "Title of the survey." },
                    "themes": { "type": "array", "description": "Echo of the theme keywords.", "items": { "type": "string" } },
                    "proposedQuestion": {
                      "type": "object",
                      "description": "Proposed question payload.",
                      "properties": {
                        "prompt": { "type": "string", "description": "Suggested prompt." },
                        "kind": { "type": "string", "description": "Suggested kind." },
                        "options": { "type": "array", "description": "Suggested options.", "items": { "type": "string" } }
                      }
                    },
                    "note": { "type": "string", "description": "Free-form note." }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/propose-followup-question)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/send-survey": {
      "post": {
        "operationId": "send_survey",
        "summary": "Send a survey to recipients (orchestrator)",
        "description": "Orchestrator MCP tool. Distributes a survey to a recipient list via email (Resend) or SMS (Twilio). Returns a per-recipient delivery report.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SendSurveyQuery" } } }
        },
        "responses": {
          "200": {
            "description": "Per-recipient delivery report.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Send survey result.",
                  "properties": {
                    "surveyId": { "type": "string", "description": "Echo of the survey id." },
                    "channel": { "type": "string", "enum": ["email", "sms"], "description": "Channel used." },
                    "attempted": { "type": "integer", "description": "Number of recipients attempted." },
                    "delivered": { "type": "integer", "description": "Number of successful sends." },
                    "failed": { "type": "integer", "description": "Number of failed sends." },
                    "reports": {
                      "type": "array",
                      "description": "Per-recipient delivery report.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "to": { "type": "string", "description": "Email or phone." },
                          "channel": { "type": "string" },
                          "ok": { "type": "boolean" },
                          "id": { "type": ["string", "null"], "description": "Provider message id when delivered." },
                          "error": { "type": ["string", "null"], "description": "Error message when failed." }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/send-survey)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/webhooks/resend": {
      "post": {
        "operationId": "resend_webhook",
        "summary": "Inbound Resend webhook",
        "description": "Receives Resend delivery events (email.delivered, email.bounced, email.complained). Verifies the Svix signature, parses the event, and currently logs it. Extend the handler to suspend bounced respondents or re-route detractor follow-ups.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "description": "Resend event payload — see https://resend.com/docs/dashboard/webhooks/event-types" } } }
        },
        "responses": {
          "200": {
            "description": "Acknowledged.",
            "content": {
              "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" } } } }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/resend-webhook)" },
          "policies": { "inbound": [] }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp_handler",
        "summary": "MCP server endpoint",
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "survey-poll-server",
              "version": "1.0.0",
              "operations": [
                { "file": "./config/routes.oas.json", "id": "list_surveys" },
                { "file": "./config/routes.oas.json", "id": "get_survey" },
                { "file": "./config/routes.oas.json", "id": "create_survey" },
                { "file": "./config/routes.oas.json", "id": "list_questions" },
                { "file": "./config/routes.oas.json", "id": "add_question" },
                { "file": "./config/routes.oas.json", "id": "open_survey" },
                { "file": "./config/routes.oas.json", "id": "close_survey" },
                { "file": "./config/routes.oas.json", "id": "list_responses" },
                { "file": "./config/routes.oas.json", "id": "submit_response" },
                { "file": "./config/routes.oas.json", "id": "get_response" },
                { "file": "./config/routes.oas.json", "id": "summarize_results" },
                { "file": "./config/routes.oas.json", "id": "cluster_open_responses" },
                { "file": "./config/routes.oas.json", "id": "compare_cohorts" },
                { "file": "./config/routes.oas.json", "id": "propose_followup_question" },
                { "file": "./config/routes.oas.json", "id": "send_survey" }
              ]
            }
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"],
            "outbound": ["prompt-injection-outbound", "secret-masking-outbound"]
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Survey": {
        "type": "object",
        "description": "A survey, poll, or quiz.",
        "required": ["id", "tenantId", "slug", "title", "description", "kind", "status", "openedAt", "closesAt", "anonymous", "audienceSlug", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique survey id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the survey belongs to." },
          "slug": { "type": "string", "description": "URL-safe slug." },
          "title": { "type": "string", "description": "Title shown to respondents." },
          "description": { "type": "string", "description": "Optional description shown to respondents." },
          "kind": { "type": "string", "enum": ["survey", "poll", "quiz"], "description": "What this survey is — drives UI affordances." },
          "status": { "type": "string", "enum": ["draft", "open", "closed"], "description": "Lifecycle state." },
          "openedAt": { "type": ["string", "null"], "format": "date-time", "description": "When the survey was opened." },
          "closesAt": { "type": ["string", "null"], "format": "date-time", "description": "Optional auto-close time." },
          "anonymous": { "type": "boolean", "description": "When true, responses do not store respondent emails." },
          "audienceSlug": { "type": ["string", "null"], "description": "Optional audience cohort slug to scope the survey." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Record creation time." }
        }
      },
      "SurveyCreate": {
        "type": "object",
        "description": "Payload to create a survey.",
        "required": ["slug", "title", "kind"],
        "properties": {
          "slug": { "type": "string", "description": "URL-safe slug." },
          "title": { "type": "string", "description": "Title." },
          "description": { "type": "string", "description": "Optional description." },
          "kind": { "type": "string", "enum": ["survey", "poll", "quiz"], "description": "Survey kind." },
          "anonymous": { "type": "boolean", "description": "Whether responses are anonymous. Defaults to false." },
          "closesAt": { "type": "string", "format": "date-time", "description": "Optional auto-close time." },
          "audienceSlug": { "type": "string", "description": "Optional audience cohort slug." }
        }
      },
      "SurveyPage": {
        "type": "object",
        "description": "A page of surveys.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Surveys on this page.", "items": { "$ref": "#/components/schemas/Survey" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor." }
        }
      },
      "Question": {
        "type": "object",
        "description": "A question on a survey.",
        "required": ["id", "tenantId", "surveyId", "prompt", "kind", "options", "required", "displayOrder", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique question id." },
          "tenantId": { "type": "string", "description": "Tenant id." },
          "surveyId": { "type": "string", "description": "Parent survey id." },
          "prompt": { "type": "string", "description": "Question text shown to respondents." },
          "kind": { "type": "string", "enum": ["single_choice", "multi_choice", "text", "rating", "nps"], "description": "Question kind." },
          "options": { "type": "array", "description": "Option values for choice kinds.", "items": { "type": "string" } },
          "required": { "type": "boolean", "description": "Whether the question must be answered." },
          "displayOrder": { "type": "integer", "description": "Sort order, ascending." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Record creation time." }
        }
      },
      "QuestionCreate": {
        "type": "object",
        "description": "Payload to add a question.",
        "required": ["prompt", "kind"],
        "properties": {
          "prompt": { "type": "string", "description": "Question text." },
          "kind": { "type": "string", "enum": ["single_choice", "multi_choice", "text", "rating", "nps"], "description": "Question kind." },
          "options": { "type": "array", "description": "Options for choice kinds.", "items": { "type": "string" } },
          "required": { "type": "boolean", "description": "Whether the answer is required." },
          "displayOrder": { "type": "integer", "description": "Sort order." }
        }
      },
      "QuestionPage": {
        "type": "object",
        "description": "A page of questions.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Questions on this page.", "items": { "$ref": "#/components/schemas/Question" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor." }
        }
      },
      "ResponseEntity": {
        "type": "object",
        "description": "A respondent's submission to a survey.",
        "required": ["id", "tenantId", "surveyId", "respondentEmail", "submittedAt", "anonymous", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique response id." },
          "tenantId": { "type": "string", "description": "Tenant id." },
          "surveyId": { "type": "string", "description": "Parent survey id." },
          "respondentEmail": { "type": ["string", "null"], "description": "Respondent's email, or null when anonymous." },
          "submittedAt": { "type": "string", "format": "date-time", "description": "Submission time." },
          "anonymous": { "type": "boolean", "description": "Whether the response is anonymous." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Record creation time." }
        }
      },
      "ResponseCreate": {
        "type": "object",
        "description": "Payload to submit a response. NPS scores 0–6 trigger a Slack detractor alert unless `silent: true`.",
        "required": ["surveyId", "answers"],
        "properties": {
          "surveyId": { "type": "string", "description": "Parent survey id." },
          "respondentEmail": { "type": "string", "format": "email", "description": "Respondent email (required unless anonymous)." },
          "anonymous": { "type": "boolean", "description": "Whether the response is anonymous." },
          "silent": { "type": "boolean", "description": "When true, suppress detractor Slack alert." },
          "answers": {
            "type": "array",
            "description": "Answers, one per question.",
            "items": {
              "type": "object",
              "required": ["questionId", "value"],
              "properties": {
                "questionId": { "type": "string", "description": "Question being answered." },
                "value": { "description": "Answer value — string, array of strings, number, etc., depending on question kind." }
              }
            }
          }
        }
      },
      "ResponsePage": {
        "type": "object",
        "description": "A page of responses.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Responses on this page.", "items": { "$ref": "#/components/schemas/ResponseEntity" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor." }
        }
      },
      "Answer": {
        "type": "object",
        "description": "One answer on a response.",
        "required": ["id", "tenantId", "responseId", "questionId", "value", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique answer id." },
          "tenantId": { "type": "string", "description": "Tenant id." },
          "responseId": { "type": "string", "description": "Parent response id." },
          "questionId": { "type": "string", "description": "Question being answered." },
          "value": { "description": "Answer value — shape depends on question kind." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Record creation time." }
        }
      },
      "ResponseWithAnswers": {
        "type": "object",
        "description": "A response with its answers.",
        "required": ["response", "answers"],
        "properties": {
          "response": { "$ref": "#/components/schemas/ResponseEntity" },
          "answers": { "type": "array", "description": "Answers on the response.", "items": { "$ref": "#/components/schemas/Answer" } }
        }
      },
      "ClusterQuery": {
        "type": "object",
        "description": "Input to cluster open-ended responses.",
        "required": ["surveyId", "questionId"],
        "properties": {
          "surveyId": { "type": "string", "description": "Survey id." },
          "questionId": { "type": "string", "description": "Question id (must be a text question)." },
          "topThemes": { "type": "integer", "description": "How many top themes to return. Defaults to 5.", "minimum": 1, "maximum": 20 },
          "samplesPerTheme": { "type": "integer", "description": "How many sample comments per theme. Defaults to 3.", "minimum": 1, "maximum": 10 },
          "useClaude": { "type": "boolean", "description": "When false, skip Claude and use the keyword-frequency fallback. Defaults to true." }
        }
      },
      "CompareCohortsQuery": {
        "type": "object",
        "description": "Input to compare two cohorts on a question.",
        "required": ["surveyId", "cohortSlugA", "cohortSlugB", "questionId"],
        "properties": {
          "surveyId": { "type": "string", "description": "Survey id." },
          "cohortSlugA": { "type": "string", "description": "Slug of the first cohort." },
          "cohortSlugB": { "type": "string", "description": "Slug of the second cohort." },
          "questionId": { "type": "string", "description": "Question id to compare on." }
        }
      },
      "CohortSlice": {
        "type": "object",
        "description": "Per-cohort answer distribution.",
        "required": ["slug", "responseCount", "distribution"],
        "properties": {
          "slug": { "type": "string", "description": "Cohort slug." },
          "responseCount": { "type": "integer", "description": "Responses contributed by this cohort." },
          "distribution": { "type": "object", "description": "Map of answer value to count.", "additionalProperties": { "type": "integer" } }
        }
      },
      "FollowupQuery": {
        "type": "object",
        "description": "Input to propose a follow-up question.",
        "required": ["surveyId", "themeKeywords"],
        "properties": {
          "surveyId": { "type": "string", "description": "Survey id." },
          "themeKeywords": { "type": "array", "description": "Theme keywords (e.g. from cluster_open_responses).", "items": { "type": "string" } },
          "kind": { "type": "string", "enum": ["single_choice", "multi_choice", "text", "rating", "nps"], "description": "Suggested kind for the follow-up. Defaults to 'text'." }
        }
      },
      "SendSurveyQuery": {
        "type": "object",
        "description": "Input to send_survey.",
        "required": ["surveyId", "channel", "recipients", "respondUrl"],
        "properties": {
          "surveyId": { "type": "string", "description": "Survey id (must be open)." },
          "channel": { "type": "string", "enum": ["email", "sms"], "description": "Delivery channel." },
          "recipients": {
            "type": "array",
            "description": "Recipient list. For email channel, set recipient.email; for sms, set recipient.phone.",
            "items": {
              "type": "object",
              "properties": {
                "email": { "type": "string", "description": "Recipient email address." },
                "phone": { "type": "string", "description": "Recipient phone number in e.164 format." },
                "name": { "type": "string", "description": "Optional first name for personalisation." }
              }
            }
          },
          "respondUrl": { "type": "string", "description": "Public URL to send the recipient. Supports {email}, {phone}, {name} placeholders." },
          "subject": { "type": "string", "description": "Override the email subject." },
          "bodyTemplate": { "type": "string", "description": "Override the message body. Supports {title}, {description}, {respondUrl}, {name}, {questionCount}." }
        }
      }
    }
  }
}
