# Pick a database provider. The kit boots with `in-memory` if unset.
# Options: in-memory | supabase | firestore | upstash-redis | neon
DB_PROVIDER=in-memory

# === Supabase (PostgREST) ===
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJh...
# SUPABASE_TICKETS_TABLE=tickets
# SUPABASE_CONVERSATIONS_TABLE=conversations
# SUPABASE_MACROS_TABLE=macros
# SUPABASE_SLAS_TABLE=slas
# SUPABASE_CUSTOMERS_TABLE=customers

# === Firestore (REST) ===
# FIREBASE_PROJECT=your-gcp-project-id
# FIREBASE_ACCESS_TOKEN=ya29....   # OAuth2 access token; refresh upstream
# FIRESTORE_TICKETS_COLLECTION=tickets
# FIRESTORE_CONVERSATIONS_COLLECTION=conversations
# FIRESTORE_MACROS_COLLECTION=macros
# FIRESTORE_SLAS_COLLECTION=slas
# FIRESTORE_CUSTOMERS_COLLECTION=customers

# === Upstash Redis (REST) ===
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# UPSTASH_TICKETS_PREFIX=tickets
# UPSTASH_CONVERSATIONS_PREFIX=conversations
# UPSTASH_MACROS_PREFIX=macros
# UPSTASH_SLAS_PREFIX=slas
# UPSTASH_CUSTOMERS_PREFIX=customers

# === Neon (HTTP serverless) ===
# NEON_HTTP_URL=https://xxxx.neon.tech/sql
# NEON_CONNECTION_STRING=postgresql://...
# NEON_TICKETS_TABLE=tickets
# NEON_CONVERSATIONS_TABLE=conversations
# NEON_MACROS_TABLE=macros
# NEON_SLAS_TABLE=slas
# NEON_CUSTOMERS_TABLE=customers

# === Postmark (inbound email parsing) ===
# Configure your inbound stream in Postmark to POST to /webhooks/postmark/inbound
# with HTTP Basic Auth using these credentials.
# POSTMARK_WEBHOOK_USERNAME=postmark
# POSTMARK_WEBHOOK_PASSWORD=replace-with-strong-secret
# Optional: outbound-via-Postmark fallback when Resend is unavailable.
# POSTMARK_SERVER_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# POSTMARK_FROM_EMAIL=support@example.com

# === Slack (assignment notifications) ===
# Either: bot token (preferred — supports DMs and threading)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_DEFAULT_CHANNEL=#support-triage
# Or: incoming webhook (channel-only fallback)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# === Anthropic (Claude — triage + draft replies) ===
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional: route through your AI gateway for spend tracking.
# AI_GATEWAY_URL=https://gateway.example.com/anthropic

# === Resend (outbound transactional email) ===
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=support@example.com
