# Pick a database provider. The kit boots with `in-memory` if unset.
# Options: in-memory | supabase | firestore | clickhouse | upstash-redis | neon
DB_PROVIDER=in-memory

# === Supabase (PostgREST) ===
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJh...
# SUPABASE_TABLE=items

# === Firestore (REST) ===
# FIREBASE_PROJECT=your-gcp-project-id
# FIRESTORE_COLLECTION=items
# FIREBASE_ACCESS_TOKEN=ya29....   # OAuth2 access token; refresh upstream

# === ClickHouse (HTTP) ===
# CLICKHOUSE_URL=https://xxxxx.clickhouse.cloud
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=...
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_TABLE=items

# === Upstash Redis (REST) ===
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# UPSTASH_KEY_PREFIX=items

# === Neon (HTTP serverless) ===
# NEON_HTTP_URL=https://xxxx.neon.tech/sql
# NEON_CONNECTION_STRING=postgresql://...
# NEON_TABLE=items

# === Stedi (270/271 eligibility) ===
# Real-time payer eligibility checks via Stedi Healthcare.
# STEDI_API_KEY=stedi_xxx
# STEDI_PROVIDER_NPI=1234567890
# STEDI_PROVIDER_ORG_NAME=Patient Intake Clinic

# === DocuSign (eSignature) ===
# Used to send HIPAA / treatment / telehealth consent forms.
# Token is short-lived; refresh upstream and write the latest value here.
# DOCUSIGN_ACCESS_TOKEN=eyJ...
# DOCUSIGN_ACCOUNT_ID=11111111-1111-1111-1111-111111111111
# DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
# DOCUSIGN_HMAC_KEY=connect-shared-secret  # configure on the Connect listener

# === Twilio Verify (intake OTP) ===
# Gate /intake/{id}/submit on a one-time SMS code so a stolen patient
# id alone can't submit a form.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tenant id used by inbound webhooks (DocuSign Connect doesn't carry an API key).
# DEFAULT_TENANT_ID=default
