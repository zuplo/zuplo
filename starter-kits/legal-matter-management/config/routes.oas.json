{
  "openapi": "3.1.0",
  "info": {
    "title": "Legal Matter Management API",
    "version": "1.0.0",
    "description": "Headless legal matter management. Replaces Clio, MyCase, and PracticePanther's core API. Manages clients, matters, documents, deadlines, time entries, and conflict checks, with orchestrator MCP tools for intake conflict screening, matter status summaries, and client status letters."
  },
  "paths": {
    "/clients": {
      "get": {
        "operationId": "list_clients",
        "summary": "List clients in the current tenant",
        "description": "Returns a paginated list of clients (individuals and organizations) the firm represents.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Max clients to return.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Page of clients.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClientPage" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-clients)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "create_client",
        "summary": "Create a client",
        "description": "Add a new client (individual or organization) to the firm's directory.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClientCreate" } } }
        },
        "responses": {
          "201": {
            "description": "The created client.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Client" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/create-client)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/clients/{id}": {
      "get": {
        "operationId": "get_client",
        "summary": "Get a client by id",
        "description": "Fetch a single client.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Client id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The client.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Client" } } }
          },
          "404": { "description": "Client not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/get-client)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/matters": {
      "get": {
        "operationId": "list_matters",
        "summary": "List matters in the current tenant",
        "description": "Returns a paginated list of matters newest-first.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Max matters to return.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Page of matters.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MatterPage" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-matters)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "open_matter",
        "summary": "Open a new matter",
        "description": "Open a new matter for an existing client. Defaults status to 'open' and stamps `openedAt`.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MatterCreate" } } }
        },
        "responses": {
          "201": {
            "description": "The opened matter.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Matter" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/open-matter)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/matters/{id}": {
      "get": {
        "operationId": "get_matter",
        "summary": "Get a matter by id",
        "description": "Fetch a single matter.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Matter id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The matter.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Matter" } } }
          },
          "404": { "description": "Matter not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/get-matter)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/matters/{id}/close": {
      "patch": {
        "operationId": "close_matter",
        "summary": "Close a matter",
        "description": "Move the matter to status 'closed' and stamp `closedAt`. Use this when the engagement ends.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Matter id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The closed matter.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Matter" } } }
          },
          "404": { "description": "Matter not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/close-matter)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/documents": {
      "get": {
        "operationId": "list_documents",
        "summary": "List matter documents",
        "description": "Returns paginated documents across matters in the tenant.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Max documents to return.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Page of documents.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MatterDocumentPage" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-documents)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "upload_document",
        "summary": "Attach a document to a matter",
        "description": "Records that a file (already stored in object storage) is attached to a matter. The `privileged` flag protects work product from non-attorney workflows.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MatterDocumentCreate" } } }
        },
        "responses": {
          "201": {
            "description": "The created document record.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MatterDocument" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/upload-document)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/deadlines": {
      "get": {
        "operationId": "list_deadlines",
        "summary": "List deadlines",
        "description": "Returns paginated deadlines ordered by due date ascending.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Max deadlines to return.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Page of deadlines.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeadlinePage" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-deadlines)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "add_deadline",
        "summary": "Add a deadline to a matter",
        "description": "Add a court / client / internal deadline. Status defaults to 'upcoming'.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeadlineCreate" } } }
        },
        "responses": {
          "201": {
            "description": "The created deadline.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Deadline" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/add-deadline)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/deadlines/{id}/complete": {
      "patch": {
        "operationId": "complete_deadline",
        "summary": "Mark a deadline as completed",
        "description": "Move the deadline status to 'completed'. Court rules typically require this action be auditable.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Deadline id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The updated deadline.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Deadline" } } }
          },
          "404": { "description": "Deadline not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/complete-deadline)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/time-entries": {
      "get": {
        "operationId": "list_time_entries",
        "summary": "List time entries",
        "description": "Returns paginated time entries newest-first. Use for billing and matter status reports.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Max time entries to return.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Page of time entries.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MatterTimeEntryPage" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-time-entries)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "log_time_entry",
        "summary": "Log a time entry",
        "description": "Record a billable or non-billable time entry against a matter.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MatterTimeEntryCreate" } } }
        },
        "responses": {
          "201": {
            "description": "The created time entry.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MatterTimeEntry" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/log-time-entry)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/conflicts": {
      "get": {
        "operationId": "list_conflicts",
        "summary": "List conflict-check records",
        "description": "Returns paginated conflict-check records.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Max records to return.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Page of conflict records.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConflictPage" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-conflicts)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "run_conflict_check",
        "summary": "Record a conflict-check decision",
        "description": "Persist the outcome of a conflict check on a candidate intake. For automated pre-flight scanning, use the `check_conflict_before_intake` orchestrator.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConflictCreate" } } }
        },
        "responses": {
          "201": {
            "description": "The conflict-check record.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Conflict" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/run-conflict-check)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/check-conflict-before-intake": {
      "post": {
        "operationId": "check_conflict_before_intake",
        "summary": "Scan existing clients and matters for conflicts (orchestrator)",
        "description": "Orchestrator MCP tool. Tokenises the prospect's name and scans existing client names, conflicts lists, and matter titles/descriptions for overlapping tokens. Returns flagged matches so an agent can summarize them for partner review.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["prospectName"],
                "properties": {
                  "prospectName": { "type": "string", "description": "Name (or party block) of the prospect to screen against the firm's data." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Conflict screening result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "prospectName": { "type": "string", "description": "Echo of the input." },
                    "hasFlags": { "type": "boolean", "description": "True if any clients or matters were flagged." },
                    "flaggedClients": {
                      "type": "array",
                      "description": "Clients with name or conflicts overlap.",
                      "items": { "$ref": "#/components/schemas/Client" }
                    },
                    "flaggedMatters": {
                      "type": "array",
                      "description": "Matters with title or description overlap.",
                      "items": { "$ref": "#/components/schemas/Matter" }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/check-conflict-before-intake)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/summarize-matter-status": {
      "post": {
        "operationId": "summarize_matter_status",
        "summary": "Summarize a matter's open work (orchestrator)",
        "description": "Orchestrator MCP tool. Returns the matter, open deadlines, recent documents, and recent time entries — the data an LLM needs to ground a status update.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["matterId"],
                "properties": {
                  "matterId": { "type": "string", "description": "Id of the matter to summarize." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Matter status summary.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "matter": { "$ref": "#/components/schemas/Matter" },
                    "openDeadlineCount": { "type": "integer", "description": "Number of upcoming deadlines." },
                    "openDeadlines": { "type": "array", "description": "Upcoming deadlines.", "items": { "$ref": "#/components/schemas/Deadline" } },
                    "recentDocuments": { "type": "array", "description": "Most recent documents (up to 10).", "items": { "$ref": "#/components/schemas/MatterDocument" } },
                    "recentTimeEntries": { "type": "array", "description": "Most recent time entries (up to 10).", "items": { "$ref": "#/components/schemas/MatterTimeEntry" } },
                    "recentBillableMinutes": { "type": "integer", "description": "Billable minutes summed across the recent entries." }
                  }
                }
              }
            }
          },
          "404": { "description": "Matter not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/summarize-matter-status)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/draft-status-letter-to-client": {
      "post": {
        "operationId": "draft_status_letter_to_client",
        "summary": "Draft a client status letter (orchestrator)",
        "description": "Orchestrator MCP tool. Builds a structured draft letter body to the client, summarising recent non-privileged documents, upcoming deadlines, and billable hours to date. The agent can then refine the prose.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["matterId"],
                "properties": {
                  "matterId": { "type": "string", "description": "Id of the matter to draft a letter for." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft client letter.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "matterId": { "type": "string", "description": "Echo of the matter id." },
                    "clientName": { "type": "string", "description": "Name of the client the letter is addressed to." },
                    "draftLetter": { "type": "string", "description": "Plain-text draft body of the status letter." },
                    "includedDocumentCount": { "type": "integer", "description": "Number of recent non-privileged documents included." },
                    "upcomingDeadlineCount": { "type": "integer", "description": "Number of upcoming deadlines included." }
                  }
                }
              }
            }
          },
          "404": { "description": "Matter or client not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/draft-status-letter-to-client)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp_handler",
        "summary": "MCP server endpoint",
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "legal-matter-management-server",
              "version": "1.0.0",
              "operations": [
                { "file": "./config/routes.oas.json", "id": "list_clients" },
                { "file": "./config/routes.oas.json", "id": "get_client" },
                { "file": "./config/routes.oas.json", "id": "create_client" },
                { "file": "./config/routes.oas.json", "id": "list_matters" },
                { "file": "./config/routes.oas.json", "id": "get_matter" },
                { "file": "./config/routes.oas.json", "id": "open_matter" },
                { "file": "./config/routes.oas.json", "id": "close_matter" },
                { "file": "./config/routes.oas.json", "id": "list_documents" },
                { "file": "./config/routes.oas.json", "id": "upload_document" },
                { "file": "./config/routes.oas.json", "id": "list_deadlines" },
                { "file": "./config/routes.oas.json", "id": "add_deadline" },
                { "file": "./config/routes.oas.json", "id": "complete_deadline" },
                { "file": "./config/routes.oas.json", "id": "list_time_entries" },
                { "file": "./config/routes.oas.json", "id": "log_time_entry" },
                { "file": "./config/routes.oas.json", "id": "list_conflicts" },
                { "file": "./config/routes.oas.json", "id": "run_conflict_check" },
                { "file": "./config/routes.oas.json", "id": "check_conflict_before_intake" },
                { "file": "./config/routes.oas.json", "id": "summarize_matter_status" },
                { "file": "./config/routes.oas.json", "id": "draft_status_letter_to_client" }
              ]
            }
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"],
            "outbound": ["prompt-injection-outbound", "secret-masking-outbound"]
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Client": {
        "type": "object",
        "description": "A client of the firm — individual or organization.",
        "required": ["id", "tenantId", "name", "kind", "email", "phone", "billingAddress", "conflicts", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique client id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant scope. Set automatically from the API key." },
          "name": { "type": "string", "description": "Full legal name (or organization name)." },
          "kind": { "type": "string", "enum": ["individual", "organization"], "description": "Whether this is a natural person or an entity." },
