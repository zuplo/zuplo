# Pick a database provider. The kit boots with `in-memory` if unset.
# Options: in-memory | supabase | firestore | clickhouse | upstash-redis | neon
DB_PROVIDER=in-memory

# === Supabase (PostgREST) ===
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJh...
# SUPABASE_TABLE=items

# === Firestore (REST) ===
# FIREBASE_PROJECT=your-gcp-project-id
# FIRESTORE_COLLECTION=items
# FIREBASE_ACCESS_TOKEN=ya29....   # OAuth2 access token; refresh upstream

# === ClickHouse (HTTP) ===
# CLICKHOUSE_URL=https://xxxxx.clickhouse.cloud
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=...
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_TABLE=items

# === Upstash Redis (REST) ===
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# UPSTASH_KEY_PREFIX=items

# === Neon (HTTP serverless) ===
# NEON_HTTP_URL=https://xxxx.neon.tech/sql
# NEON_CONNECTION_STRING=postgresql://...
# NEON_TABLE=items

# === DocuSign (contract execution via JWT grant) ===
# Create an Integration Key in the DocuSign Admin → Apps and Keys console.
# Generate an RSA key pair, upload the public key, and set the user/account
# IDs from the same console. Grant the impersonation consent once via the
# DocuSign consent URL before using.
# DOCUSIGN_INTEGRATION_KEY=00000000-0000-0000-0000-000000000000
# DOCUSIGN_USER_ID=00000000-0000-0000-0000-000000000000
# DOCUSIGN_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
# DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
# Demo (sandbox) defaults; use account.docusign.com + www.docusign.net/restapi for prod.
# DOCUSIGN_OAUTH_HOST=account-d.docusign.com
# DOCUSIGN_API_BASE_URI=https://demo.docusign.net/restapi

# === Slack (procurement notifications) ===
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_DEFAULT_CHANNEL=#procurement
# Or: incoming webhook (channel-only fallback)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
