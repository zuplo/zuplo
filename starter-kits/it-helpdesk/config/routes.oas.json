{
  "openapi": "3.1.0",
  "info": {
    "title": "IT Helpdesk API",
    "version": "1.0.0",
    "description": "Headless internal IT helpdesk and ticketing API. Replaces Zendesk Internal, Freshservice, and ServiceNow ITSM. CRUD for tickets, comments, and KB articles plus three orchestrator MCP tools (triage_ticket, suggest_kb_answer, escalate_breaching_sla)."
  },
  "paths": {
    "/tickets": {
      "get": {
        "operationId": "list_tickets",
        "summary": "List incident tickets",
        "description": "Returns a paginated list of incident tickets in the current tenant, newest first.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of tickets to return. Defaults to 50.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor from a previous response.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of tickets.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IncidentTicketPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-tickets)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      },
      "post": {
        "operationId": "create_ticket",
        "summary": "Create an incident ticket",
        "description": "Open a new incident ticket. The tenant comes from the authenticated API key; status defaults to 'new' and priority defaults to 'med'.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/IncidentTicketCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created ticket.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IncidentTicket" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/create-ticket)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false }
          }
        }
      }
    },
    "/tickets/{id}": {
      "get": {
        "operationId": "get_ticket",
        "summary": "Get a ticket by id",
        "description": "Fetch a single incident ticket from the current tenant.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Ticket id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The ticket.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IncidentTicket" }
              }
            }
          },
          "404": { "description": "Ticket not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/get-ticket)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      },
      "patch": {
        "operationId": "update_ticket",
        "summary": "Update fields on a ticket",
        "description": "Partial update to ticket fields like subject, body, category, priority, status, assignee, or tags.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Ticket id.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/IncidentTicketUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated ticket.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IncidentTicket" }
              }
            }
          },
          "404": { "description": "Ticket not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/update-ticket)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false, "idempotentHint": true }
          }
        }
      }
    },
    "/tickets/{id}/assign": {
      "post": {
        "operationId": "assign_ticket",
        "summary": "Assign a ticket to an agent",
        "description": "Set the assigneeEmail on a ticket and move its status to 'in_progress'.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Ticket id.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["assigneeEmail"],
                "properties": {
                  "assigneeEmail": { "type": "string", "description": "Email of the agent to assign." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated ticket.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IncidentTicket" }
              }
            }
          },
          "404": { "description": "Ticket not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/assign-ticket)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false }
          }
        }
      }
    },
    "/tickets/{id}/resolve": {
      "patch": {
        "operationId": "resolve_ticket",
        "summary": "Mark a ticket resolved",
        "description": "Move the ticket to status='resolved' and stamp resolvedAt with the current time.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Ticket id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The resolved ticket.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IncidentTicket" }
              }
            }
          },
          "404": { "description": "Ticket not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/resolve-ticket)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false, "idempotentHint": true }
          }
        }
      }
    },
    "/tickets/{id}/close": {
      "post": {
        "operationId": "close_ticket",
        "summary": "Close a ticket",
        "description": "Move the ticket to status='closed'. Closed tickets are immutable except via reopen_ticket.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Ticket id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The closed ticket.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IncidentTicket" }
              }
            }
          },
          "404": { "description": "Ticket not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/close-ticket)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false, "idempotentHint": true }
          }
        }
      }
    },
    "/tickets/{id}/reopen": {
      "post": {
        "operationId": "reopen_ticket",
        "summary": "Reopen a previously closed ticket",
        "description": "Move the ticket back to status='in_progress' and clear resolvedAt.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Ticket id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The reopened ticket.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IncidentTicket" }
              }
            }
          },
          "404": { "description": "Ticket not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/reopen-ticket)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false }
          }
        }
      }
    },
    "/comments": {
      "get": {
        "operationId": "list_comments",
        "summary": "List comments",
        "description": "List comments, optionally filtered by ticketId. Returns both public and internal comments.",
        "parameters": [
          {
            "name": "ticketId",
            "in": "query",
            "description": "If set, only return comments on this ticket.",
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of comments per page.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of comments.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CommentPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-comments)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      },
      "post": {
        "operationId": "add_comment",
        "summary": "Add a comment to a ticket",
        "description": "Append a comment to a ticket. Use kind='internal' for agent-only notes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CommentCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created comment.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Comment" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/add-comment)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false }
          }
        }
      }
    },
    "/kb-articles": {
      "get": {
        "operationId": "list_kb_articles",
        "summary": "List knowledge base articles",
        "description": "List KB articles in the tenant ordered by lastUpdatedAt desc.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of articles to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of KB articles.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/KBArticlePage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-kb-articles)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      },
      "post": {
        "operationId": "create_kb_article",
        "summary": "Create a knowledge base article",
        "description": "Add a new KB article to the tenant.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/KBArticleCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created KB article.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/KBArticle" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/create-kb-article)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false }
          }
        }
      }
    },
    "/kb-articles/search": {
      "get": {
        "operationId": "search_kb",
        "summary": "Search the knowledge base",
        "description": "Substring search over KB article titles, bodies, and tags. Use this to find articles relevant to a ticket subject.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search query string.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching articles.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/KBArticle" }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/search-kb)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      }
    },
    "/triage-ticket": {
      "post": {
        "operationId": "triage_ticket",
        "summary": "Suggest category, priority, and assignee for a ticket (orchestrator)",
        "description": "Reads a ticket via get_ticket, scores keywords against a category/priority dictionary, and looks up the default assignee for the suggested category. Returns suggestions only - apply via update_ticket / assign_ticket.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ticketId"],
                "properties": {
                  "ticketId": { "type": "string", "description": "Id of the ticket to triage." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Triage suggestion.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ticketId": { "type": "string" },
                    "suggestedCategory": { "type": "string" },
                    "suggestedPriority": { "type": "string" },
                    "suggestedAssignee": { "type": "string", "nullable": true },
                    "reasoning": { "type": "object" }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/triage-ticket)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      }
    },
    "/suggest-kb-answer": {
      "post": {
        "operationId": "suggest_kb_answer",
        "summary": "Find KB articles relevant to a ticket (orchestrator)",
        "description": "Reads a ticket, extracts keywords, calls search_kb for the top terms, ranks by match count, and returns the top suggestions. An agent can paste the most relevant article into a comment.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ticketId"],
                "properties": {
                  "ticketId": { "type": "string", "description": "Ticket id to find suggestions for." },
                  "topN": { "type": "integer", "minimum": 1, "maximum": 10, "description": "How many articles to return. Default 3." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked KB suggestions.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ticketId": { "type": "string" },
                    "queryTerms": { "type": "array", "items": { "type": "string" } },
                    "suggestions": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/KBArticle" }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/suggest-kb-answer)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      }
    },
    "/escalate-breaching-sla": {
      "post": {
        "operationId": "escalate_breaching_sla",
        "summary": "Find tickets approaching SLA breach (orchestrator)",
        "description": "Returns the list of open tickets whose slaBreachAt falls within the next minutesBefore minutes. Use the result to page on-call, escalate, or post to a war-room channel.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "minutesBefore": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1440,
                    "description": "How many minutes ahead to look. Defaults to 30."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tickets at risk.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "minutesBefore": { "type": "integer" },
                    "count": { "type": "integer" },
                    "tickets": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/IncidentTicket" }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/escalate-breaching-sla)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp_handler",
        "summary": "MCP server endpoint",
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "it-helpdesk-server",
              "version": "1.0.0",
              "operations": [
                { "file": "./config/routes.oas.json", "id": "list_tickets" },
                { "file": "./config/routes.oas.json", "id": "get_ticket" },
                { "file": "./config/routes.oas.json", "id": "create_ticket" },
                { "file": "./config/routes.oas.json", "id": "update_ticket" },
                { "file": "./config/routes.oas.json", "id": "assign_ticket" },
                { "file": "./config/routes.oas.json", "id": "resolve_ticket" },
                { "file": "./config/routes.oas.json", "id": "close_ticket" },
                { "file": "./config/routes.oas.json", "id": "reopen_ticket" },
                { "file": "./config/routes.oas.json", "id": "list_comments" },
                { "file": "./config/routes.oas.json", "id": "add_comment" },
                { "file": "./config/routes.oas.json", "id": "list_kb_articles" },
                { "file": "./config/routes.oas.json", "id": "create_kb_article" },
                { "file": "./config/routes.oas.json", "id": "search_kb" },
                { "file": "./config/routes.oas.json", "id": "triage_ticket" },
                { "file": "./config/routes.oas.json", "id": "suggest_kb_answer" },
                { "file": "./config/routes.oas.json", "id": "escalate_breaching_sla" }
              ]
            }
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"],
            "outbound": ["prompt-injection-outbound", "secret-masking-outbound"]
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IncidentTicket": {
        "type": "object",
        "description": "An IT helpdesk ticket raised by an employee.",
        "required": ["id", "tenantId", "requesterEmail", "subject", "body", "category", "priority", "status", "openedAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique ticket id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the ticket belongs to. Set from the API key." },
          "requesterEmail": { "type": "string", "description": "Email of the employee who opened the ticket." },
          "subject": { "type": "string", "description": "One-line subject." },
          "body": { "type": "string", "description": "Free-form description of the issue." },
          "category": {
            "type": "string",
            "enum": ["hardware", "software", "access", "network", "other"],
            "description": "What kind of issue this is."
          },
          "priority": {
            "type": "string",
            "enum": ["low", "med", "high", "critical"],
            "description": "Triage priority."
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "awaiting_user", "resolved", "closed"],
            "description": "Workflow state."
          },
          "assigneeEmail": {
            "type": "string",
            "nullable": true,
            "description": "Email of the agent currently assigned, or null if unassigned."
          },
          "slaBreachAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "When the SLA target deadline expires for this ticket."
          },
          "openedAt": { "type": "string", "format": "date-time", "description": "When the ticket was opened." },
          "resolvedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "When the ticket was resolved, or null."
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Free-form labels."
          }
        }
      },
      "IncidentTicketCreate": {
        "type": "object",
        "description": "Payload to open a new ticket.",
        "required": ["requesterEmail", "subject", "body"],
        "properties": {
          "requesterEmail": { "type": "string", "description": "Email of the employee opening the ticket." },
          "subject": { "type": "string", "description": "One-line subject." },
          "body": { "type": "string", "description": "Description of the issue." },
          "category": {
            "type": "string",
            "enum": ["hardware", "software", "access", "network", "other"],
            "description": "Optional category. Defaults to 'other'."
          },
          "priority": {
            "type": "string",
            "enum": ["low", "med", "high", "critical"],
            "description": "Optional priority. Defaults to 'med'."
          },
          "assigneeEmail": { "type": "string", "nullable": true, "description": "Optional agent to pre-assign." },
          "tags": { "type": "array", "items": { "type": "string" }, "description": "Optional tags." }
        }
      },
      "IncidentTicketUpdate": {
        "type": "object",
        "description": "Partial update payload.",
