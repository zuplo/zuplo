{
  "openapi": "3.1.0",
  "info": {
    "title": "SaaS Management API",
    "version": "1.0.0",
    "description": "Headless SaaS subscription, license, and seat management API. Replaces Zylo, Productiv, and Torii. Track apps, license assignments, usage, and upcoming renewals; orchestrators surface unused licenses, recommend seat reductions, and forecast renewal cost."
  },
  "paths": {
    "/apps": {
      "get": {
        "operationId": "list_apps",
        "summary": "List SaaS apps",
        "description": "List all SaaS apps the tenant subscribes to, alphabetically.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Max page size.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Page of apps.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SaaSAppPage" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-apps)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "register_app",
        "summary": "Register a new SaaS app",
        "description": "Add a SaaS app to the catalog. activeSeats starts at 0; populate via license assignments.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SaaSAppCreate" } } }
        },
        "responses": {
          "201": { "description": "The created app.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SaaSApp" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/register-app)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/apps/{id}": {
      "get": {
        "operationId": "get_app",
        "summary": "Get a SaaS app by id",
        "description": "Fetch a single SaaS app record.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "App id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The app.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SaaSApp" } } } },
          "404": { "description": "App not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/get-app)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "patch": {
        "operationId": "update_app",
        "summary": "Update an app",
        "description": "Patch app fields like name, owner, totalSeats, annualCostCents, renewalDate, status.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "App id.", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SaaSAppUpdate" } } }
        },
        "responses": {
          "200": { "description": "The updated app.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SaaSApp" } } } },
          "404": { "description": "App not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/update-app)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/licenses": {
      "get": {
        "operationId": "list_licenses",
        "summary": "List license assignments",
        "description": "List license assignments. Filter by `saasAppSlug` and/or `employeeEmail`.",
        "parameters": [
          { "name": "saasAppSlug", "in": "query", "description": "Filter by app slug.", "schema": { "type": "string" } },
          { "name": "employeeEmail", "in": "query", "description": "Filter by employee.", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "description": "Max page size.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Page of licenses.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LicensePage" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-licenses)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "assign_license",
        "summary": "Assign a license to an employee",
        "description": "Create a license record for an employee on a SaaS app.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LicenseAssign" } } }
        },
        "responses": {
          "201": { "description": "The created license.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/License" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/assign-license)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/licenses/{id}/revoke": {
      "post": {
        "operationId": "revoke_license",
        "summary": "Revoke a license (destructive)",
        "description": "Stamp removedAt on a license, freeing the seat. Destructive: revoking removes the user's access.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "License id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The revoked license.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/License" } } } },
          "404": { "description": "License not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/revoke-license)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "destructiveHint": true } }
        }
      }
    },
    "/usage": {
      "get": {
        "operationId": "list_usage",
        "summary": "List usage windows",
        "description": "List usage records, optionally filtered by saasAppSlug.",
        "parameters": [
          { "name": "saasAppSlug", "in": "query", "description": "Filter by app slug.", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "description": "Max page size.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Page of usage records.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UsagePage" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-usage)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "record_usage_window",
        "summary": "Record a usage window",
        "description": "Persist a usage window for an employee on a SaaS app (typically populated from SSO/IdP exports).",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UsageCreate" } } }
        },
        "responses": {
          "201": { "description": "The created usage record.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Usage" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/record-usage-window)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/renewals": {
      "get": {
        "operationId": "list_renewals",
        "summary": "List planned renewals",
        "description": "List renewal records ordered by dueDate.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Max page size.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Page of renewals.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RenewalPage" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-renewals)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "plan_renewal",
        "summary": "Plan a renewal action",
        "description": "Create a renewal plan for a SaaS app with planned action and seat counts.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RenewalCreate" } } }
        },
        "responses": {
          "201": { "description": "The created renewal.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Renewal" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/plan-renewal)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/find-unused-licenses": {
      "post": {
        "operationId": "find_unused_licenses",
        "summary": "Find licenses with no recent activity (orchestrator)",
        "description": "Returns active licenses whose lastActiveAt is older than `daysWithoutActivity` (or never active and assigned long ago). Use to reclaim wasted seats.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "daysWithoutActivity": { "type": "integer", "minimum": 1, "maximum": 365, "description": "Threshold in days. Default 30." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stale licenses.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "daysWithoutActivity": { "type": "integer" },
                    "count": { "type": "integer" },
                    "licenses": { "type": "array", "items": { "$ref": "#/components/schemas/License" } }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/find-unused-licenses)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/recommend-seat-reduction": {
      "post": {
        "operationId": "recommend_seat_reduction",
        "summary": "Recommend a seat reduction (orchestrator)",
        "description": "Counts active licenses for an app vs total seats and recommends a new seat count plus estimated annual savings.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["saasAppSlug"],
                "properties": {
                  "saasAppSlug": { "type": "string", "description": "App slug to analyze." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reduction recommendation.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "saasAppSlug": { "type": "string" },
                    "currentTotalSeats": { "type": "integer" },
                    "activeLicenses": { "type": "integer" },
                    "recommendedSeats": { "type": "integer" },
                    "seatsToRemove": { "type": "integer" },
                    "annualSavingsCents": { "type": "integer" }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/recommend-seat-reduction)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/forecast-renewal-cost": {
      "post": {
        "operationId": "forecast_renewal_cost",
        "summary": "Forecast cost of upcoming renewals (orchestrator)",
        "description": "Sums annualCostCents across SaaS apps whose renewalDate falls within `monthsAhead` months.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "monthsAhead": { "type": "integer", "minimum": 1, "maximum": 36, "description": "Forecast window in months. Default 12." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Forecast.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "monthsAhead": { "type": "integer" },
                    "count": { "type": "integer" },
                    "totalCents": { "type": "integer" },
                    "upcoming": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/forecast-renewal-cost)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp_handler",
        "summary": "MCP server endpoint",
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "saas-management-server",
              "version": "1.0.0",
              "operations": [
                { "file": "./config/routes.oas.json", "id": "list_apps" },
                { "file": "./config/routes.oas.json", "id": "get_app" },
                { "file": "./config/routes.oas.json", "id": "register_app" },
                { "file": "./config/routes.oas.json", "id": "update_app" },
                { "file": "./config/routes.oas.json", "id": "list_licenses" },
                { "file": "./config/routes.oas.json", "id": "assign_license" },
                { "file": "./config/routes.oas.json", "id": "revoke_license" },
                { "file": "./config/routes.oas.json", "id": "list_usage" },
                { "file": "./config/routes.oas.json", "id": "record_usage_window" },
                { "file": "./config/routes.oas.json", "id": "list_renewals" },
                { "file": "./config/routes.oas.json", "id": "plan_renewal" },
                { "file": "./config/routes.oas.json", "id": "find_unused_licenses" },
                { "file": "./config/routes.oas.json", "id": "recommend_seat_reduction" },
                { "file": "./config/routes.oas.json", "id": "forecast_renewal_cost" }
              ]
            }
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"],
            "outbound": ["prompt-injection-outbound", "secret-masking-outbound"]
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SaaSApp": {
        "type": "object",
        "description": "A SaaS application.",
        "required": ["id", "tenantId", "slug", "name", "vendor", "category", "owner", "totalSeats", "activeSeats", "annualCostCents", "renewalDate", "status"],
        "properties": {
          "id": { "type": "string", "description": "App id." },
          "tenantId": { "type": "string", "description": "Tenant id." },
          "slug": { "type": "string", "description": "Stable slug used for license/usage references." },
          "name": { "type": "string", "description": "Human-readable app name." },
          "vendor": { "type": "string", "description": "Vendor company." },
          "category": { "type": "string", "description": "Free-form category." },
          "owner": { "type": "string", "description": "Internal owner email." },
          "totalSeats": { "type": "integer", "description": "Number of seats provisioned." },
          "activeSeats": { "type": "integer", "description": "Number of seats currently in use." },
          "annualCostCents": { "type": "integer", "description": "Annual cost in cents." },
          "renewalDate": { "type": "string", "format": "date", "description": "Next renewal date." },
          "status": { "type": "string", "enum": ["active", "under_review", "churning"], "description": "App status." }
        }
      },
      "SaaSAppCreate": {
        "type": "object",
        "description": "Payload to register a SaaS app.",
        "required": ["slug", "name", "vendor", "category", "owner", "totalSeats", "annualCostCents", "renewalDate"],
        "properties": {
          "slug": { "type": "string", "description": "Stable slug." },
          "name": { "type": "string", "description": "Display name." },
          "vendor": { "type": "string", "description": "Vendor company." },
          "category": { "type": "string", "description": "Category." },
          "owner": { "type": "string", "description": "Owner email." },
          "totalSeats": { "type": "integer", "description": "Initial seat count." },
          "annualCostCents": { "type": "integer", "description": "Annual cost in cents." },
          "renewalDate": { "type": "string", "format": "date", "description": "Renewal date." },
          "status": { "type": "string", "enum": ["active", "under_review", "churning"], "description": "Status. Defaults active." }
        }
      },
      "SaaSAppUpdate": {
        "type": "object",
        "description": "Partial app update.",
        "properties": {
          "name": { "type": "string", "description": "Display name." },
          "vendor": { "type": "string", "description": "Vendor." },
          "category": { "type": "string", "description": "Category." },
          "owner": { "type": "string", "description": "Owner email." },
          "totalSeats": { "type": "integer", "description": "Seat count." },
          "annualCostCents": { "type": "integer", "description": "Annual cost." },
          "renewalDate": { "type": "string", "format": "date", "description": "Renewal." },
          "status": { "type": "string", "enum": ["active", "under_review", "churning"], "description": "Status." }
        }
      },
      "SaaSAppPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/SaaSApp" } },
          "nextCursor": { "type": "string", "nullable": true, "description": "Pagination cursor." }
        }
      },
      "License": {
        "type": "object",
        "description": "A license assignment.",
        "required": ["id", "tenantId", "saasAppSlug", "employeeEmail", "role", "assignedAt"],
        "properties": {
          "id": { "type": "string", "description": "License id." },
          "tenantId": { "type": "string", "description": "Tenant id." },
          "saasAppSlug": { "type": "string", "description": "App slug." },
          "employeeEmail": { "type": "string", "description": "Assignee email." },
          "role": { "type": "string", "description": "Role within the app." },
          "assignedAt": { "type": "string", "format": "date-time", "description": "Assignment timestamp." },
          "removedAt": { "type": "string", "format": "date-time", "nullable": true, "description": "Removal timestamp, or null." },
          "lastActiveAt": { "type": "string", "format": "date-time", "nullable": true, "description": "Last activity timestamp." }
        }
      },
      "LicenseAssign": {
        "type": "object",
        "description": "Payload to assign a license.",
        "required": ["saasAppSlug", "employeeEmail", "role"],
        "properties": {
          "saasAppSlug": { "type": "string", "description": "App slug." },
          "employeeEmail": { "type": "string", "description": "Assignee email." },
          "role": { "type": "string", "description": "Role within the app." }
        }
      },
      "LicensePage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/License" } },
          "nextCursor": { "type": "string", "nullable": true, "description": "Pagination cursor." }
        }
      },
      "Usage": {
        "type": "object",
        "description": "A usage window.",
        "required": ["id", "tenantId", "saasAppSlug", "employeeEmail", "periodStart", "periodEnd", "sessionCount", "lastSessionAt"],
        "properties": {
          "id": { "type": "string", "description": "Usage id." },
          "tenantId": { "type": "string", "description": "Tenant id." },
          "saasAppSlug": { "type": "string", "description": "App slug." },
          "employeeEmail": { "type": "string", "description": "Employee email." },
          "periodStart": { "type": "string", "format": "date-time", "description": "Period start." },
          "periodEnd": { "type": "string", "format": "date-time", "description": "Period end." },
          "sessionCount": { "type": "integer", "description": "Number of sessions in the window." },
          "lastSessionAt": { "type": "string", "format": "date-time", "description": "Last session in the window." }
        }
      },
      "UsageCreate": {
        "type": "object",
        "description": "Payload to record usage.",
        "required": ["saasAppSlug", "employeeEmail", "periodStart", "periodEnd", "sessionCount", "lastSessionAt"],
        "properties": {
          "saasAppSlug": { "type": "string", "description": "App slug." },
          "employeeEmail": { "type": "string", "description": "Employee email." },
          "periodStart": { "type": "string", "format": "date-time", "description": "Period start." },
          "periodEnd": { "type": "string", "format": "date-time", "description": "Period end." },
          "sessionCount": { "type": "integer", "description": "Number of sessions." },
          "lastSessionAt": { "type": "string", "format": "date-time", "description": "Last session." }
        }
      },
      "UsagePage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Usage" } },
          "nextCursor": { "type": "string", "nullable": true, "description": "Pagination cursor." }
        }
      },
      "Renewal": {
        "type": "object",
        "description": "A planned renewal.",
        "required": ["id", "tenantId", "saasAppSlug", "dueDate", "plannedAction", "currentSeats", "plannedSeats"],
        "properties": {
