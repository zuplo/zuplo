{
  "openapi": "3.1.0",
  "info": {
    "title": "Vendor & Contract Management API",
    "version": "1.0.0",
    "description": "Headless vendor relationship and contract management API. Replaces Vendr, Tropic, and Ironclad-lite. Manage contracts, vendors, renewals, risk assessments, and spend records, with three orchestrators for renewal flagging, pricing comparison, and spend rollups."
  },
  "paths": {
    "/contracts": {
      "get": {
        "operationId": "list_contracts",
        "summary": "List contracts",
        "description": "List all contracts in the tenant ordered by endDate ascending (closest expiry first).",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Max page size.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Page of contracts.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ContractPage" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-contracts)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "create_contract",
        "summary": "Create a contract",
        "description": "Add a new contract record. status defaults to 'draft'; promote to 'active' once signed.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ContractCreate" } } }
        },
        "responses": {
          "201": {
            "description": "The created contract.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Contract" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/create-contract)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/contracts/{id}": {
      "get": {
        "operationId": "get_contract",
        "summary": "Get a contract by id",
        "description": "Fetch a single contract by id from the current tenant.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Contract id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The contract.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Contract" } } } },
          "404": { "description": "Contract not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/get-contract)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "patch": {
        "operationId": "update_contract",
        "summary": "Update a contract",
        "description": "Partial update to fields like title, dates, value, status, owner.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Contract id.", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ContractUpdate" } } }
        },
        "responses": {
          "200": { "description": "The updated contract.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Contract" } } } },
          "404": { "description": "Contract not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/update-contract)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/contracts/{id}/terminate": {
      "post": {
        "operationId": "terminate_contract",
        "summary": "Terminate a contract (destructive)",
        "description": "Move a contract to status='terminated'. This is destructive in the legal sense - terminating ends the agreement.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Contract id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The terminated contract.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Contract" } } } },
          "404": { "description": "Contract not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/terminate-contract)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "destructiveHint": true } }
        }
      }
    },
    "/vendors": {
      "get": {
        "operationId": "list_vendors",
        "summary": "List vendors",
        "description": "List vendors in the tenant ordered alphabetically by name.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Max page size.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Page of vendors.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VendorPage" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-vendors)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "create_vendor",
        "summary": "Create a vendor",
        "description": "Register a new vendor. totalSpendCents starts at 0; populate via spend records.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VendorCreate" } } }
        },
        "responses": {
          "201": { "description": "The created vendor.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Vendor" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/create-vendor)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/vendors/{id}": {
      "get": {
        "operationId": "get_vendor",
        "summary": "Get a vendor by id",
        "description": "Fetch a single vendor record.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Vendor id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The vendor.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Vendor" } } } },
          "404": { "description": "Vendor not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/get-vendor)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/renewals": {
      "get": {
        "operationId": "list_renewals",
        "summary": "List scheduled renewals",
        "description": "List renewal action records in the tenant, ordered by dueDate ascending.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Max page size.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Page of renewals.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RenewalPage" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-renewals)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "schedule_renewal",
        "summary": "Schedule a renewal action",
        "description": "Create a renewal record for a contract. status starts at 'upcoming'.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RenewalCreate" } } }
        },
        "responses": {
          "201": { "description": "The created renewal.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Renewal" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/schedule-renewal)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/risk-assessments": {
      "get": {
        "operationId": "list_risk_assessments",
        "summary": "List risk assessments",
        "description": "List risk assessments. Optionally filter by vendorId.",
        "parameters": [
          { "name": "vendorId", "in": "query", "description": "Filter by vendor id.", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "description": "Max page size.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Page of assessments.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RiskAssessmentPage" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-risk-assessments)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "record_assessment",
        "summary": "Record a risk assessment",
        "description": "Persist a security/financial/compliance/data_privacy assessment for a vendor.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RiskAssessmentCreate" } } }
        },
        "responses": {
          "201": { "description": "The created assessment.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RiskAssessment" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/record-assessment)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/spend": {
      "get": {
        "operationId": "list_spend",
        "summary": "List spend records",
        "description": "List spend records, optionally filtered by vendorId.",
        "parameters": [
          { "name": "vendorId", "in": "query", "description": "Filter by vendor id.", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "description": "Max page size.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Page of spend records.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SpendRecordPage" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-spend)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/flag-upcoming-renewals": {
      "post": {
        "operationId": "flag_upcoming_renewals",
        "summary": "Flag contracts approaching renewal (orchestrator)",
        "description": "Returns active contracts whose endDate falls within `daysAhead` days, with notice-window flags. Use this to drive renewal action queues.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "daysAhead": { "type": "integer", "minimum": 1, "maximum": 365, "description": "Look-ahead window. Defaults to 90." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Flagged contracts.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "daysAhead": { "type": "integer" },
                    "count": { "type": "integer" },
                    "contracts": { "type": "array", "items": { "$ref": "#/components/schemas/Contract" } }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/flag-upcoming-renewals)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/compare-vendor-pricing": {
      "post": {
        "operationId": "compare_vendor_pricing",
        "summary": "Compare pricing for vendors in a category (orchestrator)",
        "description": "Lists all vendors in a category along with their active contract count and total annual spend. Useful for benchmarking.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["category"],
                "properties": {
                  "category": { "type": "string", "description": "Vendor category to compare." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Comparison rows sorted ascending by total spend.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "category": { "type": "string" },
                    "vendorCount": { "type": "integer" },
                    "comparison": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/compare-vendor-pricing)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/calc-total-spend": {
      "post": {
        "operationId": "calc_total_spend",
        "summary": "Sum spend across records (orchestrator)",
        "description": "Sums spend records, optionally filtered by vendorId and/or year. Returns the grand total and per-vendor breakdown.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "vendorId": { "type": "string", "description": "Optional vendor filter." },
                  "year": { "type": "integer", "description": "Optional calendar year filter." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sum and breakdown.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "vendorId": { "type": "string", "nullable": true },
                    "year": { "type": "integer", "nullable": true },
                    "recordCount": { "type": "integer" },
                    "totalCents": { "type": "integer" },
                    "byVendor": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/calc-total-spend)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp_handler",
        "summary": "MCP server endpoint",
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "vendor-contract-management-server",
              "version": "1.0.0",
              "operations": [
                { "file": "./config/routes.oas.json", "id": "list_contracts" },
                { "file": "./config/routes.oas.json", "id": "get_contract" },
                { "file": "./config/routes.oas.json", "id": "create_contract" },
                { "file": "./config/routes.oas.json", "id": "update_contract" },
                { "file": "./config/routes.oas.json", "id": "terminate_contract" },
                { "file": "./config/routes.oas.json", "id": "list_vendors" },
                { "file": "./config/routes.oas.json", "id": "get_vendor" },
                { "file": "./config/routes.oas.json", "id": "create_vendor" },
                { "file": "./config/routes.oas.json", "id": "list_renewals" },
                { "file": "./config/routes.oas.json", "id": "schedule_renewal" },
                { "file": "./config/routes.oas.json", "id": "list_risk_assessments" },
                { "file": "./config/routes.oas.json", "id": "record_assessment" },
                { "file": "./config/routes.oas.json", "id": "list_spend" },
                { "file": "./config/routes.oas.json", "id": "flag_upcoming_renewals" },
                { "file": "./config/routes.oas.json", "id": "compare_vendor_pricing" },
                { "file": "./config/routes.oas.json", "id": "calc_total_spend" }
              ]
            }
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"],
            "outbound": ["prompt-injection-outbound", "secret-masking-outbound"]
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Contract": {
        "type": "object",
        "description": "A vendor contract.",
        "required": ["id", "tenantId", "vendorId", "title", "kind", "startDate", "endDate", "autoRenews", "noticePeriodDays", "annualValueCents", "currency", "status", "owner"],
        "properties": {
          "id": { "type": "string", "description": "Contract id." },
          "tenantId": { "type": "string", "description": "Tenant id." },
          "vendorId": { "type": "string", "description": "Linked vendor id." },
          "title": { "type": "string", "description": "Contract title." },
          "kind": {
            "type": "string",
            "enum": ["subscription", "saas", "services", "nda", "msa", "sow"],
            "description": "Contract kind."
          },
          "startDate": { "type": "string", "format": "date", "description": "Effective start date." },
          "endDate": { "type": "string", "format": "date", "description": "Effective end date." },
          "autoRenews": { "type": "boolean", "description": "Whether the contract auto-renews unless cancelled." },
          "noticePeriodDays": { "type": "integer", "description": "Days of advance notice required to cancel." },
          "annualValueCents": { "type": "integer", "description": "Annualized value in cents." },
          "currency": { "type": "string", "description": "ISO currency code." },
          "status": {
            "type": "string",
            "enum": ["draft", "active", "expired", "terminated"],
            "description": "Lifecycle status."
          },
          "documentUrl": { "type": "string", "nullable": true, "description": "Optional URL of the signed PDF." },
          "owner": { "type": "string", "description": "Email of the internal owner." }
        }
      },
      "ContractCreate": {
        "type": "object",
        "description": "Payload to create a contract.",
        "required": ["vendorId", "title", "kind", "startDate", "endDate", "annualValueCents", "owner"],
        "properties": {
          "vendorId": { "type": "string", "description": "Vendor id." },
          "title": { "type": "string", "description": "Title." },
          "kind": { "type": "string", "enum": ["subscription", "saas", "services", "nda", "msa", "sow"], "description": "Kind." },
          "startDate": { "type": "string", "format": "date", "description": "Start." },
          "endDate": { "type": "string", "format": "date", "description": "End." },
          "autoRenews": { "type": "boolean", "description": "Auto-renew flag. Defaults false." },
          "noticePeriodDays": { "type": "integer", "description": "Notice days. Defaults 30." },
          "annualValueCents": { "type": "integer", "description": "Annual value in cents." },
          "currency": { "type": "string", "description": "Currency. Defaults USD." },
          "status": { "type": "string", "enum": ["draft", "active", "expired", "terminated"], "description": "Status. Defaults draft." },
          "documentUrl": { "type": "string", "nullable": true, "description": "Signed PDF URL." },
          "owner": { "type": "string", "description": "Owner email." }
        }
      },
      "ContractUpdate": {
        "type": "object",
        "description": "Partial update payload.",
        "properties": {
          "title": { "type": "string", "description": "Updated title." },
          "kind": { "type": "string", "enum": ["subscription", "saas", "services", "nda", "msa", "sow"], "description": "Kind." },
          "startDate": { "type": "string", "format": "date", "description": "Start." },
          "endDate": { "type": "string", "format": "date", "description": "End." },
          "autoRenews": { "type": "boolean", "description": "Auto-renew flag." },
          "noticePeriodDays": { "type": "integer", "description": "Notice days." },
          "annualValueCents": { "type": "integer", "description": "Annual value in cents." },
          "currency": { "type": "string", "description": "Currency." },
          "status": { "type": "string", "enum": ["draft", "active", "expired", "terminated"], "description": "Status." },
          "documentUrl": { "type": "string", "nullable": true, "description": "Signed PDF URL." },
          "owner": { "type": "string", "description": "Owner email." }
        }
      },
      "ContractPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Contract" } },
          "nextCursor": { "type": "string", "nullable": true, "description": "Pagination cursor." }
        }
      },
      "Vendor": {
        "type": "object",
        "description": "A vendor.",
        "required": ["id", "tenantId", "name", "contactEmail", "category", "totalSpendCents", "status"],
        "properties": {
          "id": { "type": "string", "description": "Vendor id." },
          "tenantId": { "type": "string", "description": "Tenant id." },
          "name": { "type": "string", "description": "Vendor name." },
          "contactEmail": { "type": "string", "description": "Contact email." },
          "website": { "type": "string", "nullable": true, "description": "Website." },
          "category": { "type": "string", "description": "Free-form category (e.g. 'observability', 'productivity')." },
          "totalSpendCents": { "type": "integer", "description": "Cumulative spend across all records." },
