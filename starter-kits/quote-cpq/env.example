# Pick a database provider. The kit boots with `in-memory` if unset.
# Options: in-memory | supabase | firestore | clickhouse | upstash-redis | neon
DB_PROVIDER=in-memory

# === Supabase (PostgREST) ===
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJh...
# SUPABASE_TABLE=items

# === Firestore (REST) ===
# FIREBASE_PROJECT=your-gcp-project-id
# FIRESTORE_COLLECTION=items
# FIREBASE_ACCESS_TOKEN=ya29....   # OAuth2 access token; refresh upstream

# === ClickHouse (HTTP) ===
# CLICKHOUSE_URL=https://xxxxx.clickhouse.cloud
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=...
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_TABLE=items

# === Upstash Redis (REST) ===
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# UPSTASH_KEY_PREFIX=items

# === Neon (HTTP serverless) ===
# NEON_HTTP_URL=https://xxxx.neon.tech/sql
# NEON_CONNECTION_STRING=postgresql://...
# NEON_TABLE=items

# === DocuSign (eSignature) ===
# Used by send_quote when a PDF is supplied. Configure DocuSign Connect to
# POST envelope events to https://<your-gateway>/webhooks/docusign.
# DOCUSIGN_BASE_URL=https://demo.docusign.net
# DOCUSIGN_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
# DOCUSIGN_ACCESS_TOKEN=ey...               # JWT-issued bearer; refresh upstream
# DOCUSIGN_WEBHOOK_HMAC_KEY=secret-from-Connect-config
# DOCUSIGN_TENANT_ID=default                # Tenant the webhook applies to

# === Stripe (invoicing) ===
# Used by accept_quote to invoice the customer. STRIPE_WEBHOOK_SIGNING_SECRET
# is consumed by /webhooks/stripe.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SIGNING_SECRET=whsec_xxx

# === Resend (transactional email) ===
# Used by send_quote (email mode) and accept_quote (post-invoice email).
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=quotes@yourdomain.com
