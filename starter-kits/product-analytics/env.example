# Pick a database provider. ClickHouse is recommended for production event
# storage; the kit boots with `in-memory` if unset.
# Options: in-memory | clickhouse | supabase | neon
DB_PROVIDER=in-memory

# === ClickHouse (HTTP) — recommended for events ===
# CLICKHOUSE_URL=https://xxxxx.clickhouse.cloud
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=...
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_EVENTS_TABLE=events
# CLICKHOUSE_USERS_TABLE=users
# CLICKHOUSE_SESSIONS_TABLE=sessions
# CLICKHOUSE_FUNNELS_TABLE=funnels
# CLICKHOUSE_COHORTS_TABLE=cohorts

# === Supabase (PostgREST) ===
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJh...
# SUPABASE_EVENTS_TABLE=events
# SUPABASE_USERS_TABLE=users
# SUPABASE_SESSIONS_TABLE=sessions
# SUPABASE_FUNNELS_TABLE=funnels
# SUPABASE_COHORTS_TABLE=cohorts

# === Neon (HTTP serverless) ===
# NEON_HTTP_URL=https://xxxx.neon.tech/sql
# NEON_CONNECTION_STRING=postgresql://...
# NEON_EVENTS_TABLE=events
# NEON_USERS_TABLE=users
# NEON_SESSIONS_TABLE=sessions
# NEON_FUNNELS_TABLE=funnels
# NEON_COHORTS_TABLE=cohorts

# === PostHog (event mirror + HogQL discovery) ===
# When set, every ingested event is also POSTed to PostHog /capture so
# existing PostHog dashboards / cohorts / experiments keep working.
# define_funnel_from_question can also discover candidate events via HogQL.
# POSTHOG_API_HOST=https://us.i.posthog.com    # or https://eu.i.posthog.com
# POSTHOG_API_KEY=phc_xxx                      # project key (used by /capture)
# POSTHOG_PERSONAL_API_KEY=phx_xxx             # personal key (required for /api/projects/.../query)
# POSTHOG_PROJECT_ID=12345                     # required for /query
