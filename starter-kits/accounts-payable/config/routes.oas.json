{
  "openapi": "3.1.0",
  "info": {
    "title": "Accounts Payable / Bill Pay API",
    "version": "1.0.0",
    "description": "Headless AP and bill-pay API. Replaces Bill.com, Melio, Tipalti. Manages bills, vendors, approvals, and scheduled payments, with orchestrator MCP tools that detect duplicates, age payables, and match bills to POs."
  },
  "paths": {
    "/bills": {
      "get": {
        "operationId": "list_bills",
        "summary": "List bills in the current tenant",
        "description": "Returns a paginated list of bills, ordered by `dueDate` ascending.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Max bills to return.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Page of bills.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BillPage" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-bills)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "create_bill",
        "summary": "Create a draft bill",
        "description": "Create a new bill in `draft` status. Use `route_for_approval` to send it for approval.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BillCreate" } } }
        },
        "responses": {
          "201": { "description": "The created bill.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bill" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/create-bill)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/bills/{id}": {
      "get": {
        "operationId": "get_bill",
        "summary": "Get a bill by id",
        "description": "Fetch a single bill from the current tenant.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Bill id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The bill.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bill" } } } },
          "404": { "description": "Bill not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/get-bill)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/bills/{id}/route-for-approval": {
      "patch": {
        "operationId": "route_for_approval",
        "summary": "Route a bill for approval",
        "description": "Move a draft bill to `pending_approval`. Optionally records the approver email.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Bill id.", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": false,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RouteForApprovalBody" } } }
        },
        "responses": {
          "200": { "description": "The routed bill.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bill" } } } },
          "404": { "description": "Bill not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/route-for-approval)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/bills/{id}/approve": {
      "patch": {
        "operationId": "approve_bill",
        "summary": "Approve a bill",
        "description": "Record an approval and move the bill to `approved`. Writes a BillApproval audit row.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Bill id.", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApproveBillBody" } } }
        },
        "responses": {
          "200": { "description": "The approved bill.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bill" } } } },
          "404": { "description": "Bill not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/approve-bill)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/bills/{id}/reject": {
      "patch": {
        "operationId": "reject_bill",
        "summary": "Reject a bill",
        "description": "Record a rejection and void the bill. Writes a BillApproval audit row. Destructive — the bill cannot be paid afterwards.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Bill id.", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RejectBillBody" } } }
        },
        "responses": {
          "200": { "description": "The voided bill.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bill" } } } },
          "404": { "description": "Bill not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/reject-bill)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "destructiveHint": true } }
        }
      }
    },
    "/bill-payments": {
      "get": {
        "operationId": "list_bill_payments",
        "summary": "List bill payments",
        "description": "Returns scheduled and completed bill payments. Used by reconcile_with_bank.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Max payments to return.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Page of bill payments.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BillPaymentPage" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-bill-payments)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "schedule_payment",
        "summary": "Schedule a payment for a bill",
        "description": "Schedule a future payment for an approved bill. With `executeNow=true` and a Stripe-connected vendor, the gateway pushes a Stripe Transfer immediately and the webhook handles confirmation.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BillPaymentCreate" } } }
        },
        "responses": {
          "201": { "description": "The scheduled payment.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BillPayment" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/schedule-payment)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/vendors": {
      "get": {
        "operationId": "list_vendors",
        "summary": "List vendors",
        "description": "Return the vendors that bill the tenant.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Max vendors to return.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Page of vendors.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VendorPage" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-vendors)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "create_vendor",
        "summary": "Create a vendor",
        "description": "Create a new vendor record.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VendorCreate" } } }
        },
        "responses": {
          "201": { "description": "The created vendor.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Vendor" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/create-vendor)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/detect-duplicate-bills": {
      "post": {
        "operationId": "detect_duplicate_bills",
        "summary": "Detect duplicate bills (orchestrator)",
        "description": "Orchestrator MCP tool. Finds clusters of bills with the same vendor + amount + dueDate within a 7-day window. Optional `vendorId` restricts the search.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "vendorId": { "type": "string", "description": "Optional vendor id to scope the search." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Duplicate clusters.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "duplicateGroupCount": { "type": "integer", "description": "Number of duplicate clusters found." },
                    "duplicateBillCount": { "type": "integer", "description": "Total bills involved in duplicates." },
                    "groups": {
                      "type": "array",
                      "description": "Each entry is a cluster of duplicate-suspect bills.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "vendorId": { "type": "string", "description": "Vendor id common to the cluster." },
                          "amountCents": { "type": "integer", "description": "Amount common to the cluster, in cents." },
                          "bills": { "type": "array", "description": "The bills in the cluster.", "items": { "$ref": "#/components/schemas/Bill" } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/detect-duplicate-bills)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/summarize-payable-aging": {
      "post": {
        "operationId": "summarize_payable_aging",
        "summary": "Summarize payable aging by bucket (orchestrator)",
        "description": "Orchestrator MCP tool. Buckets unpaid bills (status approved or pending_approval) into 0-30/31-60/61-90/90+ days past due based on `asOf` (defaults to today).",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "asOf": { "type": "string", "format": "date-time", "description": "Cutoff date for aging. Defaults to now." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AP aging summary.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "asOf": { "type": "string", "description": "The asOf timestamp." },
                    "buckets": {
                      "type": "object",
                      "description": "Counts and totals per aging bucket.",
                      "properties": {
                        "0-30": { "$ref": "#/components/schemas/AgingBucket" },
                        "31-60": { "$ref": "#/components/schemas/AgingBucket" },
                        "61-90": { "$ref": "#/components/schemas/AgingBucket" },
                        "90+": { "$ref": "#/components/schemas/AgingBucket" }
                      }
                    },
                    "grandTotalCents": { "type": "integer", "description": "Sum across all buckets in cents." }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/summarize-payable-aging)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/match-bill-to-po": {
      "post": {
        "operationId": "match_bill_to_po",
        "summary": "Suggest PO matches for a bill (orchestrator)",
        "description": "Orchestrator MCP tool. For a given bill, finds candidate POs (other bills for the same vendor with a non-null poNumber and status=draft) whose amounts match within ±5%. Returns sorted candidates so the LLM can ask for human approval before reconciling.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["billId"],
                "properties": {
                  "billId": { "type": "string", "description": "Id of the bill to match." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PO match candidates.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "bill": { "$ref": "#/components/schemas/Bill" },
                    "candidateCount": { "type": "integer", "description": "Number of candidates." },
                    "candidates": {
                      "type": "array",
                      "description": "Candidate POs sorted by closeness of amount.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "bill": { "$ref": "#/components/schemas/Bill" },
                          "amountDiffCents": { "type": "integer", "description": "Absolute difference in cents." },
                          "amountDiffRatio": { "type": "number", "description": "Difference as a fraction of the target amount." }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": { "description": "Bill not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/match-bill-to-po)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/parse-bill": {
      "post": {
        "operationId": "parse_bill",
        "summary": "Parse a vendor bill PDF via Mindee OCR (orchestrator)",
        "description": "Takes a publicly-reachable bill URL, runs Mindee OCR, and returns normalized fields the LLM can drop into create_bill.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["attachmentUrl"],
                "properties": {
                  "attachmentUrl": { "type": "string", "format": "uri", "description": "URL to the bill (PDF, PNG, JPG)." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Normalized OCR result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "vendor": { "type": ["string", "null"], "description": "Detected vendor/supplier name." },
                    "amountCents": { "type": ["integer", "null"], "description": "Total amount in cents." },
                    "currency": { "type": ["string", "null"], "description": "ISO currency code." },
                    "date": { "type": ["string", "null"], "description": "Detected bill date (YYYY-MM-DD)." },
                    "billNumber": { "type": ["string", "null"], "description": "Detected bill/receipt number." },
                    "category": { "type": ["string", "null"], "description": "Detected category." },
                    "confidence": { "type": "number", "description": "Min confidence across load-bearing fields (0..1)." },
                    "ready": { "type": "boolean", "description": "True if vendor + amount + date parsed and confidence > 0.5." }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/parse-bill)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/reconcile-with-bank": {
      "post": {
        "operationId": "reconcile_with_bank",
        "summary": "Reconcile bank transactions to scheduled payments via Plaid (orchestrator)",
        "description": "Pulls Plaid transactions for the configured bank account and matches each against scheduled BillPayments by amount + date. Returns the proposed matches plus unmatched transactions for human review.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "startDate": { "type": "string", "format": "date", "description": "Window start. Defaults to 30 days ago." },
                  "endDate": { "type": "string", "format": "date", "description": "Window end. Defaults to today." },
                  "amountToleranceCents": { "type": "integer", "description": "Max delta in cents to consider a match. Default 0 (exact)." },
                  "dayWindow": { "type": "integer", "description": "Max day delta between scheduledFor and txn date. Default 3." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Match results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "window": { "type": "object", "properties": { "startDate": { "type": "string" }, "endDate": { "type": "string" } } },
                    "txnCount": { "type": "integer" },
                    "matchCount": { "type": "integer" },
                    "unmatchedTxnCount": { "type": "integer" },
                    "matches": { "type": "array", "items": { "type": "object" } },
                    "unmatchedTxns": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/reconcile-with-bank)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/webhooks/stripe": {
      "post": {
        "operationId": "stripe_webhook",
        "summary": "Stripe webhook receiver",
        "description": "Inbound webhook for Stripe Transfer / Payout events. Verifies the Stripe-Signature header and reconciles BillPayment + Bill state on transfer.paid / payout.paid / transfer.reversed / payout.failed.",
        "responses": {
          "200": { "description": "Event processed (or ignored)." },
          "400": { "description": "Missing or invalid signature." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/webhooks/stripe)" },
          "policies": { "inbound": [] }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp_handler",
        "summary": "MCP server endpoint",
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "accounts-payable-server",
              "version": "1.0.0",
              "operations": [
                { "file": "./config/routes.oas.json", "id": "list_bills" },
                { "file": "./config/routes.oas.json", "id": "get_bill" },
                { "file": "./config/routes.oas.json", "id": "create_bill" },
                { "file": "./config/routes.oas.json", "id": "route_for_approval" },
                { "file": "./config/routes.oas.json", "id": "approve_bill" },
                { "file": "./config/routes.oas.json", "id": "reject_bill" },
                { "file": "./config/routes.oas.json", "id": "list_bill_payments" },
                { "file": "./config/routes.oas.json", "id": "schedule_payment" },
                { "file": "./config/routes.oas.json", "id": "list_vendors" },
                { "file": "./config/routes.oas.json", "id": "create_vendor" },
                { "file": "./config/routes.oas.json", "id": "detect_duplicate_bills" },
                { "file": "./config/routes.oas.json", "id": "summarize_payable_aging" },
                { "file": "./config/routes.oas.json", "id": "match_bill_to_po" },
                { "file": "./config/routes.oas.json", "id": "parse_bill" },
                { "file": "./config/routes.oas.json", "id": "reconcile_with_bank" }
              ]
            }
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"],
            "outbound": ["prompt-injection-outbound", "secret-masking-outbound"]
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Bill": {
        "type": "object",
        "description": "A bill payable to a vendor.",
        "required": ["id", "tenantId", "vendorId", "billNumber", "amountCents", "currency", "dueDate", "status", "glCode", "poNumber", "attachmentUrl", "approverEmail", "approvedAt", "paidAt", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique bill id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the bill belongs to. Set automatically from the API key." },
          "vendorId": { "type": "string", "description": "Vendor that issued the bill." },
          "billNumber": { "type": "string", "description": "Vendor-supplied bill number." },
          "amountCents": { "type": "integer", "description": "Amount due in cents." },
          "currency": { "type": "string", "description": "ISO 4217 currency code." },
          "dueDate": { "type": "string", "format": "date", "description": "Date the bill is due." },
          "status": { "type": "string", "enum": ["draft", "pending_approval", "approved", "paid", "void"], "description": "Lifecycle state." },
          "glCode": { "type": "string", "description": "General-ledger account code." },
          "poNumber": { "type": ["string", "null"], "description": "Optional purchase-order number." },
          "attachmentUrl": { "type": ["string", "null"], "description": "URL to a scanned bill image or PDF." },
          "approverEmail": { "type": ["string", "null"], "description": "Email of the assigned approver." },
          "approvedAt": { "type": ["string", "null"], "format": "date-time", "description": "When the bill was approved, or null." },
          "paidAt": { "type": ["string", "null"], "format": "date-time", "description": "When the bill was paid, or null." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Record creation time." }
        }
      },
      "BillCreate": {
        "type": "object",
        "description": "Payload to create a draft bill.",
        "required": ["vendorId", "billNumber", "amountCents", "currency", "dueDate", "glCode"],
        "properties": {
          "vendorId": { "type": "string", "description": "Vendor that issued the bill." },
          "billNumber": { "type": "string", "description": "Vendor-supplied bill number." },
          "amountCents": { "type": "integer", "description": "Amount due in cents." },
          "currency": { "type": "string", "description": "ISO 4217 currency code." },
          "dueDate": { "type": "string", "format": "date", "description": "Date the bill is due." },
          "glCode": { "type": "string", "description": "General-ledger account code." },
          "poNumber": { "type": ["string", "null"], "description": "Optional purchase-order number." },
          "attachmentUrl": { "type": ["string", "null"], "description": "Optional URL to a scanned bill." }
        }
      },
      "BillPage": {
        "type": "object",
        "description": "A page of bills.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Bills on this page.", "items": { "$ref": "#/components/schemas/Bill" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor." }
        }
      },
      "RouteForApprovalBody": {
        "type": "object",
        "description": "Payload for routing a bill for approval.",
        "properties": {
          "approverEmail": { "type": "string", "format": "email", "description": "Email of the approver to assign." }
        }
      },
      "ApproveBillBody": {
        "type": "object",
        "description": "Payload to approve a bill.",
        "required": ["approverEmail"],
        "properties": {
          "approverEmail": { "type": "string", "format": "email", "description": "Approver email." },
          "reason": { "type": "string", "description": "Optional approval note." }
        }
      },
      "RejectBillBody": {
        "type": "object",
        "description": "Payload to reject a bill.",
        "required": ["approverEmail", "reason"],
        "properties": {
          "approverEmail": { "type": "string", "format": "email", "description": "Approver email." },
          "reason": { "type": "string", "description": "Why the bill was rejected." }
        }
      },
      "Vendor": {
        "type": "object",
        "description": "A vendor that bills the tenant.",
        "required": ["id", "tenantId", "name", "email", "paymentTerms", "currency", "paymentMethod", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique vendor id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the vendor belongs to." },
          "name": { "type": "string", "description": "Vendor display name." },
          "email": { "type": "string", "format": "email", "description": "Vendor contact email." },
          "paymentTerms": { "type": "integer", "description": "Net payment terms in days (e.g. 30 for net-30)." },
          "currency": { "type": "string", "description": "ISO 4217 currency code." },
          "paymentMethod": { "type": "string", "enum": ["check", "ach", "wire"], "description": "Default payment method." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Record creation time." },
          "stripeAccountId": { "type": ["string", "null"], "description": "Stripe Connect account id (acct_xxx) for outbound Transfers." },
          "plaidAccessToken": { "type": ["string", "null"], "description": "Optional Plaid access token for the vendor's receiving account." }
        }
      },
      "VendorCreate": {
        "type": "object",
        "description": "Payload to create a vendor.",
        "required": ["name", "email", "paymentTerms", "currency", "paymentMethod"],
        "properties": {
          "name": { "type": "string", "description": "Vendor display name." },
          "email": { "type": "string", "format": "email", "description": "Vendor contact email." },
          "paymentTerms": { "type": "integer", "description": "Net payment terms in days." },
          "currency": { "type": "string", "description": "ISO 4217 currency code." },
          "paymentMethod": { "type": "string", "enum": ["check", "ach", "wire"], "description": "Default payment method." },
          "stripeAccountId": { "type": "string", "description": "Optional Stripe Connect account id." },
          "plaidAccessToken": { "type": "string", "description": "Optional Plaid access token." }
        }
      },
      "VendorPage": {
        "type": "object",
        "description": "A page of vendors.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Vendors on this page.", "items": { "$ref": "#/components/schemas/Vendor" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor." }
        }
      },
      "BillPayment": {
        "type": "object",
        "description": "A scheduled or completed payment for a bill.",
        "required": ["id", "tenantId", "billId", "amountCents", "method", "scheduledFor", "paidAt", "reference", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique payment id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the payment belongs to." },
          "billId": { "type": "string", "description": "Bill the payment applies to." },
          "amountCents": { "type": "integer", "description": "Amount in cents." },
          "method": { "type": "string", "description": "Payment method (e.g. 'ach', 'wire', 'check')." },
          "scheduledFor": { "type": "string", "format": "date-time", "description": "When the payment is scheduled to leave the bank." },
          "paidAt": { "type": ["string", "null"], "format": "date-time", "description": "When the payment actually settled, or null if pending." },
          "reference": { "type": "string", "description": "External reference (check number, ACH trace, etc.)." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Record creation time." }
        }
      },
      "BillPaymentCreate": {
        "type": "object",
        "description": "Payload to schedule a payment.",
        "required": ["billId", "amountCents", "method", "scheduledFor", "reference"],
        "properties": {
          "billId": { "type": "string", "description": "Bill id." },
          "amountCents": { "type": "integer", "description": "Amount in cents." },
          "method": { "type": "string", "description": "Payment method." },
          "scheduledFor": { "type": "string", "format": "date-time", "description": "Scheduled execution time." },
          "reference": { "type": "string", "description": "External reference." },
          "executeNow": { "type": "boolean", "description": "If true and the vendor has a Stripe Connect account, push the payment immediately." }
        }
      },
      "BillPaymentPage": {
        "type": "object",
        "description": "A page of bill payments.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Payments on this page.", "items": { "$ref": "#/components/schemas/BillPayment" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor." }
        }
      },
      "AgingBucket": {
        "type": "object",
        "description": "Counts and totals for a single aging bucket.",
        "required": ["count", "totalCents"],
        "properties": {
          "count": { "type": "integer", "description": "Number of bills in this bucket." },
          "totalCents": { "type": "integer", "description": "Sum of bill amounts in cents." }
        }
      }
    }
  }
