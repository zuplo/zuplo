    "/intake/start-verification": {
      "post": {
        "operationId": "start_intake_verification",
        "summary": "Start Intake Verification",
        "description": "Send a Twilio Verify SMS code to the patient. The patient passes the code to /intake/{id}/submit. Submission is rejected without it.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["patientId"],
                "properties": {
                  "patientId": {
                    "type": "string",
                    "description": "Patient to verify."
                  },
                  "channel": {
                    "type": "string",
                    "enum": ["sms", "call", "email"],
                    "description": "Verification channel. Defaults to sms."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Verification dispatched.",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/start-intake-verification)"
