{
  "openapi": "3.1.0",
  "info": {
    "title": "NPS / Customer Feedback API",
    "version": "1.0.0",
    "description": "Headless NPS, CSAT, and CES feedback API. Models surveys, responses, follow-ups. Replaces Delighted, Wootric, AskNicely."
  },
  "paths": {
    "/surveys": {
      "get": {
        "operationId": "list_surveys",
        "summary": "List surveys in the current tenant",
        "description": "Returns surveys. Filter by status (active/paused) or kind (nps/csat/ces).",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of surveys to return. Defaults to 50.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor from a previous response.",
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Restrict to surveys in this status.",
            "schema": { "type": "string", "enum": ["active", "paused"] }
          },
          {
            "name": "kind",
            "in": "query",
            "description": "Restrict to surveys of this kind.",
            "schema": { "type": "string", "enum": ["nps", "csat", "ces"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of surveys.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SurveyPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-surveys)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "create_survey",
        "summary": "Create a survey",
        "description": "Define a new survey. Defaults `status` to `active`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SurveyCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created survey.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Survey" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/create-survey)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/surveys/{id}": {
      "get": {
        "operationId": "get_survey",
        "summary": "Get a survey by id",
        "description": "Fetch a single survey from the current tenant.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Survey id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The survey.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Survey" }
              }
            }
          },
          "404": { "description": "Survey not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/get-survey)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/surveys/{id}/send": {
      "post": {
        "operationId": "send_survey",
        "summary": "Send a survey to recipients (Resend email + Twilio SMS)",
        "description": "Dispatches a survey to recipients. Email recipients go through Resend; SMS recipients go through Twilio. Failures are isolated per recipient and reported in the response — callers can retry just the failed rows.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Survey id.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendSurveyRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Send queued.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SendSurveyAck" }
              }
            }
          },
          "404": { "description": "Survey not found in this tenant." },
          "409": { "description": "Survey is paused." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/send-survey)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/responses": {
      "get": {
        "operationId": "list_responses",
        "summary": "List responses",
        "description": "Returns responses newest first. Filter by surveyId, category (promoter/passive/detractor), or customerEmail.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of responses to return. Defaults to 50.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor from a previous response.",
            "schema": { "type": "string" }
          },
          {
            "name": "surveyId",
            "in": "query",
            "description": "Restrict to responses against a single survey.",
            "schema": { "type": "string" }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Restrict to responses in this category.",
            "schema": { "type": "string", "enum": ["promoter", "passive", "detractor"] }
          },
          {
            "name": "customerEmail",
            "in": "query",
            "description": "Restrict to responses from a single customer.",
            "schema": { "type": "string", "format": "email" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of responses.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResponsePage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-responses)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "record_response",
        "summary": "Record a survey response",
        "description": "Append a new response. The category (promoter/passive/detractor) is derived from the score automatically.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ResponseCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The recorded response.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Response" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/record-response)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/responses/{id}": {
      "get": {
        "operationId": "get_response",
        "summary": "Get a response by id",
        "description": "Fetch a single response from the current tenant.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Response id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The response.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Response" }
              }
            }
          },
          "404": { "description": "Response not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/get-response)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/follow-ups": {
      "get": {
        "operationId": "list_followups",
        "summary": "List response follow-ups",
        "description": "Returns follow-ups newest first. Filter by responseId or by the email of the user who logged the follow-up.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of follow-ups to return. Defaults to 50.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor from a previous response.",
            "schema": { "type": "string" }
          },
          {
            "name": "responseId",
            "in": "query",
            "description": "Restrict to follow-ups against a single response.",
            "schema": { "type": "string" }
          },
          {
            "name": "byEmail",
            "in": "query",
            "description": "Restrict to follow-ups logged by this user.",
            "schema": { "type": "string", "format": "email" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of follow-ups.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FollowUpPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-followups)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "log_followup",
        "summary": "Log a follow-up against a response",
        "description": "Record an outbound follow-up email or call against a response. The response's `followedUp` flag flips to true so the detractor tracker stops surfacing it.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FollowUpCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The logged follow-up.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FollowUp" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/log-followup)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/cluster-open-responses": {
      "post": {
        "operationId": "cluster_open_responses",
        "summary": "Cluster recent verbatims into themes (Claude-powered orchestrator)",
        "description": "Pulls recent open-text responses for a survey and asks Claude to discover themes and bucket each verbatim. Returns themes ranked by count, each with a 1-2 sentence summary and contributing verbatim samples. Falls back to keyword clustering when Claude is unavailable. The kit's 'AI angle'.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["surveyId"],
                "properties": {
                  "surveyId": { "type": "string", "description": "Survey to cluster responses from." },
                  "daysBack": { "type": "integer", "description": "Window in days. Defaults to 30.", "minimum": 1, "maximum": 365 },
                  "useClaude": { "type": "boolean", "description": "Default true. Set false to skip Claude and use keyword clustering only." },
                  "maxResponsesForClaude": { "type": "integer", "description": "Cap responses sent to Claude. Defaults to 200.", "minimum": 1, "maximum": 500 },
                  "maxThemes": { "type": "integer", "description": "Hint Claude on number of themes. Defaults to 6.", "minimum": 2, "maximum": 20 },
                  "category": { "type": "string", "enum": ["promoter", "passive", "detractor"], "description": "Filter to a category before clustering." },
                  "themes": {
                    "type": "array",
                    "description": "Override the default keyword theme list (used only when Claude is off).",
                    "items": {
                      "type": "object",
                      "required": ["name", "keywords"],
                      "properties": {
                        "name": { "type": "string", "description": "Theme name." },
                        "keywords": { "type": "array", "items": { "type": "string" }, "description": "Match keywords (case-insensitive substring)." }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Theme counts and sample comments.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ThemeReport" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/cluster-open-responses)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/flag-detractor-for-csm": {
      "post": {
        "operationId": "flag_detractor_for_csm",
        "summary": "Surface unaddressed detractor responses (+ optional Slack ping)",
        "description": "Returns recent detractor responses (score 0..6) where `followedUp` is still false. Optionally scoped to a segment, and optionally posts a top-N summary to Slack so the CSM team gets paged automatically.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "segment": { "type": "string", "description": "Restrict to a single segment." },
                  "daysBack": { "type": "integer", "description": "Window in days. Defaults to 14.", "minimum": 1, "maximum": 365 },
                  "postToSlack": { "type": "boolean", "description": "When true, posts a top-N summary to Slack (skipped silently if Slack isn't configured)." },
                  "slackChannel": { "type": "string", "description": "Override the Slack channel/user." },
                  "slackTopN": { "type": "integer", "description": "Cap rows in the Slack message. Defaults to 10.", "minimum": 1, "maximum": 50 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Detractor responses needing follow-up.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DetractorReport" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/flag-detractor-for-csm)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/compare-cohorts": {
      "post": {
        "operationId": "compare_cohorts",
        "summary": "Compare NPS for two cohorts (orchestrator)",
        "description": "Computes NPS = %promoters - %detractors for each segment within a survey, returns both plus the delta.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["surveyId", "segmentA", "segmentB"],
                "properties": {
                  "surveyId": { "type": "string", "description": "Survey to compute over." },
                  "segmentA": { "type": "string", "description": "First cohort." },
                  "segmentB": { "type": "string", "description": "Second cohort." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cohort comparison.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CohortComparison" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/compare-cohorts)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/webhooks/resend": {
      "post": {
        "operationId": "resend_webhook",
        "summary": "Inbound Resend (Svix) webhook",
        "description": "Verifies the Svix signature against RESEND_WEBHOOK_SIGNING_SECRET and logs bounce / complaint / open events. Extend the switch in modules/webhooks/resend.ts to suppress bounced addresses from future sends.",
        "responses": {
          "200": { "description": "Acknowledged." },
          "401": { "description": "Invalid signature." }
        },
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": { "export": "default", "module": "$import(./modules/webhooks/resend)" },
          "policies": { "inbound": ["rate-limit"] }
        }
      }
    },
    "/webhooks/twilio": {
      "post": {
        "operationId": "twilio_webhook",
        "summary": "Inbound Twilio SMS status callback",
        "description": "Twilio POSTs URL-encoded delivery-status updates here. Verifies the X-Twilio-Signature against TWILIO_AUTH_TOKEN and logs delivery state. Extend the switch in modules/webhooks/twilio.ts to retry failed sends or persist delivery analytics.",
        "responses": {
          "200": { "description": "Acknowledged." },
          "401": { "description": "Invalid signature." }
        },
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": { "export": "default", "module": "$import(./modules/webhooks/twilio)" },
          "policies": { "inbound": ["rate-limit"] }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp_handler",
        "summary": "MCP server endpoint",
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "nps-feedback-server",
              "version": "1.0.0",
              "operations": [
                { "file": "./config/routes.oas.json", "id": "list_surveys" },
                { "file": "./config/routes.oas.json", "id": "create_survey" },
                { "file": "./config/routes.oas.json", "id": "get_survey" },
                { "file": "./config/routes.oas.json", "id": "send_survey" },
                { "file": "./config/routes.oas.json", "id": "list_responses" },
                { "file": "./config/routes.oas.json", "id": "record_response" },
                { "file": "./config/routes.oas.json", "id": "get_response" },
                { "file": "./config/routes.oas.json", "id": "list_followups" },
                { "file": "./config/routes.oas.json", "id": "log_followup" },
                { "file": "./config/routes.oas.json", "id": "cluster_open_responses" },
                { "file": "./config/routes.oas.json", "id": "flag_detractor_for_csm" },
                { "file": "./config/routes.oas.json", "id": "compare_cohorts" }
              ]
            }
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"],
            "outbound": ["prompt-injection-outbound", "secret-masking-outbound"]
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Survey": {
        "type": "object",
        "description": "A survey definition.",
        "required": ["id", "tenantId", "name", "kind", "question", "sendCadence", "status"],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the survey belongs to." },
          "name": { "type": "string", "description": "Internal survey name." },
          "kind": { "type": "string", "enum": ["nps", "csat", "ces"], "description": "Survey kind." },
          "question": { "type": "string", "description": "Customer-facing question text." },
          "sendCadence": {
            "type": "string",
            "enum": ["post_action", "weekly", "monthly", "manual"],
            "description": "Cadence."
          },
          "status": { "type": "string", "enum": ["active", "paused"], "description": "Status." }
        }
      },
      "SurveyCreate": {
        "type": "object",
        "description": "Payload to create a survey.",
        "required": ["name", "kind", "question", "sendCadence"],
        "properties": {
          "name": { "type": "string", "description": "Internal survey name." },
          "kind": { "type": "string", "enum": ["nps", "csat", "ces"], "description": "Survey kind." },
          "question": { "type": "string", "description": "Customer-facing question." },
          "sendCadence": { "type": "string", "enum": ["post_action", "weekly", "monthly", "manual"], "description": "Cadence." },
          "status": { "type": "string", "enum": ["active", "paused"], "description": "Initial status. Defaults to active." }
        }
      },
      "SurveyPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Survey" } },
          "nextCursor": { "type": "string", "nullable": true, "description": "Pagination cursor; null when no more results." }
        }
      },
      "SendSurveyRequest": {
        "type": "object",
        "description": "Payload for `send_survey`. Each recipient declares its channel — `email` goes via Resend, `sms` goes via Twilio. Bare strings are interpreted as email for back-compat.",
        "required": ["recipients"],
        "properties": {
          "recipients": {
            "type": "array",
            "description": "Recipients with delivery channel.",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["channel", "to"],
                  "properties": {
                    "channel": { "type": "string", "enum": ["email", "sms"], "description": "Delivery channel." },
                    "to": { "type": "string", "description": "Email address (channel=email) or E.164 phone number (channel=sms)." }
                  }
                },
                { "type": "string", "format": "email", "description": "Legacy bare email string." }
              ]
            }
          },
          "surveyUrl": { "type": "string", "format": "uri", "description": "Hosted URL the recipient taps to respond." },
          "smsStatusCallback": { "type": "string", "format": "uri", "description": "Twilio status callback URL — recommended: https://<gateway>/webhooks/twilio." }
        }
      },
      "SendSurveyAck": {
        "type": "object",
        "description": "Per-row send results.",
        "required": ["surveyId", "queued", "sent", "sentAt", "results"],
        "properties": {
          "surveyId": { "type": "string" },
          "queued": { "type": "integer", "description": "Number of recipients we attempted." },
          "sent": { "type": "integer", "description": "Number that successfully dispatched." },
          "sentAt": { "type": "string", "format": "date-time" },
          "results": {
            "type": "array",
            "description": "Per-recipient outcome.",
            "items": {
              "type": "object",
              "properties": {
                "to": { "type": "string", "description": "Recipient." },
                "channel": { "type": "string", "enum": ["email", "sms"] },
                "ok": { "type": "boolean" },
                "id": { "type": "string", "description": "Resend message id or Twilio message SID on success." },
                "error": { "type": "string", "description": "Failure reason on !ok." }
              }
            }
          }
        }
      },
      "Response": {
        "type": "object",
        "description": "A single survey response.",
        "required": ["id", "tenantId", "surveyId", "customerEmail", "score", "comment", "category", "respondedAt", "source", "segment", "followedUp"],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the response belongs to." },
          "surveyId": { "type": "string", "description": "Survey this response is for." },
          "customerEmail": { "type": "string", "format": "email", "description": "Respondent email." },
          "score": { "type": "integer", "description": "Score 0..10.", "minimum": 0, "maximum": 10 },
          "comment": { "type": "string", "description": "Free-form comment." },
          "category": {
            "type": "string",
            "enum": ["promoter", "passive", "detractor"],
            "description": "Score-derived bucket."
          },
          "respondedAt": { "type": "string", "format": "date-time", "description": "When the response was recorded." },
          "source": { "type": "string", "description": "Source channel — email, web, in-app, etc." },
          "segment": { "type": "string", "description": "Customer segment." },
          "followedUp": { "type": "boolean", "description": "Whether anyone has logged a follow-up against this response." }
        }
      },
      "ResponseCreate": {
        "type": "object",
        "description": "Payload to record a response.",
        "required": ["surveyId", "customerEmail", "score"],
        "properties": {
          "surveyId": { "type": "string", "description": "Survey this response is for." },
          "customerEmail": { "type": "string", "format": "email", "description": "Respondent email." },
          "score": { "type": "integer", "description": "Score 0..10.", "minimum": 0, "maximum": 10 },
          "comment": { "type": "string", "description": "Free-form comment." },
          "source": { "type": "string", "description": "Source channel." },
          "segment": { "type": "string", "description": "Customer segment." }
        }
      },
      "ResponsePage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Response" } },
          "nextCursor": { "type": "string", "nullable": true, "description": "Pagination cursor; null when no more results." }
        }
      },
      "FollowUp": {
        "type": "object",
        "description": "A follow-up logged against a response.",
        "required": ["id", "tenantId", "responseId", "byEmail", "kind", "body", "sentAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the follow-up belongs to." },
          "responseId": { "type": "string", "description": "Response this follow-up addresses." },
          "byEmail": { "type": "string", "format": "email", "description": "User who logged the follow-up." },
          "kind": { "type": "string", "enum": ["email", "call"], "description": "Follow-up channel." },
          "body": { "type": "string", "description": "Follow-up body or call summary." },
          "sentAt": { "type": "string", "format": "date-time", "description": "When the follow-up was sent." }
        }
      },
      "FollowUpCreate": {
        "type": "object",
        "description": "Payload to log a follow-up.",
        "required": ["responseId", "byEmail", "kind", "body"],
        "properties": {
          "responseId": { "type": "string", "description": "Response this follow-up addresses." },
          "byEmail": { "type": "string", "format": "email", "description": "User logging the follow-up." },
          "kind": { "type": "string", "enum": ["email", "call"], "description": "Follow-up channel." },
          "body": { "type": "string", "description": "Follow-up body or call summary." }
        }
      },
      "FollowUpPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/FollowUp" } },
          "nextCursor": { "type": "string", "nullable": true, "description": "Pagination cursor; null when no more results." }
        }
      },
      "ThemeReport": {
        "type": "object",
        "description": "Output of `cluster_open_responses`.",
        "required": ["surveyId", "daysBack", "totalResponses", "mode", "topThemes", "unmatchedCount"],
        "properties": {
          "surveyId": { "type": "string" },
          "daysBack": { "type": "integer" },
          "totalResponses": { "type": "integer" },
          "mode": { "type": "string", "enum": ["claude", "keyword"], "description": "Which clustering path actually ran." },
          "topThemes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "theme": { "type": "string", "description": "Theme name (Claude-generated or from keyword config)." },
                "count": { "type": "integer", "description": "Verbatims in this theme." },
                "summary": { "type": "string", "description": "1-2 sentence theme summary (Claude mode only)." },
                "samples": { "type": "array", "items": { "$ref": "#/components/schemas/Response" }, "description": "Up to 5 example verbatims." }
              }
            }
          },
          "unmatchedCount": { "type": "integer", "description": "Comments that didn't fit any theme." }
        }
      },
      "DetractorReport": {
        "type": "object",
        "description": "Output of `flag_detractor_for_csm`.",
        "required": ["filter", "detractorCount", "detractors"],
        "properties": {
          "filter": {
            "type": "object",
            "properties": {
              "segment": { "type": "string", "nullable": true },
              "daysBack": { "type": "integer" }
            }
          },
          "detractorCount": { "type": "integer" },
          "detractors": { "type": "array", "items": { "$ref": "#/components/schemas/Response" } },
          "slack": {
            "type": "object",
            "description": "Slack post status when postToSlack=true.",
            "properties": {
              "ok": { "type": "boolean" },
              "ts": { "type": "string" },
              "error": { "type": "string" }
            }
          }
        }
      },
      "CohortComparison": {
        "type": "object",
        "description": "Output of `compare_cohorts`.",
        "required": ["surveyId", "cohortA", "cohortB", "delta"],
        "properties": {
          "surveyId": { "type": "string" },
          "cohortA": { "$ref": "#/components/schemas/CohortStats" },
          "cohortB": { "$ref": "#/components/schemas/CohortStats" },
          "delta": { "type": "integer", "description": "cohortA.npsScore - cohortB.npsScore." }
        }
      },
      "CohortStats": {
        "type": "object",
        "required": ["segment", "count", "promoters", "passives", "detractors", "npsScore"],
        "properties": {
          "segment": { "type": "string" },
          "count": { "type": "integer" },
          "promoters": { "type": "integer" },
          "passives": { "type": "integer" },
          "detractors": { "type": "integer" },
          "npsScore": { "type": "integer", "description": "NPS on -100..100 scale." }
        }
      }
    }
  }
}
