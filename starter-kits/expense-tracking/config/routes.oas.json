{
  "openapi": "3.1.0",
  "info": {
    "title": "Expense Tracking API",
    "version": "1.0.0",
    "description": "Headless expense tracking and reimbursement API. Replaces Expensify, Ramp expenses, Brex expenses. Includes orchestrator MCP tools that flag policy violations and summarize pending approvals so an LLM can drive the approval workflow."
  },
  "paths": {
    "/expenses": {
      "get": {
        "operationId": "list_expenses",
        "summary": "List expenses in the current tenant",
        "description": "Returns a paginated list of expenses, newest first.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Max expenses to return.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Page of expenses.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExpensePage" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-expenses)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "create_expense",
        "summary": "Create a draft expense",
        "description": "Submitter creates an expense in `draft` status. Use `submit_expense` to move to `submitted` for approval.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExpenseCreate" } } }
        },
        "responses": {
          "201": {
            "description": "The created expense.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Expense" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/create-expense)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/expenses/{id}": {
      "get": {
        "operationId": "get_expense",
        "summary": "Get an expense by id",
        "description": "Fetch a single expense from the current tenant.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Expense id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The expense.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Expense" } } } },
          "404": { "description": "Expense not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/get-expense)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/expenses/{id}/submit": {
      "patch": {
        "operationId": "submit_expense",
        "summary": "Submit an expense for approval",
        "description": "Move a draft expense to `submitted`. Idempotent.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Expense id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The submitted expense.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Expense" } } } },
          "404": { "description": "Expense not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/submit-expense)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/expenses/{id}/approve": {
      "patch": {
        "operationId": "approve_expense",
        "summary": "Approve a submitted expense",
        "description": "Move a submitted expense to `approved`. Idempotent.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Expense id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The approved expense.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Expense" } } } },
          "404": { "description": "Expense not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/approve-expense)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/expenses/{id}/reject": {
      "patch": {
        "operationId": "reject_expense",
        "summary": "Reject a submitted expense",
        "description": "Move a submitted expense to `rejected`. Idempotent. If RESEND_API_KEY is set, sends a notification email to the submitter explaining the rejection.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Expense id.", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": { "type": "string", "description": "Optional reason. Included in the rejection email if email is enabled." }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "The rejected expense.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Expense" } } } },
          "404": { "description": "Expense not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/reject-expense)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/expense-categories": {
      "get": {
        "operationId": "list_categories",
        "summary": "List expense categories",
        "description": "Return the chart-of-accounts categories used to classify expenses.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Max categories to return.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Page of categories.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExpenseCategoryPage" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-categories)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/expense-policies": {
      "get": {
        "operationId": "list_policies",
        "summary": "List expense policies",
        "description": "Return the per-tenant expense policies — daily limits, per-diem, receipt thresholds.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Max policies to return.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Page of policies.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExpensePolicyPage" } } }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-policies)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/flag-policy-violations": {
      "post": {
        "operationId": "flag_policy_violations",
        "summary": "Flag policy-violating expenses (orchestrator)",
        "description": "Orchestrator MCP tool. Walks expenses (optionally for one employee), joins categories + policies, and returns expenses that exceed limits or are missing required receipts. Each violation includes a list of human-readable reasons. With `notifySlack=true`, also posts a digest to the finance Slack channel.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "employeeEmail": { "type": "string", "description": "Optional. Restrict to one employee's expenses." },
                  "notifySlack": { "type": "boolean", "description": "If true, post a digest of violations to the finance Slack channel." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Violation summary.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": { "type": "integer", "description": "Number of violating expenses." },
                    "totalExposureCents": { "type": "integer", "description": "Sum of violating expense amounts in cents." },
                    "violations": {
                      "type": "array",
                      "description": "The violations.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "expense": { "$ref": "#/components/schemas/Expense" },
                          "reasons": { "type": "array", "description": "Human-readable reasons.", "items": { "type": "string" } }
                        }
                      }
                    },
                    "slackTs": { "type": ["string", "null"], "description": "Slack message timestamp if notifySlack succeeded." }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/flag-policy-violations)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/summarize-pending-approvals": {
      "post": {
        "operationId": "summarize_pending_approvals",
        "summary": "Summarize pending expense approvals (orchestrator)",
        "description": "Orchestrator MCP tool. Lists expenses in `submitted` status grouped by employee with counts and totals, sorted by amount descending. Helpful for an approver agent triaging the queue.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "approverEmail": { "type": "string", "description": "Optional metadata. Returned as-is for grounding." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pending approval summary.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "approverEmail": { "type": ["string", "null"], "description": "Echoed input." },
                    "employeeCount": { "type": "integer", "description": "How many employees have pending expenses." },
                    "pendingCount": { "type": "integer", "description": "Total pending expense count." },
                    "pendingTotalCents": { "type": "integer", "description": "Sum of pending amounts in cents." },
                    "groups": {
                      "type": "array",
                      "description": "Groups, sorted by totalCents desc.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "employeeEmail": { "type": "string", "description": "The submitter." },
                          "count": { "type": "integer", "description": "Pending expenses for this employee." },
                          "totalCents": { "type": "integer", "description": "Sum in cents." },
                          "expenses": { "type": "array", "description": "The pending expenses.", "items": { "$ref": "#/components/schemas/Expense" } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/summarize-pending-approvals)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/parse-receipt": {
      "post": {
        "operationId": "parse_receipt",
        "summary": "Parse a receipt image with Mindee OCR (orchestrator)",
        "description": "Takes a publicly-reachable receipt URL, calls the Mindee Expense Receipts v5 endpoint, and returns normalized fields (merchant, amountCents, currency, date, category) the LLM can drop straight into create_expense.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["receiptUrl"],
                "properties": {
                  "receiptUrl": { "type": "string", "format": "uri", "description": "Publicly-reachable URL to the receipt image (PNG, JPG, PDF)." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Normalized OCR result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "merchant": { "type": ["string", "null"], "description": "Detected merchant/supplier name." },
                    "amountCents": { "type": ["integer", "null"], "description": "Total amount in cents." },
                    "currency": { "type": ["string", "null"], "description": "ISO currency code." },
                    "date": { "type": ["string", "null"], "description": "Detected receipt date (YYYY-MM-DD)." },
                    "category": { "type": ["string", "null"], "description": "Detected category (food, transport, etc.)." },
                    "receiptNumber": { "type": ["string", "null"], "description": "Receipt number if detected." },
                    "confidence": { "type": "number", "description": "Min confidence across the load-bearing fields (0..1)." },
                    "ready": { "type": "boolean", "description": "True if the load-bearing fields parsed and confidence > 0.5." }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/parse-receipt)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp_handler",
        "summary": "MCP server endpoint",
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "expense-tracking-server",
              "version": "1.0.0",
              "operations": [
                { "file": "./config/routes.oas.json", "id": "list_expenses" },
                { "file": "./config/routes.oas.json", "id": "get_expense" },
                { "file": "./config/routes.oas.json", "id": "create_expense" },
                { "file": "./config/routes.oas.json", "id": "submit_expense" },
                { "file": "./config/routes.oas.json", "id": "approve_expense" },
                { "file": "./config/routes.oas.json", "id": "reject_expense" },
                { "file": "./config/routes.oas.json", "id": "list_categories" },
                { "file": "./config/routes.oas.json", "id": "list_policies" },
                { "file": "./config/routes.oas.json", "id": "flag_policy_violations" },
                { "file": "./config/routes.oas.json", "id": "summarize_pending_approvals" },
                { "file": "./config/routes.oas.json", "id": "parse_receipt" }
              ]
            }
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"],
            "outbound": ["prompt-injection-outbound", "secret-masking-outbound"]
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Expense": {
        "type": "object",
        "description": "An expense filed by an employee.",
        "required": ["id", "tenantId", "employeeEmail", "amountCents", "currency", "merchant", "category", "date", "description", "receiptUrl", "status", "policyViolation", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique expense id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the expense belongs to. Set automatically from the API key." },
          "employeeEmail": { "type": "string", "format": "email", "description": "Email of the employee who incurred the expense." },
          "amountCents": { "type": "integer", "description": "Amount in cents." },
          "currency": { "type": "string", "description": "ISO 4217 currency code." },
          "merchant": { "type": "string", "description": "Merchant or vendor where the expense was incurred." },
          "category": { "type": "string", "description": "Category name (matches an ExpenseCategory.name)." },
          "date": { "type": "string", "format": "date", "description": "Date the expense was incurred." },
          "description": { "type": "string", "description": "Free-form description of the expense." },
          "receiptUrl": { "type": ["string", "null"], "description": "URL to a receipt image or PDF, or null." },
          "status": { "type": "string", "enum": ["draft", "submitted", "approved", "rejected", "reimbursed"], "description": "Workflow state." },
          "policyViolation": { "type": "boolean", "description": "Whether the expense was flagged as a policy violation." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Record creation time." }
        }
      },
      "ExpenseCreate": {
        "type": "object",
        "description": "Payload to create a draft expense.",
        "required": ["employeeEmail", "amountCents", "currency", "merchant", "category", "date", "description"],
        "properties": {
          "employeeEmail": { "type": "string", "format": "email", "description": "Submitter email." },
          "amountCents": { "type": "integer", "description": "Amount in cents." },
          "currency": { "type": "string", "description": "ISO 4217 currency code." },
          "merchant": { "type": "string", "description": "Merchant name." },
          "category": { "type": "string", "description": "Category name." },
          "date": { "type": "string", "format": "date", "description": "Date the expense was incurred." },
          "description": { "type": "string", "description": "Free-form description." },
          "receiptUrl": { "type": ["string", "null"], "description": "Receipt URL, or null." }
        }
      },
      "ExpensePage": {
        "type": "object",
        "description": "A page of expenses.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Expenses on this page.", "items": { "$ref": "#/components/schemas/Expense" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor. Null when no more results." }
        }
      },
      "ExpenseCategory": {
        "type": "object",
        "description": "An expense category.",
        "required": ["id", "tenantId", "name", "glCode", "requiresReceipt", "maxAmountCents", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique category id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the category belongs to." },
          "name": { "type": "string", "description": "Category name." },
          "glCode": { "type": "string", "description": "General-ledger code." },
          "requiresReceipt": { "type": "boolean", "description": "Whether expenses in this category require a receipt." },
          "maxAmountCents": { "type": ["integer", "null"], "description": "Per-expense cap in cents, or null for unlimited." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Record creation time." }
        }
      },
      "ExpenseCategoryPage": {
        "type": "object",
        "description": "A page of categories.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Categories on this page.", "items": { "$ref": "#/components/schemas/ExpenseCategory" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor." }
        }
      },
      "ExpensePolicy": {
        "type": "object",
        "description": "An expense policy.",
        "required": ["id", "tenantId", "name", "dailyLimitCents", "perDiemLimitCents", "requireReceiptAbove", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique policy id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the policy belongs to." },
          "name": { "type": "string", "description": "Policy name." },
          "dailyLimitCents": { "type": "integer", "description": "Daily spend cap in cents. 0 means no limit." },
          "perDiemLimitCents": { "type": "integer", "description": "Per-diem (per-day-on-trip) cap in cents." },
          "requireReceiptAbove": { "type": "integer", "description": "Receipt threshold in cents — receipts required for amounts above this." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Record creation time." }
        }
      },
      "ExpensePolicyPage": {
        "type": "object",
        "description": "A page of policies.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Policies on this page.", "items": { "$ref": "#/components/schemas/ExpensePolicy" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor." }
        }
      }
    }
  }
}
