                },
                {
                  "file": "./config/routes.oas.json",
                  "id": "list_goals"
                },
                {
                  "file": "./config/routes.oas.json",
                  "id": "list_reviews"
                },
                {
                  "file": "./config/routes.oas.json",
                  "id": "submit_review"
                },
                {
                  "file": "./config/routes.oas.json",
                  "id": "update_goal_progress"
                },
                {
                  "file": "./config/routes.oas.json",
                  "id": "request_peer_feedback"
                },
                {
                  "file": "./config/routes.oas.json",
                  "id": "summarize_feedback_themes"
                },
                {
                  "file": "./config/routes.oas.json",
                  "id": "track_goal_progress"
                }
              ]
            }
          },
          "policies": {
            "inbound": [
              "api-key-inbound",
              "rate-limit"
            ],
            "outbound": [
              "prompt-injection-outbound",
              "secret-masking-outbound"
            ]
          }
        }
      }
    }
