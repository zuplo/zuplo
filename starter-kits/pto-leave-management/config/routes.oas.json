{
  "openapi": "3.1.0",
  "info": {
    "title": "PTO & Leave Management API",
    "version": "1.0.0",
    "description": "API + MCP server for PTO and leave-of-absence tracking. Replaces BambooHR Time Off, Vacation Tracker, and AbsenceSoft. Includes orchestrator MCP tools for finding overlapping PTO and checking leave balances."
  },
  "paths": {
    "/leave-requests": {
      "get": {
        "operationId": "list_leave_requests",
        "summary": "List leave requests in the current tenant",
        "description": "Returns a paginated list of leave requests for the authenticated tenant. Supports optional filtering by employeeId, status, and a date window on the request's startDate.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of leave requests to return. Defaults to 50.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor from a previous response.",
            "schema": { "type": "string" }
          },
          {
            "name": "employeeId",
            "in": "query",
            "description": "Filter to leave requests for a single employee.",
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter to a single status (pending, approved, denied, cancelled).",
            "schema": { "type": "string", "enum": ["pending", "approved", "denied", "cancelled"] }
          },
          {
            "name": "startDateFrom",
            "in": "query",
            "description": "Inclusive lower bound on the leave request's startDate (YYYY-MM-DD).",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "startDateTo",
            "in": "query",
            "description": "Inclusive upper bound on the leave request's startDate (YYYY-MM-DD).",
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of leave requests.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LeaveRequestPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-leave-requests)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      },
      "post": {
        "operationId": "create_leave_request",
        "summary": "Create a leave request",
        "description": "Submit a new leave request for an employee. The request is created in 'pending' status and must be approved or denied. The tenantId is set from the authenticated API key.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LeaveRequestCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created leave request.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LeaveRequest" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/create-leave-request)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false }
          }
        }
      }
    },
    "/leave-requests/{id}": {
      "get": {
        "operationId": "get_leave_request",
        "summary": "Get a leave request by id",
        "description": "Fetch a single leave request from the current tenant by its id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Leave request id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The leave request.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LeaveRequest" }
              }
            }
          },
          "404": { "description": "Leave request not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/get-leave-request)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      },
      "delete": {
        "operationId": "cancel_leave_request",
        "summary": "Cancel a leave request",
        "description": "Soft-cancels a leave request by setting its status to 'cancelled'. The row is retained for audit purposes.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Leave request id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Cancelled." },
          "404": { "description": "Leave request not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/cancel-leave-request)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "destructiveHint": true }
          }
        }
      }
    },
    "/leave-requests/{id}/approve": {
      "patch": {
        "operationId": "approve_leave_request",
        "summary": "Approve a pending leave request",
        "description": "Mark a leave request as approved. Records the approver's identifier and the approval timestamp. Behaviour is idempotent — re-approving an already-approved request just refreshes the timestamp.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Leave request id.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["approvedBy"],
                "properties": {
                  "approvedBy": {
                    "type": "string",
                    "description": "Identifier (employee id or email) of the approver."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The approved leave request.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LeaveRequest" }
              }
            }
          },
          "404": { "description": "Leave request not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/approve-leave-request)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false, "idempotentHint": true }
          }
        }
      }
    },
    "/leave-requests/{id}/deny": {
      "patch": {
        "operationId": "deny_leave_request",
        "summary": "Deny a pending leave request",
        "description": "Mark a leave request as denied. Records the approver's identifier and timestamp. Optional reason can be supplied for the denial.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Leave request id.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["approvedBy"],
                "properties": {
                  "approvedBy": {
                    "type": "string",
                    "description": "Identifier (employee id or email) of the manager who denied the request."
                  },
                  "reason": {
                    "type": "string",
                    "description": "Optional explanation for the denial. Surfaced to the requester."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The denied leave request.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LeaveRequest" }
              }
            }
          },
          "404": { "description": "Leave request not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/deny-leave-request)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false, "idempotentHint": true }
          }
        }
      }
    },
    "/find-overlapping-pto": {
      "post": {
        "operationId": "find_overlapping_pto",
        "summary": "Find overlapping PTO for a team and date window (orchestrator)",
        "description": "Given a list of team member ids and a date window, returns every pending or approved leave request that overlaps the window. Useful for staffing decisions: 'who is out the week of June 10?'",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["teamMemberIds", "startDate", "endDate"],
                "properties": {
                  "teamMemberIds": {
                    "type": "array",
                    "description": "Employee ids to check for overlapping PTO.",
                    "items": { "type": "string" }
                  },
                  "startDate": {
                    "type": "string",
                    "format": "date",
                    "description": "Inclusive start of the date window (YYYY-MM-DD)."
                  },
                  "endDate": {
                    "type": "string",
                    "format": "date",
                    "description": "Inclusive end of the date window (YYYY-MM-DD)."
                  },
                  "notifyManager": {
                    "type": "boolean",
                    "description": "When true and conflictCount > 0, post a Slack message to managerSlackChannel (or SLACK_DEFAULT_CHANNEL) with a coverage warning. Failures are reported in the response, not thrown."
                  },
                  "managerSlackChannel": {
                    "type": "string",
                    "description": "Slack channel id, channel name (e.g. #staffing), or user id to DM. Optional; falls back to SLACK_DEFAULT_CHANNEL."
                  },
                  "teamName": {
                    "type": "string",
                    "description": "Display name for the team in the Slack alert (e.g. 'Platform team')."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Conflicts found in the window.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "window": {
                      "type": "object",
                      "description": "The window that was checked.",
                      "properties": {
                        "startDate": { "type": "string", "description": "Window start." },
                        "endDate": { "type": "string", "description": "Window end." }
                      }
                    },
                    "conflictCount": {
                      "type": "integer",
                      "description": "Total number of overlapping leave requests."
                    },
                    "conflicts": {
                      "type": "array",
                      "description": "Each overlapping leave request, summarised.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "employeeId": { "type": "string", "description": "Employee on leave." },
                          "leaveRequestId": { "type": "string", "description": "Leave request id." },
                          "type": { "type": "string", "description": "Leave type." },
                          "status": { "type": "string", "description": "Leave status (pending or approved)." },
                          "startDate": { "type": "string", "description": "Leave start (YYYY-MM-DD)." },
                          "endDate": { "type": "string", "description": "Leave end (YYYY-MM-DD)." },
                          "days": { "type": "number", "description": "Number of days requested." }
                        }
                      }
                    },
                    "notification": {
                      "type": "object",
                      "description": "Slack notification result, present only when notifyManager was true and conflicts > 0.",
                      "properties": {
                        "sent": { "type": "boolean", "description": "Whether Slack accepted the message." },
                        "channel": { "type": "string", "description": "Channel the message was posted to (Web API only)." },
                        "ts": { "type": "string", "description": "Slack message timestamp for threading replies." },
                        "error": { "type": "string", "description": "Failure reason when sent=false." }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/find-overlapping-pto)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      }
    },
    "/check-leave-balance": {
      "post": {
        "operationId": "check_leave_balance",
        "summary": "Check an employee's leave balance (orchestrator)",
        "description": "Returns the snapshot leave balance for an employee, broken out by leave type. Production implementations would compute this from accrual policies + approved requests; this kit returns the stored snapshot.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["employeeId"],
                "properties": {
                  "employeeId": {
                    "type": "string",
                    "description": "Employee id to check the balance for."
                  },
                  "draftReply": {
                    "type": "boolean",
                    "description": "When true, ask Claude to draft a friendly natural-language reply summarizing the balance, suitable for pasting into Slack or email."
                  },
                  "question": {
                    "type": "string",
                    "description": "Optional context for the drafted reply, e.g. 'Maria asked if she has enough vacation left for a trip June 14-21'."
                  },
                  "employeeName": {
                    "type": "string",
                    "description": "Optional display name for the employee, used in the drafted reply."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Leave balance for the employee.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "employeeId": { "type": "string", "description": "Employee id." },
                    "balances": {
                      "type": "object",
                      "description": "Map of leave type to balance details.",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "balanceDays": { "type": "number", "description": "Days available." },
                          "accruedYtd": { "type": "number", "description": "Days accrued year-to-date." }
                        }
                      }
                    },
                    "asOf": { "type": "string", "format": "date-time", "description": "When the balance was read." },
                    "productionNote": { "type": "string", "description": "Implementation note." },
                    "draftedReply": {
                      "type": "object",
                      "description": "Claude-drafted reply, present only when draftReply was true.",
                      "properties": {
                        "text": { "type": "string", "description": "The drafted reply text." },
                        "model": { "type": "string", "description": "Claude model that produced the draft." },
                        "inputTokens": { "type": "integer", "description": "Input tokens consumed." },
                        "outputTokens": { "type": "integer", "description": "Output tokens generated." }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/check-leave-balance)"
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"]
          },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp_handler",
        "summary": "MCP server endpoint",
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "pto-leave-management",
              "version": "1.0.0",
              "operations": [
                { "file": "./config/routes.oas.json", "id": "list_leave_requests" },
                { "file": "./config/routes.oas.json", "id": "get_leave_request" },
                { "file": "./config/routes.oas.json", "id": "create_leave_request" },
                { "file": "./config/routes.oas.json", "id": "approve_leave_request" },
                { "file": "./config/routes.oas.json", "id": "deny_leave_request" },
                { "file": "./config/routes.oas.json", "id": "cancel_leave_request" },
                { "file": "./config/routes.oas.json", "id": "find_overlapping_pto" },
                { "file": "./config/routes.oas.json", "id": "check_leave_balance" }
              ]
            }
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"],
            "outbound": ["prompt-injection-outbound", "secret-masking-outbound"]
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LeaveRequest": {
        "type": "object",
        "description": "A single PTO/leave-of-absence request submitted by an employee.",
        "required": [
          "id",
          "tenantId",
          "employeeId",
          "startDate",
          "endDate",
          "type",
          "status",
          "reason",
          "days",
          "createdAt"
        ],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the request belongs to. Set automatically from the API key." },
          "employeeId": { "type": "string", "description": "Employee submitting the request." },
          "startDate": { "type": "string", "format": "date", "description": "First day of leave (YYYY-MM-DD)." },
          "endDate": { "type": "string", "format": "date", "description": "Last day of leave, inclusive (YYYY-MM-DD)." },
          "type": {
            "type": "string",
            "enum": ["vacation", "sick", "personal", "unpaid"],
            "description": "Category of leave."
          },
          "status": {
            "type": "string",
            "enum": ["pending", "approved", "denied", "cancelled"],
            "description": "Workflow status of the request."
          },
          "reason": { "type": "string", "description": "Free-text reason supplied by the employee." },
          "days": { "type": "number", "description": "Number of leave days requested. Floats allowed for half-days." },
          "approvedBy": { "type": ["string", "null"], "description": "Identifier of the approver, if any." },
          "approvedAt": { "type": ["string", "null"], "format": "date-time", "description": "When the request was approved or denied." },
          "createdAt": { "type": "string", "format": "date-time", "description": "ISO-8601 creation timestamp." }
        }
      },
      "LeaveRequestCreate": {
        "type": "object",
        "description": "Payload to create a new leave request.",
        "required": ["employeeId", "startDate", "endDate", "type", "reason", "days"],
        "properties": {
          "employeeId": { "type": "string", "description": "Employee submitting the request." },
          "startDate": { "type": "string", "format": "date", "description": "First day of leave (YYYY-MM-DD)." },
          "endDate": { "type": "string", "format": "date", "description": "Last day of leave, inclusive (YYYY-MM-DD)." },
          "type": {
            "type": "string",
            "enum": ["vacation", "sick", "personal", "unpaid"],
            "description": "Category of leave."
          },
          "reason": { "type": "string", "description": "Free-text reason for the leave." },
          "days": { "type": "number", "description": "Number of leave days requested. Floats allowed for half-days." }
        }
      },
      "LeaveRequestPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "description": "Page of leave requests.",
            "items": { "$ref": "#/components/schemas/LeaveRequest" }
          },
          "nextCursor": {
            "type": ["string", "null"],
            "description": "Pagination cursor. Pass back as `cursor` for the next page. Null when no more results."
          }
        }
      }
    }
  }
}
