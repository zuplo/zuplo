            "type": "string",
            "enum": ["hardware", "software", "access", "network", "other"],
            "description": "Updated category."
          },
          "priority": {
            "type": "string",
            "enum": ["low", "med", "high", "critical"],
            "description": "Updated priority."
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "awaiting_user", "resolved", "closed"],
            "description": "Updated status."
          },
          "assigneeEmail": { "type": "string", "nullable": true, "description": "Updated assignee." },
          "tags": { "type": "array", "items": { "type": "string" }, "description": "Replacement tag list." }
        }
      },
      "IncidentTicketPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/IncidentTicket" }
          },
          "nextCursor": { "type": "string", "nullable": true, "description": "Pagination cursor." }
        }
      },
      "Comment": {
        "type": "object",
        "description": "A comment posted on a ticket.",
        "required": ["id", "tenantId", "ticketId", "authorEmail", "body", "kind", "postedAt"],
        "properties": {
          "id": { "type": "string", "description": "Comment id." },
          "tenantId": { "type": "string", "description": "Tenant id." },
          "ticketId": { "type": "string", "description": "Id of the ticket this comment belongs to." },
          "authorEmail": { "type": "string", "description": "Email of who posted." },
          "body": { "type": "string", "description": "Comment body." },
          "kind": {
            "type": "string",
