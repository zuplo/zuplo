{
  "openapi": "3.1.0",
  "info": {
    "title": "Scheduling & Booking API",
    "version": "1.0.0",
    "description": "Headless scheduling and booking API. Replaces the data layer of Calendly, Cal.com. Manages event types, host availability, bookings, cancellations, and reschedules. Ships with orchestrator MCP tools for finding mutual slots, proposing conflict-free reschedules, and enforcing per-host meeting budgets."
  },
  "paths": {
    "/event-types": {
      "get": {
        "operationId": "list_event_types",
        "summary": "List event types",
        "description": "Returns a paginated list of bookable event-type templates (for example: 30-min intro, 60-min discovery).",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Max event types to return.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Page of event types.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EventTypePage" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-event-types)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "create_event_type",
        "summary": "Create an event type",
        "description": "Create a new bookable event-type template tied to an owner host. Defaults `active` to true and zero buffers if omitted.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EventTypeCreate" } } }
        },
        "responses": {
          "201": { "description": "The created event type.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EventType" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/create-event-type)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/event-types/{id}": {
      "get": {
        "operationId": "get_event_type",
        "summary": "Get an event type by id",
        "description": "Fetch a single event type from the current tenant.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Event type id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The event type.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EventType" } } } },
          "404": { "description": "Event type not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/get-event-type)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/bookings": {
      "get": {
        "operationId": "list_bookings",
        "summary": "List bookings",
        "description": "Returns a paginated list of bookings ordered by scheduledFor ascending.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Max bookings to return.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Page of bookings.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BookingPage" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-bookings)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "book_meeting",
        "summary": "Book a meeting",
        "description": "Create a confirmed booking for the given event type with an attendee at a specific time. Use `get_available_slots` first to find a free slot.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BookingCreate" } } }
        },
        "responses": {
          "201": { "description": "The created booking.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Booking" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/book-meeting)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/bookings/{id}": {
      "get": {
        "operationId": "get_booking",
        "summary": "Get a booking by id",
        "description": "Fetch a single booking from the current tenant.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Booking id.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The booking.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Booking" } } } },
          "404": { "description": "Booking not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/get-booking)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "patch": {
        "operationId": "reschedule_booking",
        "summary": "Reschedule a booking",
        "description": "Move a booking to a new time. Sets status to `rescheduled` and updates `scheduledFor`. Optionally updates duration.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Booking id.", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BookingReschedule" } } }
        },
        "responses": {
          "200": { "description": "The updated booking.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Booking" } } } },
          "404": { "description": "Booking not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/reschedule-booking)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": true } }
        }
      }
    },
    "/bookings/{id}/cancel": {
      "patch": {
        "operationId": "cancel_booking",
        "summary": "Cancel a booking",
        "description": "Cancel a booking. Sets status to `canceled`, stamps `canceledAt` and `cancelReason`, and writes a Cancellation audit row. Destructive — the slot is freed up for re-booking.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Booking id.", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": false,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BookingCancel" } } }
        },
        "responses": {
          "200": { "description": "The canceled booking.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Booking" } } } },
          "404": { "description": "Booking not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/cancel-booking)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "destructiveHint": true } }
        }
      }
    },
    "/availability": {
      "get": {
        "operationId": "list_availability",
        "summary": "List availability windows",
        "description": "Returns recurring weekly availability windows. Each row is `(ownerEmail, dayOfWeek, startTime, endTime, timezone)`.",
        "parameters": [
          { "name": "limit", "in": "query", "description": "Max windows to return.", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "description": "Pagination cursor.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Page of availability windows.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AvailabilityPage" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/list-availability)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "set_availability",
        "summary": "Add an availability window",
        "description": "Create a recurring weekly availability window for a host. To replace an entire schedule, delete existing rows first or compose multiple `set_availability` calls.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AvailabilityCreate" } } }
        },
        "responses": {
          "201": { "description": "The created availability window.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Availability" } } } }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/set-availability)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/get-available-slots": {
      "post": {
        "operationId": "get_available_slots",
        "summary": "Compute available slots for an event type",
        "description": "Given an event type slug and a date window, returns concrete bookable slots for the host based on their availability windows minus existing confirmed/rescheduled bookings (with buffers applied).",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SlotQuery" } } }
        },
        "responses": {
          "200": {
            "description": "Available slots for the event type.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Slots within the queried window.",
                  "properties": {
                    "eventTypeSlug": { "type": "string", "description": "Echo of the requested event type." },
                    "slots": {
                      "type": "array",
                      "description": "Bookable slots, each `start`/`end` ISO-8601.",
                      "items": { "$ref": "#/components/schemas/Slot" }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/handlers/get-available-slots)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/find-mutual-slot": {
      "post": {
        "operationId": "find_mutual_slot",
        "summary": "Find mutual availability across hosts (orchestrator)",
        "description": "Orchestrator MCP tool. Intersects every listed host's availability and existing bookings, returning the top 5 slots where all hosts are free.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MutualSlotQuery" } } }
        },
        "responses": {
          "200": {
            "description": "Up to 5 mutually-free slots.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Mutual slot result.",
                  "properties": {
                    "hostEmails": { "type": "array", "description": "Hosts the search ran across.", "items": { "type": "string" } },
                    "durationMinutes": { "type": "integer", "description": "Slot duration the search used." },
                    "slots": { "type": "array", "description": "Up to 5 mutually-free slots.", "items": { "$ref": "#/components/schemas/Slot" } }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/find-mutual-slot)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/reschedule-around-conflict": {
      "post": {
        "operationId": "reschedule_around_conflict",
        "summary": "Propose a conflict-free reschedule (orchestrator)",
        "description": "Orchestrator MCP tool. Given a bookingId, finds the next available slot for the host that does not conflict with their other bookings. Returns the proposal only — does not mutate the booking. Caller can confirm with `reschedule_booking`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["bookingId"],
                "properties": {
                  "bookingId": { "type": "string", "description": "Id of the booking to reschedule." },
                  "searchDays": { "type": "integer", "description": "How many days forward to search. Defaults to 14.", "minimum": 1, "maximum": 60 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Proposed new time (or null if no slot was found).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Reschedule proposal.",
                  "properties": {
                    "bookingId": { "type": "string", "description": "Echo of the requested booking id." },
                    "hostEmail": { "type": "string", "description": "The host the search was for." },
                    "proposedScheduledFor": { "type": ["string", "null"], "format": "date-time", "description": "Proposed new start time. Null if no slot was found." },
                    "durationMinutes": { "type": "integer", "description": "The booking's existing duration." },
                    "note": { "type": "string", "description": "Free-form note about the proposal." }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/reschedule-around-conflict)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/enforce-meeting-budget": {
      "post": {
        "operationId": "enforce_meeting_budget",
        "summary": "Enforce per-host weekly meeting budget (orchestrator)",
        "description": "Orchestrator MCP tool. Sums an owner's booked hours during the given week and flags whether they're over the configured maxHours.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ownerEmail", "weekStartDate", "maxHours"],
                "properties": {
                  "ownerEmail": { "type": "string", "description": "The host whose budget is being checked." },
                  "weekStartDate": { "type": "string", "format": "date-time", "description": "Start of the 7-day window (inclusive)." },
                  "maxHours": { "type": "number", "description": "Max meeting-hours allowed in the window." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Budget check result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Budget result with breakdown.",
                  "properties": {
                    "ownerEmail": { "type": "string", "description": "Echo of the host." },
                    "weekStartDate": { "type": "string", "description": "Echo of the week start." },
                    "maxHours": { "type": "number", "description": "Echo of the max hours." },
                    "bookedHours": { "type": "number", "description": "Total hours booked." },
                    "overBudget": { "type": "boolean", "description": "True when bookedHours exceeds maxHours." },
                    "overByHours": { "type": "number", "description": "Excess over budget, in hours." },
                    "bookingCount": { "type": "integer", "description": "Number of bookings counted." },
                    "bookings": { "type": "array", "description": "Compact list of bookings counted.", "items": { "type": "object" } }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": { "export": "default", "module": "$import(./modules/mcp-tools/enforce-meeting-budget)" },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp_handler",
        "summary": "MCP server endpoint",
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "scheduling-booking-server",
              "version": "1.0.0",
              "operations": [
                { "file": "./config/routes.oas.json", "id": "list_event_types" },
                { "file": "./config/routes.oas.json", "id": "get_event_type" },
                { "file": "./config/routes.oas.json", "id": "create_event_type" },
                { "file": "./config/routes.oas.json", "id": "list_bookings" },
                { "file": "./config/routes.oas.json", "id": "get_booking" },
                { "file": "./config/routes.oas.json", "id": "book_meeting" },
                { "file": "./config/routes.oas.json", "id": "reschedule_booking" },
                { "file": "./config/routes.oas.json", "id": "cancel_booking" },
                { "file": "./config/routes.oas.json", "id": "list_availability" },
                { "file": "./config/routes.oas.json", "id": "set_availability" },
                { "file": "./config/routes.oas.json", "id": "get_available_slots" },
                { "file": "./config/routes.oas.json", "id": "find_mutual_slot" },
                { "file": "./config/routes.oas.json", "id": "reschedule_around_conflict" },
                { "file": "./config/routes.oas.json", "id": "enforce_meeting_budget" }
              ]
            }
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"],
            "outbound": ["prompt-injection-outbound", "secret-masking-outbound"]
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Booking": {
        "type": "object",
        "description": "A scheduled meeting between a host and an attendee. `calendarEventId`/`zoomMeetingId`/`zoomJoinUrl` are populated when the kit provisioned external resources on book_meeting.",
        "required": ["id", "tenantId", "eventTypeSlug", "hostEmail", "attendeeEmail", "attendeeName", "scheduledFor", "durationMinutes", "status", "canceledAt", "cancelReason", "notes", "location", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique booking id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the booking belongs to. Set automatically from the API key." },
          "eventTypeSlug": { "type": "string", "description": "Slug of the event type the booking was made against." },
          "hostEmail": { "type": "string", "format": "email", "description": "Email of the host hosting the meeting." },
          "attendeeEmail": { "type": "string", "format": "email", "description": "Email of the attendee." },
          "attendeeName": { "type": "string", "description": "Display name of the attendee." },
          "attendeePhone": { "type": ["string", "null"], "description": "Attendee phone number used for SMS confirmation." },
          "scheduledFor": { "type": "string", "format": "date-time", "description": "ISO-8601 start time of the meeting." },
          "durationMinutes": { "type": "integer", "description": "Meeting duration in minutes." },
          "status": { "type": "string", "enum": ["confirmed", "canceled", "rescheduled", "completed", "no_show"], "description": "Lifecycle state." },
          "canceledAt": { "type": ["string", "null"], "format": "date-time", "description": "When the booking was canceled. Null when not canceled." },
          "cancelReason": { "type": ["string", "null"], "description": "Free-form cancel reason." },
          "notes": { "type": ["string", "null"], "description": "Free-form notes." },
          "location": { "type": ["string", "null"], "description": "Meeting location (URL, address, or 'in-person')." },
          "calendarEventId": { "type": ["string", "null"], "description": "Google Calendar event id when the kit provisioned one." },
          "zoomMeetingId": { "type": ["string", "null"], "description": "Zoom meeting id when the kit provisioned one." },
          "zoomJoinUrl": { "type": ["string", "null"], "description": "Zoom join URL or Google Meet hangoutLink." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Record creation time." }
        }
      },
      "BookingCreate": {
        "type": "object",
        "description": "Payload to create a confirmed booking. Optional `conference` triggers Zoom or Google Meet provisioning; optional `attendeePhone` triggers a Twilio SMS confirmation.",
        "required": ["eventTypeSlug", "hostEmail", "attendeeEmail", "attendeeName", "scheduledFor", "durationMinutes"],
        "properties": {
          "eventTypeSlug": { "type": "string", "description": "Slug of the event type." },
          "hostEmail": { "type": "string", "format": "email", "description": "Host email." },
          "attendeeEmail": { "type": "string", "format": "email", "description": "Attendee email." },
          "attendeeName": { "type": "string", "description": "Attendee display name." },
          "attendeePhone": { "type": "string", "description": "Optional attendee phone number in e.164 (triggers Twilio confirmation SMS)." },
          "scheduledFor": { "type": "string", "format": "date-time", "description": "Start time." },
          "durationMinutes": { "type": "integer", "description": "Duration in minutes." },
          "notes": { "type": "string", "description": "Optional notes." },
          "location": { "type": "string", "description": "Optional location." },
          "conference": { "type": "string", "enum": ["zoom", "google_meet", "none"], "description": "Conference provisioning. Defaults to none." },
          "timezone": { "type": "string", "description": "IANA timezone for the calendar event (e.g. America/Los_Angeles)." },
          "silent": { "type": "boolean", "description": "When true, skip Calendar/Zoom/SMS side-effects." }
        }
      },
      "BookingReschedule": {
        "type": "object",
        "description": "Payload to reschedule a booking.",
        "required": ["scheduledFor"],
        "properties": {
          "scheduledFor": { "type": "string", "format": "date-time", "description": "New start time." },
          "durationMinutes": { "type": "integer", "description": "Optional new duration." }
        }
      },
      "BookingCancel": {
        "type": "object",
        "description": "Payload to cancel a booking. The kit deletes any provisioned Calendar event + Zoom meeting and SMS the attendee unless `silent: true`.",
        "properties": {
          "reason": { "type": "string", "description": "Free-form cancel reason." },
          "canceledBy": { "type": "string", "description": "Identifier of who canceled (email, user id, or 'system')." },
          "silent": { "type": "boolean", "description": "When true, skip Calendar/Zoom/SMS side-effects." }
        }
      },
      "BookingPage": {
        "type": "object",
        "description": "A page of bookings.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Bookings on this page.", "items": { "$ref": "#/components/schemas/Booking" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor." }
        }
      },
      "EventType": {
        "type": "object",
        "description": "A bookable meeting template owned by a host.",
        "required": ["id", "tenantId", "slug", "ownerEmail", "name", "durationMinutes", "bufferBeforeMinutes", "bufferAfterMinutes", "locations", "availableHours", "active", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique event type id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the event type belongs to." },
          "slug": { "type": "string", "description": "URL-safe slug ('30min-intro')." },
          "ownerEmail": { "type": "string", "format": "email", "description": "Email of the host who owns this event type." },
          "name": { "type": "string", "description": "Human-readable name." },
          "durationMinutes": { "type": "integer", "description": "Default duration in minutes." },
          "bufferBeforeMinutes": { "type": "integer", "description": "Minutes of buffer before the meeting." },
          "bufferAfterMinutes": { "type": "integer", "description": "Minutes of buffer after the meeting." },
          "locations": { "type": "array", "description": "Possible meeting locations.", "items": { "type": "string" } },
          "availableHours": { "type": "string", "description": "Default available hours expressed as 'HH:MM-HH:MM'." },
          "active": { "type": "boolean", "description": "When false, the event type is hidden from booking." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Record creation time." }
        }
      },
      "EventTypeCreate": {
        "type": "object",
        "description": "Payload to create an event type.",
        "required": ["slug", "ownerEmail", "name", "durationMinutes"],
        "properties": {
          "slug": { "type": "string", "description": "URL-safe slug." },
          "ownerEmail": { "type": "string", "format": "email", "description": "Owner host." },
          "name": { "type": "string", "description": "Human-readable name." },
          "durationMinutes": { "type": "integer", "description": "Default duration in minutes." },
          "bufferBeforeMinutes": { "type": "integer", "description": "Buffer before, in minutes." },
          "bufferAfterMinutes": { "type": "integer", "description": "Buffer after, in minutes." },
          "locations": { "type": "array", "description": "Possible meeting locations.", "items": { "type": "string" } },
          "availableHours": { "type": "string", "description": "Default available hours 'HH:MM-HH:MM'." },
          "active": { "type": "boolean", "description": "Whether the event type is bookable." }
        }
      },
      "EventTypePage": {
        "type": "object",
        "description": "A page of event types.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Event types on this page.", "items": { "$ref": "#/components/schemas/EventType" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor." }
        }
      },
      "Availability": {
        "type": "object",
        "description": "A recurring weekly availability window for a host.",
        "required": ["id", "tenantId", "ownerEmail", "dayOfWeek", "startTime", "endTime", "timezone", "createdAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique availability row id." },
          "tenantId": { "type": "string", "description": "Tenant the row belongs to." },
          "ownerEmail": { "type": "string", "format": "email", "description": "Host email." },
          "dayOfWeek": { "type": "integer", "description": "Day of week (0=Sunday, 6=Saturday).", "minimum": 0, "maximum": 6 },
          "startTime": { "type": "string", "description": "Start time as 'HH:MM' in the host's timezone." },
          "endTime": { "type": "string", "description": "End time as 'HH:MM'." },
          "timezone": { "type": "string", "description": "IANA timezone string (e.g. 'America/Los_Angeles')." },
          "createdAt": { "type": "string", "format": "date-time", "description": "Record creation time." }
        }
      },
      "AvailabilityCreate": {
        "type": "object",
        "description": "Payload to add an availability window.",
        "required": ["ownerEmail", "dayOfWeek", "startTime", "endTime", "timezone"],
        "properties": {
          "ownerEmail": { "type": "string", "format": "email", "description": "Host email." },
          "dayOfWeek": { "type": "integer", "description": "Day of week (0=Sunday, 6=Saturday).", "minimum": 0, "maximum": 6 },
          "startTime": { "type": "string", "description": "Start time 'HH:MM'." },
          "endTime": { "type": "string", "description": "End time 'HH:MM'." },
          "timezone": { "type": "string", "description": "IANA timezone." }
        }
      },
      "AvailabilityPage": {
        "type": "object",
        "description": "A page of availability windows.",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "description": "Availability rows on this page.", "items": { "$ref": "#/components/schemas/Availability" } },
          "nextCursor": { "type": ["string", "null"], "description": "Pagination cursor." }
        }
      },
      "SlotQuery": {
        "type": "object",
        "description": "Input to compute available slots.",
        "required": ["eventTypeSlug", "dateFrom", "dateTo"],
        "properties": {
          "eventTypeSlug": { "type": "string", "description": "Event type to compute against." },
          "dateFrom": { "type": "string", "format": "date-time", "description": "Window start (ISO-8601)." },
          "dateTo": { "type": "string", "format": "date-time", "description": "Window end (ISO-8601)." }
        }
      },
      "MutualSlotQuery": {
        "type": "object",
        "description": "Input to find mutual slots across hosts.",
        "required": ["hostEmails", "durationMinutes", "dateFrom", "dateTo"],
        "properties": {
          "hostEmails": { "type": "array", "description": "Hosts that must all be free.", "items": { "type": "string", "format": "email" } },
          "durationMinutes": { "type": "integer", "description": "Slot duration in minutes." },
          "dateFrom": { "type": "string", "format": "date-time", "description": "Window start." },
          "dateTo": { "type": "string", "format": "date-time", "description": "Window end." }
        }
      },
      "Slot": {
        "type": "object",
        "description": "A bookable time window.",
        "required": ["start", "end"],
        "properties": {
          "start": { "type": "string", "format": "date-time", "description": "Slot start (ISO-8601)." },
          "end": { "type": "string", "format": "date-time", "description": "Slot end (ISO-8601)." },
          "hostEmail": { "type": "string", "format": "email", "description": "Optional host email when known." }
        }
      }
    }
  }
}
