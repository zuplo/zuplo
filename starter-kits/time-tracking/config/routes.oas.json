          "clientName": { "type": "string", "description": "Client the project is for." },
          "billingRateUsd": { "type": "number", "description": "Hourly billing rate in USD." },
          "active": { "type": "boolean", "description": "Whether time can still be tracked against this project." },
          "createdAt": { "type": "string", "format": "date-time", "description": "ISO-8601 creation timestamp." }
