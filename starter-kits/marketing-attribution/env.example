# Pick a database provider. The kit boots with `in-memory` if unset.
# Options: in-memory | supabase | firestore | clickhouse | upstash-redis | neon
DB_PROVIDER=in-memory

# === Supabase (PostgREST) ===
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJh...
# SUPABASE_TABLE=items

# === Firestore (REST) ===
# FIREBASE_PROJECT=your-gcp-project-id
# FIRESTORE_COLLECTION=items
# FIREBASE_ACCESS_TOKEN=ya29....   # OAuth2 access token; refresh upstream

# === ClickHouse (HTTP) — recommended for touchpoint volume ===
# CLICKHOUSE_URL=https://xxxxx.clickhouse.cloud
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=...
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_TOUCHPOINTS_TABLE=touchpoints
# CLICKHOUSE_CONVERSIONS_TABLE=conversions

# === Upstash Redis (REST) ===
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# UPSTASH_KEY_PREFIX=items

# === Neon (HTTP serverless) ===
# NEON_HTTP_URL=https://xxxx.neon.tech/sql
# NEON_CONNECTION_STRING=postgresql://...
# NEON_TABLE=items

# === Meta (Facebook/Instagram) Ads — Lead Ads webhook + /insights spend ===
# META_GRAPH_VERSION=v19.0
# META_APP_SECRET=...                 # used to verify x-hub-signature-256 on /webhooks/meta-ads-leadgen
# META_PAGE_ACCESS_TOKEN=...          # page token to fetch leadgen objects
# META_AD_ACCOUNT_ID=act_1234567890   # used by find_underrated_channels for /insights spend
# META_VERIFY_TOKEN=...               # token used in the Meta GET-verification handshake
# META_DEFAULT_TENANT_ID=             # optional fallback tenant when no ?tenant= query param

# === Google Ads — searchStream spend + Offline Conversion Upload ===
# GOOGLE_ADS_DEVELOPER_TOKEN=...
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890   # MCC; optional
# GOOGLE_ADS_CUSTOMER_ID=1234567890         # operating customer id (no dashes)
# GOOGLE_ADS_OAUTH_ACCESS_TOKEN=ya29....    # refresh upstream
# GOOGLE_ADS_API_VERSION=v17
# GOOGLE_ADS_CONVERSION_SECRET=...          # bearer token for /webhooks/google-ads-conversion
# GOOGLE_ADS_CONVERSION_ACTION_ID=          # required if /webhooks/google-ads-conversion?upload=true
# GOOGLE_ADS_DEFAULT_TENANT_ID=             # optional fallback tenant
