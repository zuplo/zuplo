# Pick a database provider. The kit boots with `in-memory` if unset.
# Options: in-memory | supabase | firestore | clickhouse | upstash-redis | neon
DB_PROVIDER=in-memory

# === Supabase (PostgREST) ===
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJh...
# SUPABASE_TABLE=items

# === Firestore (REST) ===
# FIREBASE_PROJECT=your-gcp-project-id
# FIRESTORE_COLLECTION=items
# FIREBASE_ACCESS_TOKEN=ya29....   # OAuth2 access token; refresh upstream

# === ClickHouse (HTTP) ===
# CLICKHOUSE_URL=https://xxxxx.clickhouse.cloud
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=...
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_TABLE=items

# === Upstash Redis (REST) ===
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# UPSTASH_KEY_PREFIX=items

# === Neon (HTTP serverless) ===
# NEON_HTTP_URL=https://xxxx.neon.tech/sql
# NEON_CONNECTION_STRING=postgresql://...
# NEON_TABLE=items

# === Resend (email survey delivery + bounce webhook) ===
# Configure your Resend webhook to POST to https://<gateway>/webhooks/resend.
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=surveys@yourdomain.com
# RESEND_WEBHOOK_SIGNING_SECRET=whsec_xxx   # Svix HMAC secret for webhook verify

# === Twilio (SMS survey delivery + status webhook) ===
# Configure your StatusCallback to https://<gateway>/webhooks/twilio.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+15551234567   # or a Messaging Service SID (MG...)

# === Slack (detractor escalation) ===
# Pick ONE transport. Bot token preferred for richer formatting.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_DEFAULT_CHANNEL=C012ABCD3FG
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T/B/secret

# === Claude (Anthropic) ===
# Powers cluster_open_responses — discovers themes and buckets verbatims.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-7-20251022
# Optional: route through Zuplo's AI Gateway instead of api.anthropic.com.
# AI_GATEWAY_URL=https://your-gateway.zuplo.app
