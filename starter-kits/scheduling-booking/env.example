# Pick a database provider. The kit boots with `in-memory` if unset.
# Options: in-memory | supabase | firestore | clickhouse | upstash-redis | neon
DB_PROVIDER=in-memory

# === Supabase (PostgREST) ===
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJh...
# SUPABASE_TABLE=items

# === Firestore (REST) ===
# FIREBASE_PROJECT=your-gcp-project-id
# FIRESTORE_COLLECTION=items
# FIREBASE_ACCESS_TOKEN=ya29....   # OAuth2 access token; refresh upstream

# === ClickHouse (HTTP) ===
# CLICKHOUSE_URL=https://xxxxx.clickhouse.cloud
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=...
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_TABLE=items

# === Upstash Redis (REST) ===
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# UPSTASH_KEY_PREFIX=items

# === Neon (HTTP serverless) ===
# NEON_HTTP_URL=https://xxxx.neon.tech/sql
# NEON_CONNECTION_STRING=postgresql://...
# NEON_TABLE=items

# === Google Calendar (event creation) ===
# OAuth2 access token — refresh externally and inject. Service-account
# tokens with domain-wide delegation also work.
# GOOGLE_CALENDAR_ACCESS_TOKEN=ya29....
# GOOGLE_CALENDAR_ID=primary

# === Zoom (server-to-server OAuth, Meetings v2) ===
# Create a Server-to-Server OAuth app in https://marketplace.zoom.us with
# scopes: `meeting:write:admin` (or `meeting:write` for single-user).
# ZOOM_ACCOUNT_ID=xxxxxxxx
# ZOOM_CLIENT_ID=xxxxxxxx
# ZOOM_CLIENT_SECRET=xxxxxxxx

# === Twilio (SMS confirmations) ===
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM_NUMBER=+15551234567
# Optional: use a Messaging Service SID instead of a single from-number
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx
