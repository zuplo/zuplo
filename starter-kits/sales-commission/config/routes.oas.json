  "paths": {
    "/payout/{id}/approve": {
      "post": {
        "operationId": "approve_payout",
        "summary": "Approve a payout (and optionally Slack-DM the rep)",
        "description": "Marks a payout as approved. When Slack is configured (SLACK_BOT_TOKEN or SLACK_WEBHOOK_URL), also DMs the rep with a summary unless `notifySlack: false` is passed.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Payout id.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Optional approval flags.",
                "properties": {
                  "notifySlack": { "type": "boolean", "description": "Default true. Set to false to skip the Slack message even when Slack is configured." },
                  "slackChannel": { "type": "string", "description": "Override the channel/user the message goes to (e.g. a Slack user id). Defaults to SLACK_DEFAULT_CHANNEL." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "The approved payout plus optional Slack metadata.",
                  "properties": {
                    "slack": {
                      "type": "object",
                      "properties": {
                        "ok": { "type": "boolean", "description": "Whether Slack accepted the message." },
                        "ts": { "type": "string", "description": "Slack message timestamp (bot-token mode)." },
                        "error": { "type": "string", "description": "Slack error if !ok." }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/approve-payout)"
          },
          "policies": {
            "inbound": [
              "api-key-inbound",
              "rate-limit"
            ]
          },
          "mcp": {
            "type": "tool",
            "annotations": {
              "readOnlyHint": false
            }
          }
        }
      }
    },
