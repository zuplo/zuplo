{
  "openapi": "3.1.0",
  "info": {
    "title": "Customer Health API",
    "version": "1.0.0",
    "description": "Headless customer-health and success-management API. Models accounts, computed health scores, leading-indicator signals, response playbooks, and playbook runs. Replaces Gainsight, ChurnZero, and Catalyst."
  },
  "paths": {
    "/accounts": {
      "get": {
        "operationId": "list_accounts",
        "summary": "List accounts in the current tenant",
        "description": "Returns a paginated list of accounts. Optionally filtered by CSM email so a CSM can fetch their own book of business in one call.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of accounts to return. Defaults to 50.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor from a previous response.",
            "schema": { "type": "string" }
          },
          {
            "name": "csmEmail",
            "in": "query",
            "description": "Restrict to accounts owned by this CSM.",
            "schema": { "type": "string", "format": "email" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of accounts ordered by upcoming renewal.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AccountPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-accounts)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/accounts/{id}": {
      "get": {
        "operationId": "get_account",
        "summary": "Get an account by id",
        "description": "Fetch a single account from the current tenant.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Account id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The account.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Account" }
              }
            }
          },
          "404": { "description": "Account not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/get-account)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/health-scores": {
      "get": {
        "operationId": "list_health_scores",
        "summary": "List health scores",
        "description": "Returns health scores newest first. Filter by accountId for an account's score history, or by tier to find all red/yellow accounts.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of scores to return. Defaults to 50.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor from a previous response.",
            "schema": { "type": "string" }
          },
          {
            "name": "accountId",
            "in": "query",
            "description": "Restrict to scores for a single account.",
            "schema": { "type": "string" }
          },
          {
            "name": "tier",
            "in": "query",
            "description": "Restrict to scores in a given tier.",
            "schema": { "type": "string", "enum": ["green", "yellow", "red"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of health scores.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthScorePage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-health-scores)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/health-scores/{id}": {
      "get": {
        "operationId": "get_health_score",
        "summary": "Get a health score by id",
        "description": "Fetch a single health-score record including its driver breakdown.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Health score id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The health score.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthScore" }
              }
            }
          },
          "404": { "description": "Health score not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/get-health-score)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/recalculate-health": {
      "post": {
        "operationId": "recalculate_health",
        "summary": "Compute and append a new health score",
        "description": "Computes a weighted-average score from the supplied drivers, maps it to a tier, and appends a new HealthScore row. Scores are append-only — recalculate produces a new record rather than mutating the previous score.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RecalculateHealthRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new health score.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthScore" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/recalculate-health)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/signals": {
      "get": {
        "operationId": "list_signals",
        "summary": "List leading-indicator signals",
        "description": "Returns leading-indicator signals (usage drops, ticket spikes, NPS dips, etc.) newest first. Filter by accountId or by severity.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of signals to return. Defaults to 50.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor from a previous response.",
            "schema": { "type": "string" }
          },
          {
            "name": "accountId",
            "in": "query",
            "description": "Restrict to signals on a single account.",
            "schema": { "type": "string" }
          },
          {
            "name": "severity",
            "in": "query",
            "description": "Restrict to signals at a given severity.",
            "schema": { "type": "string", "enum": ["low", "med", "high"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of signals.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SignalPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-signals)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "record_signal",
        "summary": "Record a new leading-indicator signal",
        "description": "Append a new signal for an account. Signals power the playbook trigger matcher and feed the health-score driver list.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SignalCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The recorded signal.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Signal" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/record-signal)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/playbooks": {
      "get": {
        "operationId": "list_playbooks",
        "summary": "List response playbooks",
        "description": "Returns the playbook catalog — reusable response sequences keyed by signal trigger.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of playbooks to return. Defaults to 50.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor from a previous response.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of playbooks.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlaybookPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-playbooks)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "create_playbook",
        "summary": "Create a response playbook",
        "description": "Define a new response playbook keyed by signal kind + minimum severity.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PlaybookCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created playbook.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Playbook" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/create-playbook)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/playbook-runs": {
      "get": {
        "operationId": "list_playbook_runs",
        "summary": "List playbook runs",
        "description": "Returns playbook runs newest first. Filter by accountId or status to scope to a specific account or only active runs.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of runs to return. Defaults to 50.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor from a previous response.",
            "schema": { "type": "string" }
          },
          {
            "name": "accountId",
            "in": "query",
            "description": "Restrict to runs against a single account.",
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Restrict to runs in this status.",
            "schema": { "type": "string", "enum": ["active", "completed", "canceled"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of playbook runs.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlaybookRunPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-playbook-runs)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      },
      "post": {
        "operationId": "run_playbook",
        "summary": "Start a playbook run against an account",
        "description": "Creates a new PlaybookRun in `active` status at step 0. Advance the run with `complete_playbook_step`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RunPlaybookRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The started run.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlaybookRun" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/run-playbook)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false } }
        }
      }
    },
    "/playbook-runs/{id}/complete-step": {
      "patch": {
        "operationId": "complete_playbook_step",
        "summary": "Advance a playbook run by one step",
        "description": "Increments `currentStep` on the run. When the new step index reaches the playbook's step count the run transitions to `completed`.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "PlaybookRun id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The updated run.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlaybookRun" }
              }
            }
          },
          "404": { "description": "PlaybookRun not found in this tenant." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/complete-playbook-step)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": false, "idempotentHint": false } }
        }
      }
    },
    "/summarize-account-health": {
      "post": {
        "operationId": "summarize_account_health",
        "summary": "Summarize a single account's health (orchestrator)",
        "description": "Reads the latest score, open signals (severity-ranked), and active playbook runs for an account, plus days-to-renewal, and returns a structured summary suitable for an LLM CSM briefing.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["accountId"],
                "properties": {
                  "accountId": {
                    "type": "string",
                    "description": "Account to summarize."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured account-health summary.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AccountHealthSummary" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/summarize-account-health)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/recommend-playbook": {
      "post": {
        "operationId": "recommend_playbook",
        "summary": "Recommend a playbook based on active signals (orchestrator)",
        "description": "Inspects active signals for an account and matches them against playbooks the account isn't already running. Returns the highest-severity match plus all other candidates.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["accountId"],
                "properties": {
                  "accountId": {
                    "type": "string",
                    "description": "Account to recommend playbooks for."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recommended playbook(s) with the matched signal.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlaybookRecommendation" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/recommend-playbook)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/predict-churn-risk": {
      "post": {
        "operationId": "predict_churn_risk",
        "summary": "Predict at-risk accounts (Claude-powered orchestrator)",
        "description": "Aggregates signals from the kit's own DB (health scores, severity events), Stripe (outstanding invoices, cancelling subscriptions), and PostHog (a HogQL usage rollup you supply), then hands the per-account context to Claude for a low/medium/high risk verdict and short reasoning. Each external call is opt-in and skipped silently if its env is unset.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "csmEmail": {
                    "type": "string",
                    "format": "email",
                    "description": "Restrict to a single CSM's book of business."
                  },
                  "daysAhead": {
                    "type": "integer",
                    "description": "Renewal window. Defaults to 90.",
                    "minimum": 1,
                    "maximum": 365
                  },
                  "includeRevenueHealth": {
                    "type": "boolean",
                    "description": "Fold in Stripe past-due invoices and cancelling subscriptions for accounts that have `external.stripeCustomerId` set."
                  },
                  "posthogUsageQuery": {
                    "type": "string",
                    "description": "Optional HogQL query returning rows of [account_prefix, weekly_active_users]. Folded into the per-account context."
                  },
                  "classifyWithClaude": {
                    "type": "boolean",
                    "description": "Default true. Set false to skip the Claude classification and just return deterministic reasons."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "List of at-risk accounts with reasons and optional Claude verdict.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChurnRiskReport" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/predict-churn-risk)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": { "type": "tool", "annotations": { "readOnlyHint": true } }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp_handler",
        "summary": "MCP server endpoint",
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "customer-health-server",
              "version": "1.0.0",
              "operations": [
                { "file": "./config/routes.oas.json", "id": "list_accounts" },
                { "file": "./config/routes.oas.json", "id": "get_account" },
                { "file": "./config/routes.oas.json", "id": "list_health_scores" },
                { "file": "./config/routes.oas.json", "id": "get_health_score" },
                { "file": "./config/routes.oas.json", "id": "recalculate_health" },
                { "file": "./config/routes.oas.json", "id": "list_signals" },
                { "file": "./config/routes.oas.json", "id": "record_signal" },
                { "file": "./config/routes.oas.json", "id": "list_playbooks" },
                { "file": "./config/routes.oas.json", "id": "create_playbook" },
                { "file": "./config/routes.oas.json", "id": "list_playbook_runs" },
                { "file": "./config/routes.oas.json", "id": "run_playbook" },
                { "file": "./config/routes.oas.json", "id": "complete_playbook_step" },
                { "file": "./config/routes.oas.json", "id": "summarize_account_health" },
                { "file": "./config/routes.oas.json", "id": "recommend_playbook" },
                { "file": "./config/routes.oas.json", "id": "predict_churn_risk" }
              ]
            }
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"],
            "outbound": ["prompt-injection-outbound", "secret-masking-outbound"]
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Account": {
        "type": "object",
        "description": "A customer account — the unit of CSM ownership and renewal.",
        "required": ["id", "tenantId", "name", "csmEmail", "arrCents", "renewsAt", "segment", "lifecycleStage"],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the account belongs to. Set automatically from the API key." },
          "name": { "type": "string", "description": "Customer-facing account name." },
          "csmEmail": { "type": "string", "format": "email", "description": "Owning CSM's email." },
          "arrCents": { "type": "integer", "description": "Annual recurring revenue in minor units (cents)." },
          "renewsAt": { "type": "string", "format": "date-time", "description": "Next renewal date (ISO-8601)." },
          "segment": {
            "type": "string",
            "enum": ["smb", "midmarket", "enterprise"],
            "description": "Customer-segment label."
          },
          "lifecycleStage": { "type": "string", "description": "Lifecycle bucket — e.g. onboarding, adopted, expanding." }
        }
      },
      "AccountPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Account" } },
          "nextCursor": { "type": "string", "nullable": true, "description": "Pagination cursor; null when no more results." }
        }
      },
      "HealthScoreDriver": {
        "type": "object",
        "description": "A single contributor to a health score.",
        "required": ["factor", "weight", "value"],
        "properties": {
          "factor": { "type": "string", "description": "Driver name — e.g. usage, support, NPS." },
          "weight": { "type": "number", "description": "Relative weight of this driver." },
          "value": { "type": "number", "description": "Driver's normalized 0..100 contribution." }
        }
      },
      "HealthScore": {
        "type": "object",
        "description": "A computed health score for an account at a point in time.",
        "required": ["id", "tenantId", "accountId", "scoreValue", "computedAt", "tier", "drivers"],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the score belongs to." },
          "accountId": { "type": "string", "description": "Account this score is for." },
          "scoreValue": { "type": "integer", "description": "Score 0..100, rounded.", "minimum": 0, "maximum": 100 },
          "computedAt": { "type": "string", "format": "date-time", "description": "When the score was computed (ISO-8601)." },
          "tier": {
            "type": "string",
            "enum": ["green", "yellow", "red"],
            "description": "Bucketed tier — green >=75, yellow >=50, red <50."
          },
          "drivers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/HealthScoreDriver" },
            "description": "Driver breakdown used to compute the score."
          }
        }
      },
      "HealthScorePage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/HealthScore" } },
          "nextCursor": { "type": "string", "nullable": true, "description": "Pagination cursor; null when no more results." }
        }
      },
      "RecalculateHealthRequest": {
        "type": "object",
        "description": "Inputs for recomputing a health score.",
        "required": ["accountId", "drivers"],
        "properties": {
          "accountId": { "type": "string", "description": "Account to recompute the score for." },
          "drivers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/HealthScoreDriver" },
            "description": "Driver inputs."
          }
        }
      },
      "Signal": {
        "type": "object",
        "description": "A leading-indicator signal that may trigger a playbook.",
        "required": ["id", "tenantId", "accountId", "kind", "severity", "detectedAt", "value"],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the signal belongs to." },
          "accountId": { "type": "string", "description": "Account the signal applies to." },
          "kind": {
            "type": "string",
            "enum": ["usage_drop", "ticket_spike", "nps_drop", "login_drop", "feature_unused", "champion_left"],
            "description": "Signal kind."
          },
          "severity": {
            "type": "string",
            "enum": ["low", "med", "high"],
            "description": "Severity."
          },
          "detectedAt": { "type": "string", "format": "date-time", "description": "When the signal was detected (ISO-8601)." },
          "value": { "type": "number", "description": "Signal magnitude — interpretation is kind-specific." }
        }
      },
      "SignalCreate": {
        "type": "object",
        "description": "Payload to record a new signal.",
        "required": ["accountId", "kind", "severity", "value"],
        "properties": {
          "accountId": { "type": "string", "description": "Account the signal applies to." },
          "kind": {
            "type": "string",
            "enum": ["usage_drop", "ticket_spike", "nps_drop", "login_drop", "feature_unused", "champion_left"],
            "description": "Signal kind."
          },
          "severity": {
            "type": "string",
            "enum": ["low", "med", "high"],
            "description": "Severity."
          },
          "value": { "type": "number", "description": "Signal magnitude." }
        }
      },
      "SignalPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Signal" } },
          "nextCursor": { "type": "string", "nullable": true, "description": "Pagination cursor; null when no more results." }
        }
      },
      "PlaybookTrigger": {
        "type": "object",
        "description": "Trigger conditions that match a playbook to a signal.",
        "required": ["signalKind", "minSeverity"],
        "properties": {
          "signalKind": { "type": "string", "description": "Signal kind that triggers the playbook." },
          "minSeverity": {
            "type": "string",
            "enum": ["low", "med", "high"],
            "description": "Minimum severity for the trigger to fire."
          }
        }
      },
      "Playbook": {
        "type": "object",
        "description": "A reusable response sequence keyed by signal trigger.",
        "required": ["id", "tenantId", "name", "trigger", "steps"],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the playbook belongs to." },
          "name": { "type": "string", "description": "Human-readable playbook name." },
          "trigger": { "$ref": "#/components/schemas/PlaybookTrigger" },
          "steps": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Ordered list of free-form step labels."
          }
        }
      },
      "PlaybookCreate": {
        "type": "object",
        "description": "Payload to create a playbook.",
        "required": ["name", "trigger", "steps"],
        "properties": {
          "name": { "type": "string", "description": "Human-readable playbook name." },
          "trigger": { "$ref": "#/components/schemas/PlaybookTrigger" },
          "steps": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Ordered list of free-form step labels."
          }
        }
      },
      "PlaybookPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Playbook" } },
          "nextCursor": { "type": "string", "nullable": true, "description": "Pagination cursor; null when no more results." }
        }
      },
      "PlaybookRun": {
        "type": "object",
        "description": "An in-flight playbook execution against an account.",
        "required": ["id", "tenantId", "playbookId", "accountId", "status", "currentStep", "startedAt"],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the run belongs to." },
          "playbookId": { "type": "string", "description": "Playbook being executed." },
          "accountId": { "type": "string", "description": "Account the run targets." },
          "status": {
            "type": "string",
            "enum": ["active", "completed", "canceled"],
            "description": "Run status."
          },
          "currentStep": { "type": "integer", "description": "Index into the playbook's steps array." },
          "startedAt": { "type": "string", "format": "date-time", "description": "When the run started (ISO-8601)." }
        }
      },
      "RunPlaybookRequest": {
        "type": "object",
        "description": "Payload to start a playbook run.",
        "required": ["playbookId", "accountId"],
        "properties": {
          "playbookId": { "type": "string", "description": "Playbook to run." },
          "accountId": { "type": "string", "description": "Account to run it against." }
        }
      },
      "PlaybookRunPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/PlaybookRun" } },
          "nextCursor": { "type": "string", "nullable": true, "description": "Pagination cursor; null when no more results." }
        }
      },
      "AccountHealthSummary": {
        "type": "object",
        "description": "Structured account-health briefing returned by `summarize_account_health`.",
        "required": ["account", "latestScore", "tier", "daysToRenewal", "openSignals", "activeRuns", "narrative"],
        "properties": {
          "account": { "$ref": "#/components/schemas/Account" },
          "latestScore": { "$ref": "#/components/schemas/HealthScore", "nullable": true },
          "tier": { "type": "string", "enum": ["green", "yellow", "red"], "nullable": true, "description": "Latest tier or null if no score yet." },
          "daysToRenewal": { "type": "integer", "description": "Days until renewal — negative if past due." },
          "openSignals": { "type": "array", "items": { "$ref": "#/components/schemas/Signal" } },
          "activeRuns": { "type": "array", "items": { "$ref": "#/components/schemas/PlaybookRun" } },
          "narrative": { "type": "string", "description": "One-sentence English summary." }
        }
      },
      "PlaybookRecommendation": {
        "type": "object",
        "description": "Recommendation returned by `recommend_playbook`.",
        "required": ["accountId", "topRecommendation", "candidates"],
        "properties": {
          "accountId": { "type": "string" },
          "topRecommendation": {
            "type": "object",
            "nullable": true,
            "properties": {
              "playbook": { "$ref": "#/components/schemas/Playbook" },
              "matchedSignal": { "$ref": "#/components/schemas/Signal" },
              "rank": { "type": "integer", "description": "Severity rank — higher is more urgent." }
            }
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "playbook": { "$ref": "#/components/schemas/Playbook" },
                "matchedSignal": { "$ref": "#/components/schemas/Signal" },
                "rank": { "type": "integer" }
              }
            }
          }
        }
      },
      "ChurnRiskReport": {
        "type": "object",
        "description": "Output of `predict_churn_risk`.",
        "required": ["filter", "atRiskCount", "atRisk"],
        "properties": {
          "filter": {
            "type": "object",
            "properties": {
              "csmEmail": { "type": "string", "nullable": true },
              "daysAhead": { "type": "integer" }
            }
          },
          "atRiskCount": { "type": "integer" },
          "atRisk": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "account": { "$ref": "#/components/schemas/Account" },
                "latestScore": { "$ref": "#/components/schemas/HealthScore", "nullable": true },
                "highSignals": { "type": "array", "items": { "$ref": "#/components/schemas/Signal" } },
                "revenue": {
                  "type": "object",
                  "nullable": true,
                  "description": "Stripe-derived revenue health (when includeRevenueHealth=true and stripeCustomerId is set on the account).",
                  "additionalProperties": true
                },
                "weeklyActiveUsers": { "type": "integer", "nullable": true, "description": "From PostHog usage query, when supplied." },
                "reasons": { "type": "array", "items": { "type": "string" }, "description": "Deterministic reasons computed from rules." },
                "claudeRisk": {
                  "type": "string",
                  "nullable": true,
                  "enum": ["low", "medium", "high", null],
                  "description": "Claude's classification, when classifyWithClaude is on."
                },
                "claudeReasoning": { "type": "string", "nullable": true, "description": "One-sentence reasoning from Claude." }
              }
            }
          }
        }
      }
    }
  }
}
