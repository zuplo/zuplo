# Pick a database provider. The kit boots with `in-memory` if unset.
# Options: in-memory | supabase | firestore | clickhouse | upstash-redis | neon
DB_PROVIDER=in-memory

# === Supabase (PostgREST) ===
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJh...
# SUPABASE_TABLE=items

# === Firestore (REST) ===
# FIREBASE_PROJECT=your-gcp-project-id
# FIRESTORE_COLLECTION=items
# FIREBASE_ACCESS_TOKEN=ya29....   # OAuth2 access token; refresh upstream

# === ClickHouse (HTTP) ===
# CLICKHOUSE_URL=https://xxxxx.clickhouse.cloud
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=...
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_TABLE=items

# === Upstash Redis (REST) ===
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# UPSTASH_KEY_PREFIX=items

# === Neon (HTTP serverless) ===
# NEON_HTTP_URL=https://xxxx.neon.tech/sql
# NEON_CONNECTION_STRING=postgresql://...
# NEON_TABLE=items

# === DocuSign eSignature (REST v2.1) ===
# Demo: https://demo.docusign.net   |  Production: your account base URL.
# DOCUSIGN_BASE_URL=https://demo.docusign.net
# DOCUSIGN_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
# OAuth2 access token (refresh externally — JWT grant or auth-code flow).
# DOCUSIGN_ACCESS_TOKEN=eyJ0eXAi...
# Shared secret configured on a DocuSign Connect listener (used by /webhooks/docusign).
# DOCUSIGN_CONNECT_SECRET=xxxxxxxx

# === Google Calendar (deadline events) ===
# OAuth2 access token — refresh externally and inject. Service-account
# tokens with domain-wide delegation also work.
# GOOGLE_CALENDAR_ACCESS_TOKEN=ya29....
# GOOGLE_CALENDAR_ID=primary

# === Resend (status-letter delivery) ===
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=firm@yourdomain.com
