{
  "openapi": "3.1.0",
  "info": {
    "title": "Status Page API",
    "version": "1.0.0",
    "description": "API + MCP server for a customer-facing status page. Replaces Statuspage.io, Instatus, Atlassian Statuspage. Models components, incidents, incident updates, scheduled maintenance, and subscribers, plus orchestrator MCP tools to open incidents from alerts and draft customer updates."
  },
  "paths": {
    "/components": {
      "get": {
        "operationId": "list_components",
        "summary": "List components in display order",
        "description": "Returns the components shown on the public status page, sorted by displayOrder. Components describe individual subsystems (API, Dashboard, etc.) and carry a current status that the status page renders.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of components to return. Defaults to 50.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of components.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ComponentPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-components)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      },
      "post": {
        "operationId": "create_component",
        "summary": "Register a new component",
        "description": "Add a new component to the status page (e.g. when a new microservice ships). Defaults to operational.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ComponentCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created component.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Component" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/create-component)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false }
          }
        }
      }
    },
    "/components/{id}": {
      "get": {
        "operationId": "get_component",
        "summary": "Get a component by id",
        "description": "Fetch a single component, including its current status.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Component id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The component.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Component" }
              }
            }
          },
          "404": { "description": "Component not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/get-component)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      }
    },
    "/components/{id}/status": {
      "patch": {
        "operationId": "update_component_status",
        "summary": "Update a component's status",
        "description": "Change a component's current status (operational, degraded, partial_outage, major_outage, under_maintenance). Idempotent.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Component id.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "operational",
                      "degraded",
                      "partial_outage",
                      "major_outage",
                      "under_maintenance"
                    ],
                    "description": "New status for the component."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated component.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Component" }
              }
            }
          },
          "404": { "description": "Component not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/update-component-status)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false, "idempotentHint": true }
          }
        }
      }
    },
    "/incidents": {
      "get": {
        "operationId": "list_incidents",
        "summary": "List incidents (filterable by status and kind)",
        "description": "Returns recent incidents, newest first. Filter by status (investigating, identified, monitoring, resolved) or kind (incident vs maintenance).",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of incidents to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor.",
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by status.",
            "schema": {
              "type": "string",
              "enum": [
                "investigating",
                "identified",
                "monitoring",
                "resolved"
              ]
            }
          },
          {
            "name": "kind",
            "in": "query",
            "description": "Filter by kind.",
            "schema": {
              "type": "string",
              "enum": ["incident", "maintenance"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of incidents.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IncidentPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-incidents)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      },
      "post": {
        "operationId": "open_incident",
        "summary": "Open a new incident",
        "description": "Create an incident in 'investigating' status. The first item on the timeline. Operators or the orchestrator tool open_incident_from_alert call this.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/IncidentCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created incident.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Incident" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/open-incident)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false }
          }
        }
      }
    },
    "/incidents/{id}": {
      "get": {
        "operationId": "get_incident",
        "summary": "Get an incident by id",
        "description": "Fetch a single incident, including current status and impact.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Incident id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The incident.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Incident" }
              }
            }
          },
          "404": { "description": "Incident not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/get-incident)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      }
    },
    "/incidents/{id}/updates": {
      "post": {
        "operationId": "post_incident_update",
        "summary": "Post an incident timeline update",
        "description": "Append an update to an incident's timeline. The incident's own status is rolled forward to match the update's status, and resolvedAt is set if the update marks the incident resolved.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Incident id.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["body", "status"],
                "properties": {
                  "body": {
                    "type": "string",
                    "description": "Customer-facing update text."
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "investigating",
                      "identified",
                      "monitoring",
                      "resolved"
                    ],
                    "description": "Status the incident should now be in."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created timeline update.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IncidentUpdate" }
              }
            }
          },
          "404": { "description": "Incident not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/post-incident-update)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false }
          }
        }
      }
    },
    "/incidents/{id}/resolve": {
      "patch": {
        "operationId": "resolve_incident",
        "summary": "Mark an incident resolved",
        "description": "Sets the incident's status to resolved and stamps resolvedAt. Idempotent — calling it on an already-resolved incident just refreshes the timestamp.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Incident id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The resolved incident.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Incident" }
              }
            }
          },
          "404": { "description": "Incident not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/resolve-incident)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false, "idempotentHint": true }
          }
        }
      }
    },
    "/maintenance": {
      "get": {
        "operationId": "list_maintenance",
        "summary": "List scheduled maintenance windows",
        "description": "Returns scheduled, in-progress, completed, and canceled maintenance windows ordered by scheduledStart.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of maintenance windows to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor.",
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by status.",
            "schema": {
              "type": "string",
              "enum": ["scheduled", "in_progress", "completed", "canceled"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of maintenance windows.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MaintenancePage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-maintenance)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      },
      "post": {
        "operationId": "schedule_maintenance",
        "summary": "Schedule a maintenance window",
        "description": "Create a future maintenance window so subscribers can be notified ahead of time.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MaintenanceCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The scheduled maintenance window.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Maintenance" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/schedule-maintenance)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false }
          }
        }
      }
    },
    "/maintenance/{id}/complete": {
      "patch": {
        "operationId": "complete_maintenance",
        "summary": "Mark a maintenance window complete",
        "description": "Move a maintenance window to status=completed. Idempotent.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Maintenance window id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The completed maintenance window.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Maintenance" }
              }
            }
          },
          "404": { "description": "Maintenance window not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/complete-maintenance)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false, "idempotentHint": true }
          }
        }
      }
    },
    "/subscribers": {
      "get": {
        "operationId": "list_subscribers",
        "summary": "List subscribers",
        "description": "Returns customers who opted in to status notifications.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum subscribers to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of subscribers.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SubscriberPage" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/list-subscribers)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      },
      "post": {
        "operationId": "add_subscriber",
        "summary": "Add a subscriber",
        "description": "Register a new subscriber and the components / minimum impact level they want to be notified about.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SubscriberCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created subscriber.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Subscriber" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/add-subscriber)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false }
          }
        }
      }
    },
    "/subscribers/{id}": {
      "delete": {
        "operationId": "remove_subscriber",
        "summary": "Remove a subscriber",
        "description": "Permanently unsubscribe a customer. The row is removed.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Subscriber id.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Removed." },
          "404": { "description": "Subscriber not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/remove-subscriber)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "destructiveHint": true }
          }
        }
      }
    },
    "/open-incident-from-alert": {
      "post": {
        "operationId": "open_incident_from_alert",
        "summary": "Open an incident from an alerting payload (orchestrator)",
        "description": "Given an alert title, severity, and affected components, opens an incident, posts the first timeline update, and degrades each affected component's status. Replaces the manual checklist on-callers run at 2am.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["alertTitle", "severity", "affectedComponents"],
                "properties": {
                  "alertTitle": {
                    "type": "string",
                    "description": "Title of the alert / incident — used as the incident's customer-facing title."
                  },
                  "severity": {
                    "type": "string",
                    "enum": ["minor", "major", "critical"],
                    "description": "Severity of the alert. Drives the incident's impact and which component status (degraded vs partial_outage vs major_outage) is set."
                  },
                  "affectedComponents": {
                    "type": "array",
                    "description": "Component ids whose status should be downgraded.",
                    "items": { "type": "string" }
                  },
                  "body": {
                    "type": "string",
                    "description": "Optional initial public-facing description. A reasonable default is generated when omitted."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "What was created (incident + first update + component status changes).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "incident": { "$ref": "#/components/schemas/Incident" },
                    "initialUpdate": {
                      "$ref": "#/components/schemas/IncidentUpdate"
                    },
                    "componentUpdates": {
                      "type": "array",
                      "description": "Component status changes that were applied.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "slug": {
                            "type": "string",
                            "description": "Component identifier."
                          },
                          "status": {
                            "type": "string",
                            "description": "New component status."
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/open-incident-from-alert)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false }
          }
        }
      }
    },
    "/draft-customer-update": {
      "post": {
        "operationId": "draft_customer_update",
        "summary": "Draft a ready-to-post customer update (orchestrator)",
        "description": "Reads the incident's full timeline and affected components, returns a customer-facing or internal draft body that the operator (or LLM) can post directly via post_incident_update.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["incidentId"],
                "properties": {
                  "incidentId": {
                    "type": "string",
                    "description": "Incident to draft an update for."
                  },
                  "audience": {
                    "type": "string",
                    "enum": ["customer", "internal"],
                    "description": "Audience for the draft. Defaults to customer."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft text plus the supporting context.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "incidentId": { "type": "string", "description": "Incident id." },
                    "audience": {
                      "type": "string",
                      "description": "Audience the draft was tailored for."
                    },
                    "currentStatus": {
                      "type": "string",
                      "description": "Latest known status of the incident."
                    },
                    "minutesElapsed": {
                      "type": "integer",
                      "description": "Minutes since the incident started."
                    },
                    "affectedComponents": {
                      "type": "array",
                      "description": "Components affected by the incident.",
                      "items": { "type": "string" }
                    },
                    "timelineLength": {
                      "type": "integer",
                      "description": "Number of updates already on the timeline."
                    },
                    "draft": {
                      "type": "string",
                      "description": "Ready-to-post update body."
                    }
                  }
                }
              }
            }
          },
          "404": { "description": "Incident not found." }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/draft-customer-update)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": true }
          }
        }
      }
    },
    "/post-postmortem-summary": {
      "post": {
        "operationId": "post_postmortem_summary",
        "summary": "Post a postmortem summary as a final timeline update (orchestrator)",
        "description": "Adds a final timeline update to a resolved incident containing the postmortem text (truncated to a customer-friendly length) and an optional link to the full writeup.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["incidentId", "postmortemText"],
                "properties": {
                  "incidentId": {
                    "type": "string",
                    "description": "Incident the postmortem belongs to."
                  },
                  "postmortemText": {
                    "type": "string",
                    "description": "Full postmortem text. Truncated in the public update."
                  },
                  "postmortemUrl": {
                    "type": "string",
                    "description": "Optional link to the full postmortem (for example, a Confluence URL)."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "What was posted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "incidentId": { "type": "string", "description": "Incident id." },
                    "excerptLength": {
                      "type": "integer",
                      "description": "Length of the excerpt that was posted."
                    },
                    "truncated": {
                      "type": "boolean",
                      "description": "Whether the postmortem was truncated."
                    },
                    "update": { "$ref": "#/components/schemas/IncidentUpdate" }
                  }
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-tools/post-postmortem-summary)"
          },
          "policies": { "inbound": ["api-key-inbound", "rate-limit"] },
          "mcp": {
            "type": "tool",
            "annotations": { "readOnlyHint": false }
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp_handler",
        "summary": "MCP server endpoint",
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "status-page",
              "version": "1.0.0",
              "operations": [
                { "file": "./config/routes.oas.json", "id": "list_components" },
                { "file": "./config/routes.oas.json", "id": "get_component" },
                { "file": "./config/routes.oas.json", "id": "create_component" },
                { "file": "./config/routes.oas.json", "id": "update_component_status" },
                { "file": "./config/routes.oas.json", "id": "list_incidents" },
                { "file": "./config/routes.oas.json", "id": "get_incident" },
                { "file": "./config/routes.oas.json", "id": "open_incident" },
                { "file": "./config/routes.oas.json", "id": "post_incident_update" },
                { "file": "./config/routes.oas.json", "id": "resolve_incident" },
                { "file": "./config/routes.oas.json", "id": "list_maintenance" },
                { "file": "./config/routes.oas.json", "id": "schedule_maintenance" },
                { "file": "./config/routes.oas.json", "id": "complete_maintenance" },
                { "file": "./config/routes.oas.json", "id": "list_subscribers" },
                { "file": "./config/routes.oas.json", "id": "add_subscriber" },
                { "file": "./config/routes.oas.json", "id": "remove_subscriber" },
                { "file": "./config/routes.oas.json", "id": "open_incident_from_alert" },
                { "file": "./config/routes.oas.json", "id": "draft_customer_update" },
                { "file": "./config/routes.oas.json", "id": "post_postmortem_summary" }
              ]
            }
          },
          "policies": {
            "inbound": ["api-key-inbound", "rate-limit"],
            "outbound": ["prompt-injection-outbound", "secret-masking-outbound"]
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Component": {
        "type": "object",
        "description": "A single component shown on the public status page.",
        "required": [
          "id",
          "tenantId",
          "slug",
          "name",
          "status",
          "description",
          "displayOrder",
          "updatedAt"
        ],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the component belongs to. Set automatically from the API key." },
          "slug": { "type": "string", "description": "URL-safe identifier (e.g. 'api', 'dashboard')." },
          "name": { "type": "string", "description": "Display name." },
          "status": {
            "type": "string",
            "enum": [
              "operational",
              "degraded",
              "partial_outage",
              "major_outage",
              "under_maintenance"
            ],
            "description": "Current status."
          },
          "description": {
            "type": "string",
            "description": "Optional customer-facing description of what this component covers."
          },
          "parentSlug": {
            "type": ["string", "null"],
            "description": "Slug of a parent component, if this one is nested under a group."
          },
          "displayOrder": {
            "type": "integer",
            "description": "Sort order on the public page (ascending)."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the status last changed."
          }
        }
      },
      "ComponentCreate": {
        "type": "object",
        "description": "Payload to register a new component.",
        "required": ["slug", "name"],
        "properties": {
          "slug": { "type": "string", "description": "URL-safe identifier." },
          "name": { "type": "string", "description": "Display name." },
          "description": { "type": "string", "description": "Optional description." },
          "status": {
            "type": "string",
            "enum": [
              "operational",
              "degraded",
              "partial_outage",
              "major_outage",
              "under_maintenance"
            ],
            "description": "Initial status. Defaults to operational."
          },
          "parentSlug": {
            "type": ["string", "null"],
            "description": "Optional parent component slug."
          },
          "displayOrder": {
            "type": "integer",
            "description": "Sort order. Defaults to 0."
          }
        }
      },
      "ComponentPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "description": "Page of components.",
            "items": { "$ref": "#/components/schemas/Component" }
          },
          "nextCursor": {
            "type": ["string", "null"],
            "description": "Pagination cursor."
          }
        }
      },
      "Incident": {
        "type": "object",
        "description": "A customer-facing incident on the status page timeline.",
        "required": [
          "id",
          "tenantId",
          "title",
          "body",
          "status",
          "impact",
          "affectedComponentSlugs",
          "startedAt",
          "kind",
          "createdAt"
        ],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the incident belongs to." },
          "title": { "type": "string", "description": "Customer-facing title." },
          "body": { "type": "string", "description": "Customer-facing initial description." },
          "status": {
            "type": "string",
            "enum": [
              "investigating",
              "identified",
              "monitoring",
              "resolved"
            ],
            "description": "Current incident status."
          },
          "impact": {
            "type": "string",
            "enum": ["none", "minor", "major", "critical"],
            "description": "Customer-visible impact level."
          },
          "affectedComponentSlugs": {
            "type": "array",
            "description": "Slugs of components affected by this incident.",
            "items": { "type": "string" }
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the incident started."
          },
          "resolvedAt": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "When the incident was marked resolved."
          },
          "kind": {
            "type": "string",
            "enum": ["incident", "maintenance"],
            "description": "Whether this is an unplanned incident or a planned maintenance window record."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO-8601 creation timestamp."
          }
        }
      },
      "IncidentCreate": {
        "type": "object",
        "description": "Payload to open a new incident.",
        "required": ["title", "body", "impact"],
        "properties": {
          "title": { "type": "string", "description": "Customer-facing title." },
          "body": { "type": "string", "description": "Initial customer-facing description." },
          "impact": {
            "type": "string",
            "enum": ["none", "minor", "major", "critical"],
            "description": "Customer impact level."
          },
          "affectedComponentSlugs": {
            "type": "array",
            "description": "Component slugs affected.",
            "items": { "type": "string" }
          },
          "status": {
            "type": "string",
            "enum": [
              "investigating",
              "identified",
              "monitoring",
              "resolved"
            ],
            "description": "Initial status. Defaults to investigating."
          },
          "kind": {
            "type": "string",
            "enum": ["incident", "maintenance"],
            "description": "Defaults to incident."
          }
        }
      },
      "IncidentPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "description": "Page of incidents.",
            "items": { "$ref": "#/components/schemas/Incident" }
          },
          "nextCursor": {
            "type": ["string", "null"],
            "description": "Pagination cursor."
          }
        }
      },
      "IncidentUpdate": {
        "type": "object",
        "description": "A single timeline entry on an incident.",
        "required": ["id", "tenantId", "incidentId", "body", "postedAt", "status"],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the update belongs to." },
          "incidentId": { "type": "string", "description": "Parent incident id." },
          "body": { "type": "string", "description": "Customer-facing update body." },
          "postedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the update was posted."
          },
          "status": {
            "type": "string",
            "enum": [
              "investigating",
              "identified",
              "monitoring",
              "resolved"
            ],
            "description": "Status the incident was in when this update was posted."
          }
        }
      },
      "Maintenance": {
        "type": "object",
        "description": "A scheduled maintenance window.",
        "required": [
          "id",
          "tenantId",
          "title",
          "scheduledStart",
          "scheduledEnd",
          "affectedComponentSlugs",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the window belongs to." },
          "title": { "type": "string", "description": "Customer-facing title." },
          "scheduledStart": {
            "type": "string",
            "format": "date-time",
            "description": "When the maintenance is scheduled to start."
          },
          "scheduledEnd": {
            "type": "string",
            "format": "date-time",
            "description": "When the maintenance is scheduled to end."
          },
          "affectedComponentSlugs": {
            "type": "array",
            "description": "Component slugs that will be affected.",
            "items": { "type": "string" }
          },
          "status": {
            "type": "string",
            "enum": ["scheduled", "in_progress", "completed", "canceled"],
            "description": "Lifecycle status."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO-8601 creation timestamp."
          }
        }
      },
      "MaintenanceCreate": {
        "type": "object",
        "description": "Payload to schedule a maintenance window.",
        "required": ["title", "scheduledStart", "scheduledEnd"],
        "properties": {
          "title": { "type": "string", "description": "Customer-facing title." },
          "scheduledStart": {
            "type": "string",
            "format": "date-time",
            "description": "When maintenance starts."
          },
          "scheduledEnd": {
            "type": "string",
            "format": "date-time",
            "description": "When maintenance ends."
          },
          "affectedComponentSlugs": {
            "type": "array",
            "description": "Components that will be affected.",
            "items": { "type": "string" }
          }
        }
      },
      "MaintenancePage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "description": "Page of maintenance windows.",
            "items": { "$ref": "#/components/schemas/Maintenance" }
          },
          "nextCursor": {
            "type": ["string", "null"],
            "description": "Pagination cursor."
          }
        }
      },
      "Subscriber": {
        "type": "object",
        "description": "A customer who has opted in to status notifications.",
        "required": [
          "id",
          "tenantId",
          "email",
          "components",
          "notifyOnImpact",
          "createdAt"
        ],
        "properties": {
          "id": { "type": "string", "description": "Unique id within the tenant." },
          "tenantId": { "type": "string", "description": "Tenant the subscriber belongs to." },
          "email": { "type": "string", "description": "Subscriber email." },
          "components": {
            "type": "array",
            "description": "Components the subscriber wants notifications for. Empty array means all components.",
            "items": { "type": "string" }
          },
          "notifyOnImpact": {
            "type": "string",
            "enum": ["none", "minor", "major", "critical"],
            "description": "Minimum impact level the subscriber wants to be notified about."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO-8601 creation timestamp."
          }
        }
      },
      "SubscriberCreate": {
        "type": "object",
        "description": "Payload to add a new subscriber.",
        "required": ["email"],
        "properties": {
          "email": { "type": "string", "description": "Subscriber email." },
          "components": {
            "type": "array",
            "description": "Components to subscribe to. Defaults to all.",
            "items": { "type": "string" }
          },
          "notifyOnImpact": {
            "type": "string",
            "enum": ["none", "minor", "major", "critical"],
            "description": "Minimum impact level. Defaults to minor."
          }
        }
      },
      "SubscriberPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "description": "Page of subscribers.",
            "items": { "$ref": "#/components/schemas/Subscriber" }
          },
          "nextCursor": {
            "type": ["string", "null"],
            "description": "Pagination cursor."
          }
        }
      }
    }
  }
}
