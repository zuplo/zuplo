            }
          }
        }
      }
    },
    "/consent/send-envelope": {
      "post": {
        "operationId": "send_consent_envelope",
        "summary": "Send Consent Envelope",
        "description": "Send a DocuSign envelope built from a pre-configured template (HIPAA / treatment / telehealth consent). Returns either an envelope id (email signing) or an embedded signing URL for tablet kiosks.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["patientId", "templateId", "consentKind"],
                "properties": {
                  "patientId": { "type": "string", "description": "Patient who needs to sign." },
                  "templateId": { "type": "string", "description": "DocuSign template id." },
                  "consentKind": {
                    "type": "string",
                    "enum": ["treatment", "hipaa", "telehealth", "research"],
                    "description": "Consent kind to record on completion."
                  },
                  "version": { "type": "string", "description": "Consent version, e.g. \"2.1\". Defaults to 1.0." },
                  "embeddedSigning": { "type": "boolean", "description": "When true, returns a signingUrl for tablet kiosks." },
                  "returnUrl": { "type": "string", "description": "Where DocuSign should redirect after embedded signing." }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Envelope sent.",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/handlers/send-consent-envelope)"
          },
